sub get_virtuoso_bin {
    my $virtuoso_bin = `which virtuoso 2>/dev/null`;
    if ($? != 0) {
        $virtuoso_bin = "";
    }
    else {
        chomp $virtuoso_bin;
    }

    return $virtuoso_bin;
}


sub get_library_path {
    my $lib_name = shift;
    my $library_path;
    my $skill_in_str;

    $skill_in_str .= qq/printf("\\n|-%s-|-%s-|\\n" "$lib_name" ddGetObjReadPath(ddGetObj("$lib_name")));\n/; 
    $skill_in_str .= qq/exit(0);\n/;

    my $out = &run_virtuoso_nograph($skill_in_str, $cfg->{virtuoso_bin});
    if ($out =~ /^\|\-${lib_name}\-\|\-(.+?)\-/sm) {
        return $1;
    }
    else {
        return undef;
    }
}


sub run_virtuoso_nograph {
    my ($input_str, $virtuoso_bin) = @_;
    my $output_str;
    unless ($virtuoso_bin) {
        $virtuoso_bin = "virtuoso";
    }
    my ($fh, $fname) = tempfile("virtuosoXXXXXX", SUFFIX => '.cmd');
    print $fh $input_str;
    close $fh;
   # open(VSO, '-|', "$virtuoso_bin -nograph -log $cfg->{log_file} < $fname");
#Aaron 9/22
    open(VSO, '-|', "$virtuoso_bin -nograph -log $cfg->{log_file} < $fname") or return undef;		#For IC61, comment below.
    #open(VSO, '-|', "$virtuoso_bin -nograph  < $fname -log $cfg->{log_file}") or return undef;		#For IC51, comment above.
    #open(VSO, '-|', "$virtuoso_bin -nograph  < $fname") or return undef;

    while (my $line = <VSO>) {
        $output_str .= $line;
    }
    close VSO;
    unlink $fname;

    return $output_str;
}

