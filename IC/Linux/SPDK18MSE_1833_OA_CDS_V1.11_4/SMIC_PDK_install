sub check_permission {
 my @viewlist = qw/ams auCdl auLvs hspiceD ivpcell spectre symbol layout/;
 my @mimlist = qw/mim mim_ckt mim2 mim2_ckt /;
 my @checklist = ();
 push @checklist,@remove_resistor_list,@mimlist,@remove_mim_list;
  foreach my $viewname (@viewlist) {
    foreach my $cellname (@checklist) {
