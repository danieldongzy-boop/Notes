sub readfile($) {
   my ($filename) = @_;
   my @file_arr=();
   if (! open FILE ,"<$filename") {
   print "$filename doesn't exist\n";
   }
   open FILE , "<$filename" || die "$filename doesn't exist";
   chomp (@file_arr = <FILE>);
   close FILE;
   return @file_arr;
}

