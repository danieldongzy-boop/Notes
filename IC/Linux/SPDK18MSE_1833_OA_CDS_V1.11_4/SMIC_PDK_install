sub get_line {
    print "Do you want to install yes/no?[yes|no]:";
    my $line_1 = <STDIN>;
    chomp $line_1;
    if ($line_1 =~ /yes/) {
        print qq/PDK installing ......\n/;
    }
    elsif ($line_1 =~ /no/) {
        print "Cancel install\n";
        exit 1;
    }
    else {
        print "***Unexpected input value***\n";
        return &get_line;
    }
}

