#parse the detail metal option customer choose
sub parse_metal_option {
    my $opt_choice = shift;
    my $mt_opt = {};
        if($opt_choice =~ /^1P(\d+)M_(\d+)Ia_(1TMa\d+)_(MIM\d+)$/)  {
        $mt_opt = {
        "total_metal" => $1,
        "Ia" => $2,
        "TMa" => $3,
        "MIM" => $4,
         };
    }

    return $mt_opt;
}


#Generate the remove metal resistor list according to the Ic metal option
sub gen_ic_resistor {
    my @metal_resistor;
    my $ic_metal_num = shift;
    my $support_ic_metal_num=6;
    while (($support_ic_metal_num-$ic_metal_num)>0 ) {
      my $rm_device="rm".($ic_metal_num+1);
      $ic_metal_num++;
      push @metal_resistor,$rm_device;
    }
    return @metal_resistor;
}


