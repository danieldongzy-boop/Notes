               if (/set top_metal /) {
                   my $topmetaltype="MT" ;
                   if ($cfg->{metal_option}=~/TMa(\d+)/) {
                       if ($1 eq 1) {
                          $topmetaltype="MT" ;
                       }
                       if ($1 eq 2) {
                          $topmetaltype="MTT" ;
                       }
                       if ($1 eq 3) {
                          $topmetaltype="MTT1" ;
                       }
                       if ($1 eq 4) {
                          $topmetaltype="MTT2" ;
                       }
                   }
                   s/set top_metal\s+\w+/set top_metal $topmetaltype/ ;    
               }
               print DRCOUT "$_\n" ;
           }
           close  DRCOUT ;
       } else {
           unless (/\.drc$/ || /\.tar$/ || /\.gz$/) { 
              system("cp -rf $_  $cfg->{install_drc_path}"); 
           }
       }
    }
}


sub final_pdk_install {
    my $pdk_name = $cfg->{final_pdk_name_prefix}.$cfg->{metal_option}.$cfg->{final_pdk_name_suffix}; 
    if (-d  qq/$cfg->{install_pdk_path}\/$pdk_name/) {
     die qq/Error: The pdk already exits. No need to install.\n/
         .qq/Please have a check: .\/$pdk_name/; 
     exit 1;
    }

    system("mkdir $cfg->{install_pdk_path}\/$pdk_name");
    
    foreach my $copyfile (@{$finalpdk->{finalCopy}}) {
        system("cp -rf $cfg->{pdk_root_path}/$copyfile $cfg->{install_pdk_path}\/$pdk_name");
        unless ($? == 0) {
            die qq(Error: cannot run "cp -rf $cfg->{pdk_root_path}/$copyfile $cfg->{install_pdk_path}\/$pdk_name");
        }
    }
    
    &get_topres_copy_cmd();
    &get_dev18_copy_cmd() if $pure33_switch==0;
    

    ##Chengcheng 10/7
    ##for define differnet library name in cds.lib 
    open(CDSLIB_part, ">>", "$cfg->{install_pdk_path}\/$pdk_name\/cds.lib") or die "Cannot open cds.lib: $!\n";
    print CDSLIB_part qq/DEFINE $cfg->{library_name} .\/$cfg->{library_name}\n/;
    close CDSLIB_part;

    system("rm cds.lib");
    system("rm .cdsinit");
    print "\nPDK installation complete.\n";
    print "The PDK is .\/$pdk_name/\n";
}


sub get_input_opt {
    my $opt = shift;
    my $line;
    # print prompts
    if (defined $opt->{prompt} and $opt->{prompt}) {
        print $opt->{prompt};
    }
    #if (defined $opt->{default} and $opt->{default}) {
    #    print " [$opt->{default}]";
    #}
    print ": ";

    # get input
    $line = <STDIN>;
    chomp $line;
    #unless ($line) {
    #    $line = $opt->{default} if defined $opt->{default} and $opt->{default};
    #}
    unless ($line =~ /^\d+$/ and int($line) >0 and int($line) <= @{$opt->{value}}) {
        print "***Unexpected input value***\n";
        return &get_input_opt($opt);
    }


    return $opt->{value}->[int($line) - 1];
}


