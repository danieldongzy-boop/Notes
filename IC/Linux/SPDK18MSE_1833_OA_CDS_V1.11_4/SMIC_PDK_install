sub get_cell_deleting_cmd {
    my $out_str;
    if (@remove_resistor_list) {
        my $deleting_cell_str = join '" "', @remove_resistor_list;
        $out_str .= qq/lib_obj = ddGetObj("$cfg->{library_name}")\n/;
        $out_str .= qq/name_list = list("$deleting_cell_str")\n/;
        $out_str .= qq/cells = setof(cell lib_obj~>cells and(member(cell~>name name_list)))\n/;
        $out_str .= qq/when(cells foreach(cell cells ddDeleteLocal(cell)))\n/;
        $out_str .= qq/ddUpdateLibList()\n/;
    }
    return $out_str;

}


