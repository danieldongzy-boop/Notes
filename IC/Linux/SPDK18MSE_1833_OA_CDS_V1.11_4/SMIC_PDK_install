sub lvs_install {
    my @files_inlvsori=glob "$cfg->{lvs_root_path}/*" ;
    my @lvsfile_inlvsori=glob "$cfg->{lvs_root_path}/*.lvs" ;
    my $lvs_file_num=@lvsfile_inlvsori ;
    if (-d "$cfg->{install_lvs_path}") {
        system("rm -rf $cfg->{install_lvs_path}");
    }
    system("mkdir $cfg->{install_lvs_path}");
    unless( $lvs_file_num == 1 ) {
      print STDERR "ERROR: Cannot find LVS file. Install Abort!\n";
      exit 1;
    }
    print qq/install LVS......\n/;
    my $lvsfile_inlvsori=shift @lvsfile_inlvsori ;
    my $lvsfile_basename=basename $lvsfile_inlvsori ;
    foreach (@files_inlvsori) {
       if ($_ eq $lvsfile_inlvsori) {
           my @lvs_lines=&readfile($lvsfile_inlvsori) ;
           open(LVSOUT,">$cfg->{install_lvs_path}/$lvsfile_basename") ;
           foreach (@lvs_lines) {
               if (/#DEFINE TOPMETAL/) {
                   my $topmetal=6 ;
                   if ($cfg->{metal_option}=~/\d+P(\d+)M/) {
                       $topmetal=$1 ;
                   } 
                   s/#DEFINE TOPMETAL \d+/#DEFINE TOPMETAL $topmetal/ ;
               }
               if (/#DEFINE TM_TYPE/) {
                   my $topmetaltype="9K" ;
                   if ($cfg->{metal_option}=~/TMa(\d+)/) {
                       if ($1 eq 1) {
                          $topmetaltype="9K" ;
                       }
                       if ($1 eq 2) {
                          $topmetaltype="22K" ;
                       }
                       if ($1 eq 3) {
                          $topmetaltype="34K" ;
                       }
                       if ($1 eq 4) {
                          $topmetaltype="40K" ;
                       }
                   }
                   s/#DEFINE TM_TYPE \w+/#DEFINE TM_TYPE $topmetaltype/ ;    
               }
               if (/#DEFINE MIM_TYPE/) {
                   my $mimtype="1" ;
                   if ($cfg->{metal_option}=~/MIM(\d+)/) {
                       if ($1 eq 10) {
                          $mimtype="1" ;
                       }
                       if ($1 eq 20) {
                          $mimtype="2" ;
                       }
                   } 
                   s/#DEFINE MIM_TYPE \w+/#DEFINE MIM_TYPE $mimtype/ ;    
               }
               print LVSOUT "$_\n" ;
           }
           close  LVSOUT ;
       } else {
           system("cp -rf $_  $cfg->{install_lvs_path}"); 
       }
    } 
}

