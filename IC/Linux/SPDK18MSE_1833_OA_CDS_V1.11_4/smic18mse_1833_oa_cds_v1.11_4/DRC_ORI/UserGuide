This document is intended to be a release note for the users who adopt SMIC 0.18um Logic & Mix-signal 1.8V/3.3V Design Rule check (DRC) runset of Calibre DRC for Design Rule Checking for their design reference. Users must run all of the runset files in this release for your design which includes main rule, antenna and ESD DRC checking.

1.DRC tool version
Calibre tool version: 2016.3_19.12
Required license: calibredrc, calibrehdrc. 
Please make sure you have installed the required software before running this DRC.

2.Calibre DRC deck options setup
There are 2 DRC decks in the package. 
“SMIC_CalDRC_018LGMS_1833_V1.19_REV1_0.drc” is the DRC for main rules. 
“SMIC_CalDRC_018LGMS_1833_V1.19_REV1_0.ant” is the DRC especially for Antenna rules.
Please set the switches in runset before you run the decks. Please notice that this runset must be run with Calibre versions 2016.3_19.12.
Users must run these 2 runset files for your design.

3.Options setting for DRC deck
3.1 Options setting for main rules DRC decks
#=========================================================================================#
#                              Choice 1: For Metal Option                                 # 
#-----------------------------------------------------------------------------------------#
# Note 1: This rule file support 1P6M, 1P5M, 1P4M and 1P3M process Calibre DRC check. 
# Note 2: Below switches are for users, please set them based on the chip design.
# Note 3: Default check 1P6M, M6 as top metal and follow normal top metal rule('MT').

set metal_counts 6          ; #valid value is: {6,5,4,3}
                            ; #For 1P6M process, "metal_counts = 6".
                            ; #For 1P5M process, "metal_counts = 5".
                            ; #For 1P4M process, "metal_counts = 4".
                            ; #For 1P3M process, "metal_counts = 3".

set top_metal  MT           ; #valid value is: {MT,MTT,MTT1,MTT2} 
                            ; #Default check "MT"
                            ; #For normal 0.9825um thick top metal process, please set to "MT".
                            ; #For 2.2um thick top metal process, please set to "MTT".
                            ; #For 3.41um thick top metal process, please set to "MTT1".
                            ; #For 4.11um thick top metal process, please set to "MTT2".


#=========================================================================================#
#                              Choice 2: For 0.153um Shrink                               # 
#-----------------------------------------------------------------------------------------#
# Note 4: This option is for 0.153 shrink SAB_2a, Mn_5a_R (inter-metal) and MT_4a_R rules.

VERBATIM {
#DEFINE NW_space_check  180		//; The valid value is: {180,153}
                                //; #-----------------------------------------------------------
								//; #For 0.180um, please set to "180". Default set to "180".
								//; #For 0.153um shrink, please set to "153".

#DEFINE	153_shrink_check  YES    //; The valid value is: {YES,NO}
								//; #-------------For 0.153um shrink, turn_off by default.
								//; #Switch setting enable only when "NW_space_check" is "153".
}


#=========================================================================================#
#                              Choice 3: For Recommended Rule                             # 
#-----------------------------------------------------------------------------------------#
# Note 5: Recommended to make some useful choices to speed DRC running time.

VERBATIM { 
#DEFINE OPEN_RECOMMENDED_DEFAULT_OFF  NO		//; The valid value is: {YES,NO}
									            //; #-Recommended rules a: turn-off ("NO") by default for below rules.
									            //; #AA_13_R,DG_6_R,DG_7_R,GT_15_R,HRP_1_R,MIM_9_R,MIM_15a_R,MIM_18_R
									            //; #MT_6a_R,MTT_7b_R,MTT1_7b_R,MTT2_7b_R,Mn_7a_R;
									            //; #MT_1a_R,MTT_1a_R,MTT1_1a_R,MTT2_1a_R,Mn-1_1a_R('n-1'=1~5);
												//; #M1_4a_R, M1_4b_R, Mn_4a_R, Mn_4b_R (n=1~5);
												//; #Vn_7_R (n=1~5);
									            //; #GPR (Poly-resistor rules), GRESAA (AA-resistor rules).
								  	            //; #GEFU E-FUSE guidelines,GPI Polyimide guideline.
									            //; #GMIMDMY MIM guidelines,GFUSE Metal fuse guidelines.

#DEFINE OPEN_RECOMMENDED_DEFAULT_ON   YES		//; The valid value is: {YES,NO}
										        //; #-Recommended rules b: turn-on ("YES") by default for below rules.
										        //; #MIM_6_R,NR_9,DUP pad guidelines,LOGO design guidelines,Metal slot guidelines.
										        //; #DNW_12_R and GT_16_R.
}


#=========================================================================================#
#                              Choice 4: For Guideline Rule                               # 
#-----------------------------------------------------------------------------------------#
# Note 6:  Guideline rule switches to make some useful choices to speed DRC running time.

VERBATIM {
#DEFINE guideline_a_check  NO		//; The valid value is: {YES,NO};
									//; #Guideline rules a: turn-off ("NO") by default for below rules.
									//; #GESD ESD guidelines;
									//; #GEFU E-FUSE guidelines,GPI Polyimide guidelines;
									//; #GMIMDMY MIM guidelines,GFUSE Metal fuse guidelines.
#DEFINE guideline_b_check  YES		//; The valid value is: {YES,NO}
									//; #Guideline rules b: turn-on ("YES") by default for below rules.
									//; #DUP pad guidelines,LOGO design guidelines,Metal slot guidelines;
						 	        //; #Latch up guidelines.
}

#=========================================================================================#
#                              Choice 5: For ESD1 option Rule                              # 
#-----------------------------------------------------------------------------------------#
VERBATIM {

#DEFINE ESD1_Approach_A YES               //; The Valid value is: {YES,NO}
									      //; The option is to define ESD1 option for approach_A;
									      //; Default valus is YES.
}

#=========================================================================================#
#                              Choice 6: For ESD1 option Rule                              # 
#-----------------------------------------------------------------------------------------#
VERBATIM {

#DEFINE ESD1_Approach_B NO               //; The Valid value is: {YES,NO}
									     //; The option is to define ESD1 option for approach B;
									     //; Default valus is NO.
}


#=========================================================================================#
#                              Choice 7: For Latch-up connection Rule                              # 
#-----------------------------------------------------------------------------------------#

VERBATIM {

#DEFINE PADTEXT_TOP  YES  	   	           //; valid value is: {YES,NO}
					                       //; This switch is used to control the recognition of text depth, the swtich is "YES"/
					                       //; /by default to recognize the top level text for power pad and I/O pad. It is/
					                       //; /defined "NO" to recognize text objects from all levels of layout hierarchy

/* 
   This group of switches is for the power pad & I/O pad recognition of latch up rules (LU) by label.
   Users can update the power and ground names here below based on their design.
   Any power pad & I/O pad names can be added refer following example: VARIABLE POWER_NAME  "?VDD?" "?VCC?" "?1?" "?2?"...
   The default power pad names are "?VDD?" "?VCC?" "?VSS?" "?GND?"; default I/O pad name is "?I/OPAD?"
   If there are less than 3 power names or less than 3 ground names needed, some of them can be set as same value.
*/

VARIABLE POWER_NAME  "?VDD?" "?VCC?" "?VPP?" "?VBAT?" "?OUT?"
VARIABLE GROUND_NAME "?VSS?" "?GND?"



#DEFINE DEFINE_PAD_BY_TEXT  1      //;valid value is:  {0, 1}
								   //; default is 1
								   //; when "?VDD?","?VCC?","?VSS?","?GND?", "?VPP?", "?VBAT?", "?OUT?" as text name
								   //; if value is 0, it is regarded as I/O PAD; if value is 1, it is regarded POWER PAD.    
                                     

#DEFINE CONNECT_ALL_RESISTOR 0   //;valid value is:  {0,1}
								 //;default 0 
								 //;The switch (to connect AA resistor, poly resistor, well resistor between PAD and AA injector) can control the connectivity of resistor.   
							     //;if value is 0,the connection is broken; 
								 //;if value is 1,the connection is not broken;


#DEFINE LU_3_CHECK FAST    		    //; valid value is: {FAST, ACCURATE}
                           		    //; this switch is only for LU_3_3a_G,LU_3_3b_G,LU_3_3c_G rules 
                           		    //; default value is "FAST" to fast check LU_3_? rules and reduce runtime,yet it may report false alarm in min space value. 
                           	 	    //; please change the value "FAST" into "ACCURATE",if you want to accurately check LU_3_? rules, yet it have long runtime.

}

#=========================================================================================#
#                              Choice 8: For Density check Rule							  # 
#-----------------------------------------------------------------------------------------#

VERBATIM {

#DEFINE DENSITY_CHECK YES           //; The Valid value is: {YES,NO}
							        //; The option is to define density check option, including rules GT_12, 
									//; M1_7, M1_7a_R, Mn_7, Mn_7a_R, MT_6, MT_6a_R, MTT_7, MTT_7b_R, MTT1_7, 
									//; MTT1_7b_R, MTT2_7, MTT2_7b_R, MIM_9_R, SL_8_G;
							        //; Default valus is YES.

}


//---------------------------- End of Switch Setting --------------------------------------#
//=========================================================================================#

