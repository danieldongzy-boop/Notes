#! tvf
namespace import tvf::*

#=========================================================================================#
#                              Choice 1: For Metal Option                                 # 
#-----------------------------------------------------------------------------------------#
# Note 1: This rule file support 1P6M, 1P5M, 1P4M and 1P3M process Calibre Antenna check. 
# Note 2: Below switches are for users, please set them based on the chip design.
# Note 3: Default check 1P6M, M6 as top metal and follow normal top metal rule('MT').

set metal_counts  6         ; #valid value is: {6,5,4,3}
                            ; #------ Total metal counts ----------------------------------                           
                            ; #For 1P6M process, "metal_counts = 6".
                            ; #For 1P5M process, "metal_counts = 5".
                            ; #For 1P4M process, "metal_counts = 4".
                            ; #For 1P3M process, "metal_counts = 3".

set top_metal  MT			; #valid value is: {MT,MTT,MTT1,MTT2}
                            ; #------ Top metal option -----------------------------------
                            ; #Default check "MT";
						   	; #For 0.9825 um thick top metal process, please set to "MT".
                            ; #For 2.200 um thick top metal process, please set to "MTT".
                            ; #For 3.410 um thick top metal process, please set to "MTT1".
                            ; #For 4.110 um thick top metal process, please set to "MTT2".

#---------------------------- End of Switch Setting --------------------------------------#
#=========================================================================================#

VERBATIM {
// For 1P6M, M6 (top metal) is drawn on GDS (66:0), Top Via is drawn on GDS (74:0)|
// For 1P5M, M5 (top metal) is drawn on GDS (65:0), top via is drawn on GDS (73:0)|
// For 1P4M, M4 (top metal) is drawn on GDS (64:0), top via is drawn on GDS (72:0)|
// For 1P3M, M3 (top metal) is drawn on GDS (63:0), top via is drawn on GDS (71:0)|

//  You need refer to the result reports after running this file.
//  1) *.rep will provide GATE area information
//=================================================================================
//|                                                                               |
//|  0.18um Calibre Antenna rule file for                                         |
//|                                                                               |
//|       SMIC:           0.18um Logic & Mix-signal 1.8V/3.3V Design Rule         |
//|       Doc. No.:    TD-LO18-DR-2001       Rev.: 12    Tech.Dev Rev: 1.19_REV1  |
//|                                                                               |
//|  Validated with Calibre version      2016.3_19.12                             |
//|                                                                               |
//|  SMIC Technology R&D                                                          |
//|                                                                               |
