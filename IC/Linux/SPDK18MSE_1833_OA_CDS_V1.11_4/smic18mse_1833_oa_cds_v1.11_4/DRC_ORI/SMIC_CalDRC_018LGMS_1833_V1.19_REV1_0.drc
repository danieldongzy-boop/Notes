VERBATIM {

//***********************************************
//      ESD Design Rules and Guideline
//***********************************************

ESD1 = ESD1i NOT EXCLU
POLYI = GTO OUTSIDE RES1
ESDDUM5V = ESD5V NOT EXCLU
NWI1 = NW OUTSIDE RESNW
AAI1 = AAO OUTSIDE (RES1 OR RESNW)

ESD = ESD1 AND ESDIO2
EPOLY = POLYI AND ESDIO2

NDIF = AAI1 AND SN
PDIF = AAI1 AND SP
GATE1 = POLYI AND AAI1
NGATE1 = GATE1 AND SN

ENDIF = NDIF AND ESDIO2
EPDIF = PDIF AND ESDIO2
EDIF  = ENDIF OR EPDIF
ENACT = ENDIF NOT NWI1
EPACT = EPDIF AND NWI1
NACT1  = NDIF NOT NWI1
PACT1  = PDIF AND NWI1

NTAP1 = NDIF NOT NACT1
PTAP1 = PDIF NOT PACT1
ENTAP = ENDIF NOT ENACT
EPTAP = EPDIF NOT EPACT

ENGUARDRING = HOLES ENTAP INNER EMPTY
EPGUARDRING = HOLES EPTAP INNER EMPTY
ENGUARDHOLE_2 = (HOLES ENTAP INNER) ENCLOSE EPGUARDRING
EPGUARDHOLE_2 = (HOLES EPTAP INNER) ENCLOSE ENGUARDRING

EGATE  = GATE1 AND ESDIO2
ENGATE = EGATE AND ENACT
EPGATE = EGATE AND EPACT
EGATEHV = EGATE AND DG
EGATELV = EGATE NOT DG

ENGATEHV = EGATEHV AND ENACT
EPGATEHV = EGATEHV AND EPACT

ENGATELV = EGATELV AND ENACT
EPGATELV = EGATELV AND EPACT

EGATE_W = EPOLY INSIDE EDGE EDIF
EGATE_L = EDIF INSIDE EDGE EPOLY

ENGATE_W = EPOLY INSIDE EDGE ENACT
ENGATE_L = ENACT INSIDE EDGE EPOLY

EPGATE_W = EPOLY INSIDE EDGE EPACT
EPGATE_L = EPACT INSIDE EDGE EPOLY

ENGATEHV_W = ENGATE_W COIN EDGE EGATEHV
ENGATEHV_L = ENGATE_L COIN EDGE EGATEHV
EPGATEHV_W = EPGATE_W COIN EDGE EGATEHV
EPGATEHV_L = EPGATE_L COIN EDGE EGATEHV

ENGATELV_W = ENGATE_W COIN EDGE EGATELV
ENGATELV_L = ENGATE_L COIN EDGE EGATELV
EPGATELV_W = EPGATE_W COIN EDGE EGATELV
EPGATELV_L = EPGATE_L COIN EDGE EGATELV

ENMOS = ENACT ENCLOSE EGATE
EPMOS = EPACT ENCLOSE EGATE
NMOS2  = NACT1  ENCLOSE GATE1
PMOS2  = PACT1  ENCLOSE GATE1

ENMOS_SD = ENMOS NOT EGATE
EPMOS_SD = EPMOS NOT EGATE
ECO = AAI1 AND (CTO AND ESDIO2)

ESAB = SAB AND ESDIO2
ESAB_HO = HOLES ESAB INNER EMPTY
ECO_SRC = ECO OUTSIDE ESAB_HO
ECO_DRN = ECO NOT ECO_SRC

ENMOS_SRC = ENMOS_SD ENCLOSE ECO_SRC
ENMOS_DRN = ENMOS_SD NOT ENMOS_SRC

EPMOS_SRC = EPMOS_SD ENCLOSE ECO_SRC
EPMOS_DRN = EPMOS_SD NOT EPMOS_SRC

EMOS_DRN = ENMOS_DRN OR EPMOS_DRN

EPOLYFINGERA = EPOLY INTERACT EGATE
EPOLYFINGERB = INT EPOLYFINGERA < 0.01 ABUT==90 REGION
EPOLYFINGER = EPOLYFINGERA INTERACT EPOLYFINGERB >= 4
EGATE_FW = EGATE_W COIN EDGE EPOLYFINGER

EGATELVF  = EGATELV AND EPOLYFINGER
ENGATELVF = ENGATELV AND EPOLYFINGER
EPGATELVF = EPGATELV AND EPOLYFINGER
EGATEHVF  = EGATEHV AND EPOLYFINGER
ENGATEHVF = ENGATEHV AND EPOLYFINGER
EPGATEHVF = EPGATEHV AND EPOLYFINGER

CONNECT EGATELVF EPOLYFINGER
CONNECT EGATEHVF EPOLYFINGER
CONNECT ENGATEHVF EPOLYFINGER 
CONNECT EPGATEHVF EPOLYFINGER
CONNECT ENGATELVF EPOLYFINGER
CONNECT EPGATELVF EPOLYFINGER

ESD3C = EXPAND EDGE (EGATE INSIDE EDGE AAI1) INSIDE BY 0.001

LAYER EMPTY1 5432
ENGATE_D_EMPTY = EMPTY1 OR ENMOS_DRN
EPGATE_D_EMPTY = EMPTY1 OR EPMOS_DRN
ESD3C_EMPTY = EMPTY1 OR ESD3C
}

for { set j 1 } { $j <= $metal_counts } { incr j } {
SETLAYER EM${j}_EMPTY = EMPTY1 OR M${j}0
}

for { set j 1 } { $j <= $metal_counts - 1 } { incr j } {
SETLAYER EV${j}_EMPTY = EMPTY1 OR V${j}i
}

VERBATIM {
ECT_EMPTY = EMPTY1 OR (ESDIO2 AND CTi)
EPA_EMPTY = EMPTY1 OR  PAi
EMIM_EMPTY = EMPTY1 OR (ESDIO2 AND MIMi)


CONNECT ENGATE_D_EMPTY ESD3C_EMPTY
CONNECT EPGATE_D_EMPTY ESD3C_EMPTY
CONNECT ENGATE_D_EMPTY EM1_EMPTY BY ECT_EMPTY
CONNECT EPGATE_D_EMPTY EM1_EMPTY BY ECT_EMPTY
CONNECT EM1_EMPTY EM2_EMPTY BY EV1_EMPTY
}

if {$metal_counts == 3} {
SETLAYER EV2_AND_MIM_EMPTY = EV2_EMPTY AND EMIM_EMPTY
SETLAYER EV2_NOT_MIM_EMPTY = EV2_EMPTY NOT EMIM_EMPTY
CONNECT EM2_EMPTY EM3_EMPTY BY EV2_NOT_MIM_EMPTY
CONNECT EMIM_EMPTY EM3_EMPTY BY EV2_AND_MIM_EMPTY
CONNECT EM3_EMPTY EPA_EMPTY
}

if {$metal_counts == 4} {
SETLAYER EV3_AND_MIM_EMPTY = EV3_EMPTY AND EMIM_EMPTY
SETLAYER EV3_NOT_MIM_EMPTY = EV3_EMPTY NOT EMIM_EMPTY
CONNECT EM2_EMPTY EM3_EMPTY BY EV2_EMPTY
CONNECT EM3_EMPTY EM4_EMPTY BY EV3_NOT_MIM_EMPTY
CONNECT EMIM_EMPTY EM4_EMPTY BY EV3_AND_MIM_EMPTY
CONNECT EM4_EMPTY EPA_EMPTY
}

if {$metal_counts == 5} {
SETLAYER EV4_AND_MIM_EMPTY = EV4_EMPTY AND EMIM_EMPTY
SETLAYER EV4_NOT_MIM_EMPTY = EV4_EMPTY NOT EMIM_EMPTY
CONNECT EM2_EMPTY EM3_EMPTY BY EV2_EMPTY
CONNECT EM3_EMPTY EM4_EMPTY BY EV3_EMPTY
CONNECT EM4_EMPTY EM5_EMPTY BY EV4_NOT_MIM_EMPTY
CONNECT EMIM_EMPTY EM5_EMPTY BY EV4_AND_MIM_EMPTY
CONNECT EM5_EMPTY EPA_EMPTY
}

if {$metal_counts == 6} {
SETLAYER EV5_AND_MIM_EMPTY = EV5_EMPTY AND EMIM_EMPTY
SETLAYER EV5_NOT_MIM_EMPTY = EV5_EMPTY NOT EMIM_EMPTY
CONNECT EM2_EMPTY EM3_EMPTY BY EV2_EMPTY
CONNECT EM3_EMPTY EM4_EMPTY BY EV3_EMPTY
CONNECT EM4_EMPTY EM5_EMPTY BY EV4_EMPTY
CONNECT EM5_EMPTY EM6_EMPTY BY EV5_NOT_MIM_EMPTY
CONNECT EMIM_EMPTY EM6_EMPTY BY EV5_AND_MIM_EMPTY
CONNECT EM6_EMPTY EPA_EMPTY
}

VERBATIM {

//=============================================
//1.8V/3.3V IO ESD Design and Layout Guideline
//=============================================

#IFDEF guideline_a_check YES

GROUP GESD ESD_?

ESD_2_G { 
@ Unit finger width (F) of NMOS and PMOS for I/O buffer and Vdd to Vss protection is >= 15um <= 60um
  PATH LENGTH EGATE_FW < 15
  PATH LENGTH EGATE_FW > 60
}
ESD_3a_G {
@ Channel width (W) of NMOS for ESD protection device (Channel width = Finger width x Finger No.). >= 360um
@ Note: The total channel width is calculated by the ESD MOS in the same Drain connection. SAB in ESDIO2 region is used for drain recognition in 
@ DRC runset. The connectivity (not limited in ESDIO2 region) can be formed by all metal, via, ALPA, PA and MD and not broken by resistors.
  ENGATE_D_ACTIVE = ENGATE_D_EMPTY INTERACT ECT_EMPTY
  X = NET AREA RATIO ENGATE_D_ACTIVE ESD3C_EMPTY [AREA(ESD3C_EMPTY)/0.001] < 360
  X INTERACT ENGATE
}
ESD_3b_G {
@ Channel width (W) of PMOS for ESD protection device (Channel width=Finger width x Finger No.). >= 360um
@ Note: The total channel width is calculated by the ESD MOS in the same Drain connection. SAB in ESDIO2 region is used for drain recognition in 
@ DRC runset. The connectivity (not limited in ESDIO2 region) can be formed by all metal, via, ALPA, PA and MD and not broken by resistors.
  EPGATE_D_ACTIVE = EPGATE_D_EMPTY INTERACT ECT_EMPTY
  X = NET AREA RATIO EPGATE_D_ACTIVE ESD3C_EMPTY [AREA(ESD3C_EMPTY)/0.001] < 360
  X INTERACT EPGATE
} 
ESD_4a_G {
@ Gate length for protection devices: gate length for 3.3V I/O NMOS is >= 0.35um
  PATH LENGTH ENGATEHV_L < 0.35
}
ESD_4b_G {
@ Gate length for protection devices: gate length for 3.3V I/O PMOS is >= 0.30um
  PATH LENGTH EPGATEHV_L < 0.30
}
ESD_4c_G {
@ Gate length for protection devices: gate length for 1.8V I/O NMOS is >= 0.20um
  PATH LENGTH ENGATELV_L < 0.20
}
ESD_4d_G {
@ Gate length for protection devices: gate length for 1.8V I/O PMOS is >= 0.20um
  PATH LENGTH EPGATELV_L < 0.20
}
ESD_5_G {
@ Space from poly edge to CT edge on source side (SCP) for 1.8/3.3V NMOS and PMOS is >= 0.75um
   EXT EGATE_W ECO_SRC < 0.75 ABUT<90 REGION
}
ESD_6_G {
@ Space from poly edge to CT edge on drain side (DCP) for 1.8/3.3V NMOS and PMOS is >= 2.22um
  EXT EGATE_W ECO_DRN < 2.22 ABUT<90 REGION
}
ESD_7_G {
@ SAB should be drawn at least on drain side of 1.8/3.3V NMOS and PMOS (contact region should be kept silicided)
@ Note: DRC will only highlight the case when no SAB in one side of GATE(SAB must interact GATE)	
  EGATE NOT INTERACT SAB
  ECO AND ESAB
}
#ENDIF

#IFDEF guideline_a_check YES
#DEFINE ESD_8_G YES 
#ENDIF

#IFDEF ESD1_Approach_A YES
#DEFINE ESD_8_G YES 
#ENDIF

#IFDEF ESD_8_G YES 

ESD_8a_G {
@ Width of SAB on the drain side (A) and SAB edge to the AA edge (B) for 1.8V/3.3V NMOS and PMOS used as an ESD device. 
@ Note: A does not include the overlap of SAB area and GT (7.3.7.2 Fig.2 &5)
  EXT ESAB_HO ENGATEHV_W < 2 ABUT<90 REGION
}
ESD_8b_G {
@ Width of SAB on the drain side (A) and SAB edge to the AA edge (B) for 1.8V/3.3V NMOS and PMOS used as an ESD device. 
@ Note: A does not include the overlap of SAB area and GT (7.3.7.2 Fig.2 &5)
  EXT ESAB_HO EPGATEHV_W < 2 ABUT<90 REGION
}
ESD_8c_G {
@ Width of SAB on the drain side (A) and SAB edge to the AA edge (B) for 1.8V/3.3V NMOS and PMOS used as an ESD device. 
@ Note: A does not include the overlap of SAB area and GT (7.3.7.2 Fig.2 &5)
  ENC ESAB_HO ENMOS_DRN < 2 ABUT<90 SINGULAR REGION
  ENC ESAB_HO EPMOS_DRN < 2 ABUT<90 SINGULAR REGION
}
#ENDIF

#IFDEF guideline_a_check YES

ESD_9a_G {
@ ESD protection devices should be surrounded by guard ring, this guard ring also can be designed as the pickup of the ESD device
  NOT ENGATE EPGUARDRING
}
ESD_9b_G {
@ ESD protection devices should be surrounded by guard ring, this guard ring also can be designed as the pickup of the ESD device
  NOT EPGATE ENGUARDRING
}

EGATEHV_OVLAP = (EGATEHV CUT ESAB) NOT ESD5V
EGATELV_OVLAP = (EGATELV CUT ESAB) NOT ESD5V
ESD_13a_G {
@ The overlap (Sd) of the SAB and poly of 3.3V N/PMOS region should be >= 0.06um
@ Note: A does not include the overlap of SAB area and GT.
  INT EGATEHV_OVLAP ESAB < 0.06 ABUT<90 SINGULAR REGION
}
ESD_13b_G {
@ The overlap (Sd) of the SAB and poly of 1.8V N/PMOS region should be >= 0.06um
@ Note: A does not include the overlap of SAB area and GT
  INT EGATELV_OVLAP ESAB < 0.06 ABUT<90 SINGULAR REGION
}
ESD_13c_G {
@ The overlap (Sd) of the SAB and poly of 1.8V/3.3V N/PMOS region should be >= 0.06um
@ Note: A does not include the overlap of SAB area and GT
  EGATE NOT INTERACT ESAB
}
ESD_14_G {
@ For high voltage tolerant I/O using Cascaded 3.3V NMOS, ESD implant is required
//@ (ESDIO2 AND ESDHV) must overlap with ESD1
  ESDDUM5V NOT INTERACT ESD
}

EGATE5V = ESD5V AND EGATE
EGATE5V_OVLAP = EGATE5V CUT ESAB
EGATE5V_INSID = EGATE5V INSIDE ESAB

ESD_15_G {
  @ The spacing (S) between active poly gate and inactive poly gate of Cascaded 3.3V NMOS and PMOS should be <= 0.6um
  EXT EGATE5V_OVLAP EGATE5V_INSID > 0.6 <10 OPPOSITE ABUT <90 SINGULAR EXCLUDE SHIELDED
}
ESD_16_G {
//  @ For high voltage tolerant I/O designed by 3.3V NMOS and PMOS, SAB should cover all top poly gates and extend to overlap the second poly gate by >= 0.06um
  @ For high voltage tolerant I/O designed by 3.3V cascoded, SAB should cover all top poly gates and extend to overlap the second poly gate by >= 0.06um
  INT EGATE5V_OVLAP ESAB < 0.06 ABUT<90 SINGULAR REGION
}

#IFDEF ESD1_Approach_A YES 
ESD_25a_G {
@ Width (D) of the SAB hole in source/drain direction < 1um.
  ESAB_HO WITH WIDTH >=1 
} 
#ENDIF


/*
// ESD_1_G [NC]:Finger-type structure with uniform finger width is suggested for N/P MOS ESD protection design
// ESD_10_G [NC]:The NMOS/PMOS should be added after the input resistor R as the secondary ESD protection for better ESD immunity
// if there is no conflict with circuit operation

// ESD_11_G [NC]:Value of input resistor R = 200ohm
// ESD_12_G [NC]:The suggested device size for secondary ESD protection are:
//                      For 1.8V N/PMOS, W/L=20/0.2(um) 
//                      For 3.3V I/O NMOS, W/L=20/0.35 (um)   
//                      For 3.3V I/O PMOS, W/L=20/0.3 (um)  
// ESD_17_G [NC]:Contacts should be used as many as possible, and at least capable of bearing 100mA DC current.
// That is, the minimum number of contact drawn on rule is >= 189

// ESD_18_G [NC]:Vias should be used as many as possible, and at least capable of bearing 100mA DC current. 
// That is, the minimum number of contact drawn on rule is >= 358

// ESD_19_G [NC]:Total width (W1) of metal lines to connect bonding pad and ESD protecting devices >= 20um
// ESD_20_G [NC]:Metal width (W2) on the drain side of ESD devices >= 4.5um
// ESD_21_G [NC]:Vss and Vdd power ring metal width >= 50um
// ESD_22_G [NC]:All nods directly connecting to ESD discharge path should follow ESD dimension rules 

// ESD_23_G [NC]:The edge side of AA of ESD devices or I/O buffers should be Source or Bulk rather than Drain (Fig.1),
// to avoid the unwanted parasitic bipolar effect or abnormal discharge path in ESD zapping

// ESD_24_G [NC]:In Chip level ESD guideline, the poly gate of N/PMOS of internal and I/O circuit is not allowed to connect to power/ground or input/output pad directly
// ESD_24a_G [NC]:Secondary ESD protection or tie-high/tie-low cell is strongly recommended to insert between poly gate and power/ground pad or input/out pad
// ESD_24b_G [NC]:N/PMOS used for capacitor is not recommended to connected power/ground or input/output pad directly
// ESD_24c_G [NC]:Poly resistor and ESD protection N/PMOS (including primary and secondary ESD protection) can be exempt for this rule
// ESD_25_G [NC] ESD.25a must be followed to generate correct ESD1 implant pattern with SMIC logic operation.(For ESD1 layer Approach A)
*/

#ENDIF

#IFDEF ESD1_Approach_A YES

//==================================
// ESD1_A Implantantion Guidance
//==================================


GROUP GESD1_A ESD1_A_?

ESD1_A_1 {
@ ESD1 width is >= 0.60um
  INT ESD1 < 0.60 ABUT<90 SINGULAR REGION
}
ESD1_A_2 {
@ Space between two ESD1s is >= 0.60um. Merge if the space is less than this value
  EXT ESD1 < 0.60 ABUT<90 SINGULAR REGION
}
ESD1_A_3 {
@ ESD1 area is >= 1.00um*um
  AREA ESD1 < 1
}

ESD1_A_5 {
//@ N+AA must be fully enclosed by ESD1	>= 0um.
@ N+AA cut ESD1 is not allowed.
  (NACT INSIDE ESDIO2) CUT ESD1
}

//ESD1.5 {
//@ ESD1.5a and ESD1.5b are for post-LOTA check and pre-LOTA check specifically
//}
//ESD1.Guidance.5b {
//@ Space between an ESD1 and an N-channel gate is >= 0.40um , ESD1 cannot butt gate
//  EXT NGATE ESD1 < 0.4 ABUT<90 SINGULAR REGION
//}
//ESD1.Guidance.9[NC] {
//@ ESD1 can be drawn in NMOS ESD device area and generated from logic operation
//}
#ENDIF

#IFDEF ESD1_Approach_B YES

//===========================
// ESD1_B Implantantion Guidance
//===========================


GROUP GESD1_B ESD1_B_?

ESD1_B_1 {
@ ESD1 width is >= 0.60um
  INT ESD1 < 0.60 ABUT<90 SINGULAR REGION
}
ESD1_B_2 {
@ Space between two ESD1s is >= 0.60um. Merge if the space is less than this value
  EXT ESD1 < 0.60 ABUT<90 SINGULAR REGION
}
ESD1_B_3 {
@ ESD1 area is >= 1.00um*um
  AREA ESD1 < 1
}

ESD1_B_5 {
@ Space between an ESD1 and an N-channel gate is >= 0.40um , ESD1 cannot butt gate
  EXT (NGATE INSIDE ESDIO2) ESD1 < 0.4 ABUT<90 SINGULAR REGION
}

ESD1_B_6 {
@ ESD1 must be enclosed by AA at least 0.20um
  ENC ESD1 (AA INSIDE ESDIO2) < 0.2 ABUT<90 SINGULAR REGION
}
ESD1_B_7 {
@ ESD1 is not allowed to overlap with SP
  ESD1 AND (SP INSIDE ESDIO2)
}
ESD1_B_8 {
@ CT must be fully enclosed by (ESD1 AND ESDIO2); 
@ CT enclosure by (ESD1 AND ESDIO2) (7.3.7.3 Fig. 3) >= 0.40um. 
//  X = (CTO INSIDE ESD1) OUTSIDE POLY
//  (CTO INTERACT ESDIO2) NOT (ESD1 AND ESDIO2)
  ENC (CTO INTERACT (ESD1 AND ESDIO2)) (ESD1 AND ESDIO2) < 0.4 ABUT<90 OUTSIDE ALSO SINGULAR REGION
}

#ENDIF

#IFDEF guideline_b_check YES


//===========================================
//  Latch-Up Prevention Layout Guidelines
//===========================================

GROUP GLU LU_?

}

SETLAYER NWRES = (((AA AND RESNW) AND NW) AND SAB) OR ((NW AND RESNW) NOT INTERACT SAB)
SETLAYER AARES = ((AA AND RESAA) AND SAB) OR ((AA AND RESAA) NOT INTERACT SAB)
SETLAYER GTRES = ((GT AND RESP1) AND SAB) OR ((GT AND RESP1) NOT INTERACT SAB)
SETLAYER HRPRES = (HRPDMY AND GT) AND SAB


SETLAYER AARES_1 = AA ENCLOSE AARES
SETLAYER NW_RES = COPY NWRES
SETLAYER ALL_RES1 = OR AARES_1 GTRES NW_RES HRPRES

SETLAYER NSD_0 = ((SN AND AA) NOT NW) NOT GT    
SETLAYER PSD_0 = ((SP AND AA) AND NW) NOT GT 

LAYER MAP 999 DATATYPE 1117 4327
LAYER EMPTY5 4327


foreach k $metal_list {
  SETLAYER  ${k}i_EMPTY5 = EMPTY5 OR (${k}i NOT ${k}SLOTi)
}
 
foreach l $via_list {
  SETLAYER  ${l}i_EMPTY5 = EMPTY5 OR ${l}i 
}

VERBATIM {                                                                                                                                                                
#IFDEF CONNECT_ALL_RESISTOR 0
}
SETLAYER  NSD_1 = EMPTY5 OR (NSD_0 NOT ALL_RES1) 
SETLAYER  PSD_1 = EMPTY5 OR (PSD_0 NOT ALL_RES1)
SETLAYER  NTAP_1 = EMPTY5 OR (NTAP NOT ALL_RES1)
SETLAYER  PTAP_1 = EMPTY5 OR (PTAP NOT ALL_RES1) 
SETLAYER  NW_1 = EMPTY5 OR (NW NOT ALL_RES1)
SETLAYER  GT_1  =  EMPTY5 OR (GT NOT ALL_RES1)

VERBATIM {
#ENDIF
}

VERBATIM {                                                                                                                                                                
#IFDEF CONNECT_ALL_RESISTOR 1
}

SETLAYER NSD_1 = EMPTY5 OR NSD_0  
SETLAYER PSD_1 = EMPTY5 OR PSD_0
SETLAYER NTAP_1 = EMPTY5 OR NTAP 
SETLAYER PTAP_1 = EMPTY5 OR PTAP 
SETLAYER NW_1 = EMPTY5 OR NW
SETLAYER GT_1  =  EMPTY5 OR GT

VERBATIM {
#ENDIF
}

SETLAYER CT_1 = EMPTY5 OR CTi
SETLAYER PA_1 = EMPTY5 OR PAi
SETLAYER PW_1 = EMPTY5 OR PW
SETLAYER MIMi_EMPTY5 = EMPTY5 OR MIMi

CONNECT M1i_EMPTY5 GT_1 NTAP_1 PTAP_1 NSD_1 PSD_1 BY CT_1
CONNECT NTAP_1 NW_1
CONNECT M1i_EMPTY5 M2i_EMPTY5 BY V1i_EMPTY5

if { $metal_counts == 3 } {
SETLAYER V2i_EMPTY5_AND_MIM = V2i_EMPTY5 AND MIMi_EMPTY5
SETLAYER V2i_EMPTY5_NOT_MIM = V2i_EMPTY5 NOT MIMi_EMPTY5
CONNECT M2i_EMPTY5 M3i_EMPTY5 BY V2i_EMPTY5_NOT_MIM
CONNECT MIMi_EMPTY5 M3i_EMPTY5 BY V2i_EMPTY5_AND_MIM
CONNECT M3i_EMPTY5 PA_1
}

if { $metal_counts == 4 } {
SETLAYER V3i_EMPTY5_AND_MIM = V3i_EMPTY5 AND MIMi_EMPTY5
SETLAYER V3i_EMPTY5_NOT_MIM = V3i_EMPTY5 NOT MIMi_EMPTY5
CONNECT M2i_EMPTY5 M3i_EMPTY5 BY V2i_EMPTY5
CONNECT M3i_EMPTY5 M4i_EMPTY5 BY V3i_EMPTY5_NOT_MIM
CONNECT MIMi_EMPTY5 M4i_EMPTY5 BY V3i_EMPTY5_AND_MIM
CONNECT M4i_EMPTY5 PA_1
}

if { $metal_counts == 5 } {
SETLAYER V4i_EMPTY5_AND_MIM = V4i_EMPTY5 AND MIMi_EMPTY5
SETLAYER V4i_EMPTY5_NOT_MIM = V4i_EMPTY5 NOT MIMi_EMPTY5
CONNECT M2i_EMPTY5 M3i_EMPTY5 BY V2i_EMPTY5
CONNECT M3i_EMPTY5 M4i_EMPTY5 BY V3i_EMPTY5
CONNECT M4i_EMPTY5 M5i_EMPTY5 BY V4i_EMPTY5_NOT_MIM
CONNECT MIMi_EMPTY5 M5i_EMPTY5 BY V4i_EMPTY5_AND_MIM
CONNECT M5i_EMPTY5 PA_1
}


if { $metal_counts == 6 } {
SETLAYER V5i_EMPTY5_AND_MIM = V5i_EMPTY5 AND MIMi_EMPTY5
SETLAYER V5i_EMPTY5_NOT_MIM = V5i_EMPTY5 NOT MIMi_EMPTY5
CONNECT M2i_EMPTY5 M3i_EMPTY5 BY V2i_EMPTY5
CONNECT M3i_EMPTY5 M4i_EMPTY5 BY V3i_EMPTY5
CONNECT M4i_EMPTY5 M5i_EMPTY5 BY V4i_EMPTY5
CONNECT M5i_EMPTY5 M6i_EMPTY5 BY V5i_EMPTY5_NOT_MIM
CONNECT MIMi_EMPTY5 M6i_EMPTY5 BY V5i_EMPTY5_AND_MIM
CONNECT M6i_EMPTY5 PA_1
}


#//recognise POWER PAD

foreach j $metal_list {
VERBATIM {
#IFDEF PADTEXT_TOP YES
}
SETLAYER all_pad_${j}_pwr = with text ${j}i POWER_NAME ${j}TXT primary only
SETLAYER all_pad_${j}_gnd = with text ${j}i GROUND_NAME ${j}TXT primary only
VERBATIM {
#ELSE
}
SETLAYER all_pad_${j}_pwr = with text ${j}i POWER_NAME ${j}TXT
SETLAYER all_pad_${j}_gnd = with text ${j}i GROUND_NAME ${j}TXT
VERBATIM {
#ENDIF
}
}

foreach i $metal_list {
SETLAYER all_pad_TXT_${i} = OR all_pad_${i}_pwr all_pad_${i}_gnd
SETLAYER all_pad_TXT1_${i} = STAMP all_pad_TXT_${i} BY ${i}i_EMPTY5
SETLAYER power_pad_TXT_${i} = ${i}i_EMPTY5 INTERACT (NET AREA RATIO ${i}i_EMPTY5 all_pad_TXT1_${i} > 0)
}

SETLAYER POWER_PAD1 = VSSMK1 OR VDDMK1
SETLAYER POWER_PAD2 = STAMP POWER_PAD1 BY PA_1
SETLAYER POWER_PAD3 = PA_1 INTERACT (NET AREA RATIO PA_1 POWER_PAD2 > 0)
SETLAYER PA_IO_PAD = PA_1 NOT INTERACT POWER_PAD3

VERBATIM {
#IFDEF DEFINE_PAD_BY_TEXT 0
}

SETLAYER NAA_IO_PAD = NET AREA RATIO NSD_1 PA_IO_PAD > 0 
SETLAYER PAA_IO_PAD = NET AREA RATIO PSD_1 PA_IO_PAD > 0 
SETLAYER NMOS_IO_PAD = NMOS INTERACT NAA_IO_PAD 
SETLAYER PMOS_IO_PAD = PMOS INTERACT PAA_IO_PAD


VERBATIM {
#ENDIF
}

VERBATIM {
#IFDEF DEFINE_PAD_BY_TEXT 1
}

SETLAYER NAA_PAD = NET AREA RATIO NSD_1 PA_IO_PAD > 0 
SETLAYER PAA_PAD = NET AREA RATIO PSD_1 PA_IO_PAD > 0

set list1 ""
set list2 ""
foreach metal_list1 $metal_list {
  SETLAYER NAA_POWER_PAD_${metal_list1} = NET AREA RATIO NAA_PAD power_pad_TXT_${metal_list1} > 0
  SETLAYER PAA_POWER_PAD_${metal_list1} = NET AREA RATIO PAA_PAD power_pad_TXT_${metal_list1} > 0 
  lappend list1 NAA_POWER_PAD_${metal_list1}
  lappend list2 PAA_POWER_PAD_${metal_list1}
}
SETLAYER NAA_POWER_PAD_all_1 = COPY NAA_POWER_PAD_M1
SETLAYER PAA_POWER_PAD_all_1 = COPY PAA_POWER_PAD_M1
for { set i 1 } { $i < [ llength $list1 ] } { incr i } {
SETLAYER NAA_POWER_PAD_all_[ expr $i + 1 ] = NAA_POWER_PAD_all_$i OR [ lindex $list1 $i ]
}
for { set i 1 } { $i < [ llength $list2 ] } { incr i } {
SETLAYER PAA_POWER_PAD_all_[ expr $i + 1 ] = PAA_POWER_PAD_all_$i OR [ lindex $list2 $i ]
}

SETLAYER NAA_IO_PAD = NAA_PAD NOT INTERACT NAA_POWER_PAD_all_${i}
SETLAYER PAA_IO_PAD = PAA_PAD NOT INTERACT PAA_POWER_PAD_all_${i}
SETLAYER NMOS_IO_PAD = NMOS INTERACT NAA_IO_PAD 
SETLAYER PMOS_IO_PAD = PMOS INTERACT PAA_IO_PAD

VERBATIM {
#ENDIF
}

SETLAYER PAA = AA AND SP
SETLAYER NAA = AA AND SN

SETLAYER PMOS1_real = PAA ENCLOSE GATE
SETLAYER NMOS1_real = NAA ENCLOSE GATE


SETLAYER NGUARDRING = (HOLES NTAP INNER) ENCLOSE GATE
SETLAYER PGUARDHOLE_2 = (HOLES PTAP) ENCLOSE NGUARDRING


SETLAYER PGUARDRING = (HOLES PTAP INNER) ENCLOSE GATE
SETLAYER NGUARDHOLE_2 = (HOLES NTAP) ENCLOSE PGUARDRING


SETLAYER GATEHV = GATE AND ESD5V 
SETLAYER NGATEHV = NGATE AND ESD5V
SETLAYER PGATEHV = PGATE AND ESD5V
SETLAYER GATEIO = GATE NOT DG
SETLAYER GATEMV = GATE AND DG                          //1.8V or 3.3V

RULECHECK LU_1_G {
@ Guard ring should be used to surround AA injector or a group of AA injectors which are connected to an I/O pad.
@ N+ injector must be surrounded by a P+ guard-ring.
@ P+ injector must be surrounded by a N+ guard-ring.
@ NW/PW pickups rings can be used as guard rings. 
@ DRC check the nearest guard-ring which surrounds AA injector or a group of AA injector.
  OUTLAYER ((NAA_IO_PAD INTERACT GT) NOT PGUARDRING) NOT (MARKS OR LUWMK1)
#  OUTLAYER ((NAA_IO_PAD INTERACT GT) NOT NGUARDHOLE_2) NOT (MARKS OR LUWMK1)
  
  OUTLAYER ((PAA_IO_PAD INTERACT GT) NOT NGUARDRING) NOT (MARKS OR LUWMK1)
#  OUTLAYER ((PAA_IO_PAD INTERACT GT) NOT PGUARDHOLE_2) NOT (MARKS OR LUWMK1)
}

RULECHECK LU_2_G {
@ Minimum guard-ring width	>=	0.42 um
 SETLAYER X = SIZE (((HOLES NTAP) NOT INTERACT LUWMK1) ENCLOSE ((PAA_IO_PAD OR NAA_IO_PAD) INTERACT GT)) BY 0.42 
 SETLAYER Y = SIZE (((HOLES PTAP) NOT INTERACT LUWMK1) ENCLOSE ((NAA_IO_PAD OR PAA_IO_PAD) INTERACT GT)) BY 0.42
 
 OUTLAYER (X NOT ((HOLES NTAP) OR (DONUT NTAP))) NOT INSIDE MARKS
 OUTLAYER (Y NOT ((HOLES PTAP) OR (DONUT PTAP))) NOT INSIDE MARKS
}

VERBATIM { 
#IFDEF LU_3_CHECK FAST
} 
RULECHECK LU_3_3a_G {
@ LU.3a-LU.3c define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad (7.3.8 Fig.1)
@ LU.3a For 1.8V N/PMOS connected to an I/O pad, Spacing between NMOS and PMOS	>=	5	um
 SETLAYER  X = (NMOS_IO_PAD ENCLOSE GATEIO) NOT (MARKS OR LUWMK1)
 SETLAYER  Y = (PMOS_IO_PAD ENCLOSE GATEIO) NOT (MARKS OR LUWMK1)
 SETLAYER  M = (NMOS ENCLOSE GATEIO) NOT (MARKS OR LUWMK1)
 SETLAYER  N = (PMOS ENCLOSE GATEIO) NOT (MARKS OR LUWMK1)
 SETLAYER  Z1 = SIZE X BY 2.589 BEVEL 3   
 SETLAYER  Z2 = SIZE N BY 2.589 BEVEL 3
 OUTLAYER  Z1 AND Z2     
 SETLAYER  Z3 = SIZE M BY 2.589 BEVEL 3
 SETLAYER  Z4 = SIZE Y BY 2.589 BEVEL 3
 OUTLAYER  Z3 AND Z4
}

		
RULECHECK LU_3_3b_G {
@ LU.3a-LU.3c define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad (7.3.8 Fig.1)
@ LU.3b For 3.3V N/PMOS connected to an I/O pad, 
@ Spacing between 3.3V NMOS and 3.3V/1.8V PMOS and Spacing between 3.3V PMOS and 3.3V/1.8V NMOS	 >=	8um.

 SETLAYER X = NMOS_IO_PAD ENCLOSE GATEMV
 SETLAYER Y = PMOS_IO_PAD ENCLOSE GATEMV
 SETLAYER M = NMOS ENCLOSE (GATEIO OR GATEMV)
 SETLAYER N = PMOS ENCLOSE (GATEIO OR GATEMV)
 #OUTLAYER (EXT M Y < 2.3 ABUT<90 SINGULAR REGION) NOT (MARKS OR LUWMK1)
 #OUTLAYER (EXT X  N < 2.3 ABUT<90 SINGULAR REGION) NOT (MARKS OR LUWMK1)
  SETLAYER Z1 = SIZE X BY 4.142 BEVEL 3
  SETLAYER Z2 = SIZE N BY 4.142 BEVEL 3
  OUTLAYER (Z1 AND Z2) NOT (MARKS OR LUWMK1)
  SETLAYER Z3 = SIZE M BY 4.142 BEVEL 3
  SETLAYER Z4 = SIZE Y BY 4.142 BEVEL 3
  OUTLAYER (Z3 AND Z4) NOT (MARKS OR LUWMK1)
}

RULECHECK LU_3_3c_G {
@ LU.3a-LU.3c define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad (7.3.8 Fig.1)
@ LU.3c For 5V tolerant N/PMOS (covered by ESD5V mark layer) connected to an I/O pad,
@ Spacing between 5V NMOS and 5V/1.8V PMOS and Spacing between 5V PMOS and 5V/1.8V NMOS	 >=	15um.
 SETLAYER X = NMOS_IO_PAD ENCLOSE GATEHV
 SETLAYER Y = PMOS_IO_PAD ENCLOSE GATEHV
 SETLAYER M = NMOS ENCLOSE (GATEIO OR GATEHV)
 SETLAYER N = PMOS ENCLOSE (GATEIO OR GATEHV)
 #OUTLAYER (EXT M Y < 3.2 ABUT<90 SINGULAR REGION) NOT (MARKS OR LUWMK1)
 #OUTLAYER (EXT X N < 3.2 ABUT<90 SINGULAR REGION) NOT (MARKS OR LUWMK1)
 SETLAYER Z1 = SIZE X BY 7.765 BEVEL 3
 SETLAYER Z2 = SIZE N BY 7.765 BEVEL 3
 OUTLAYER (Z1 AND Z2) NOT (MARKS OR LUWMK1)
 SETLAYER Z3 = SIZE M BY 7.765 BEVEL 3
 SETLAYER Z4 = SIZE Y BY 7.765 BEVEL 3
 OUTLAYER (Z3 AND Z4) NOT (MARKS OR LUWMK1)
}
VERBATIM {
#ENDIF 
#IFDEF LU_3_CHECK ACCURATE 
}
RULECHECK LU_3_3a_G {
@ LU.3a-LU.3c define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad (7.3.8 Fig.1)
@ LU.3a For 1.8V N/PMOS connected to an I/O pad, Spacing between NMOS and PMOS	>=	5	um

 SETLAYER X = NMOS_IO_PAD ENCLOSE GATEIO
 SETLAYER Y = PMOS_IO_PAD ENCLOSE GATEIO
 SETLAYER M = NMOS ENCLOSE GATEIO
 SETLAYER N = PMOS ENCLOSE GATEIO
 OUTLAYER (EXT X N < 5 ABUT<90 SINGULAR REGION) NOT (MARKS OR LUWMK1)
 OUTLAYER (EXT M Y < 5 ABUT<90 SINGULAR REGION) NOT (MARKS OR LUWMK1)
}

RULECHECK LU_3_3b_G {
@ LU.3a-LU.3c define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad (7.3.8 Fig.1)
@ LU.3b For 3.3V N/PMOS connected to an I/O pad, 
@ Spacing between 3.3V NMOS and 3.3V/1.8V PMOS and Spacing between 3.3V PMOS and 3.3V/1.8V NMOS	 >=	8um.
 SETLAYER X = NMOS_IO_PAD ENCLOSE GATEMV
 SETLAYER Y = PMOS_IO_PAD ENCLOSE GATEMV
 SETLAYER M = NMOS ENCLOSE (GATEIO OR GATEMV)
 SETLAYER N = PMOS ENCLOSE (GATEIO OR GATEMV)
 OUTLAYER (EXT M Y < 8 ABUT<90 SINGULAR REGION) NOT (MARKS OR LUWMK1)
 OUTLAYER (EXT X N < 8 ABUT<90 SINGULAR REGION) NOT (MARKS OR LUWMK1)
}

RULECHECK LU_3_3c_G {
@ LU.3a-LU.3c define minimum space (S1) between NMOS and PMOS with either one of NMOS or PMOS AA connected to I/O pad (7.3.8 Fig.1)
@ LU.3c For 5V tolerant N/PMOS (covered by ESD5V mark layer) connected to an I/O pad,
@ Spacing between 5V NMOS and 5V/1.8V PMOS and Spacing between 5V PMOS and 5V/1.8V NMOS	 >=	15um.
 SETLAYER X = NMOS_IO_PAD ENCLOSE GATEHV
 SETLAYER Y = PMOS_IO_PAD ENCLOSE GATEHV
 SETLAYER M = NMOS ENCLOSE (GATEIO OR GATEHV)
 SETLAYER N = PMOS ENCLOSE (GATEIO OR GATEHV)
 OUTLAYER (EXT M Y < 15 ABUT<90 SINGULAR REGION) NOT (MARKS OR LUWMK1)
 OUTLAYER (EXT X N < 15 ABUT<90 SINGULAR REGION) NOT (MARKS OR LUWMK1)
}
VERBATIM {
#ENDIF 
}
RULECHECK LU_4_NTAP_G {
@ Maximum space (S2) from any point within the Source/Drain region to the nearest pickup AA region inside the same well for I/O and internal circuits. (7.3.8 Fig.2)
@ For native device, DRC check the pickup AA inside the PSUB butted PW area, and PW is still treated as connection by substrate even one NW ring inserted.	<=	35	um

 SETLAYER A = INT NTAP < 0.005 ABUT INTERSECTING ONLY REGION
 SETLAYER B = (NTAP INTERACT A) NOT A
 SETLAYER C = INT B < 0.001 ABUT INTERSECTING ONLY REGION
 SETLAYER D = (B INTERACT C) NOT C
#SETLAYER NW_MINUS_NTAP = SIZE D BY 35 INSIDE OF NW STEP 0.38
#SETLAYER X = PMOS1 AND NW
 SETLAYER NW_MINUS_NTAP_0 = SIZE D BY 15 INSIDE OF NW STEP 0.38 TRUNCATE 0.1
 SETLAYER MAYBE_BAD_b = NW NOT NW_MINUS_NTAP_0
 SETLAYER NW_FILTER = NW INTERACT MAYBE_BAD_b
 SETLAYER NW_MINUS_NTAP_1 = NW_MINUS_NTAP_0 AND NW_FILTER
 SETLAYER NW_MINUS_NTAP = SIZE NW_MINUS_NTAP_1 BY 20 INSIDE OF NW_FILTER STEP 0.38 TRUNCATE 0.1
 SETLAYER X = PMOS1_real AND NW_FILTER
 OUTLAYER (OUTSIDE EDGE X NW_MINUS_NTAP) NOT INSIDE EDGE MARKS


}

RULECHECK LU_4_PTAP_G {
@ Maximum space (S2) from any point within the Source/Drain region to the nearest pickup AA region inside the same well for I/O and internal circuits. (7.3.8 Fig.2)
@ For native device, DRC check the pickup AA inside the PSUB butted PW area, and PW is still treated as connection by substrate even one NW ring inserted.	<=	35	um
    SETLAYER PW_MINUS_PTAP_0 = SIZE PTAP BY 5 INSIDE OF PW STEP 0.38 BEVEL 4
    SETLAYER MAYBE_BAD_b = PW NOT PW_MINUS_PTAP_0
    SETLAYER PW_FILTER = PW INTERACT MAYBE_BAD_b
    SETLAYER PW_MINUS_PTAP_1 = PW_MINUS_PTAP_0 AND PW_FILTER
    SETLAYER PW_MINUS_PTAP = SIZE PW_MINUS_PTAP_1 BY 30 INSIDE OF PW_FILTER STEP 0.38 BEVEL 4
    SETLAYER X = NMOS1 AND PW_FILTER
    OUTLAYER (OUTSIDE EDGE X PW_MINUS_PTAP) NOT INSIDE EDGE MARKS
    
	SETLAYER SIZE_REGION = OR PW PSUB NW
    SETLAYER SIZE_PTAP_NOT_DNW = PTAP NOT (DNW NOT INTERACT PSUB)
    SETLAYER PW_SIZE_a = SIZE SIZE_PTAP_NOT_DNW BY 5 INSIDE OF SIZE_REGION STEP 0.38 BEVEL 4
    SETLAYER MAYBE_BAD_PSUB_a = SIZE_REGION NOT PW_SIZE_a
    SETLAYER PW_FILTER_PSUB_a = SIZE_REGION INTERACT MAYBE_BAD_PSUB_a
    SETLAYER PW_MINUS_PTAP_PSUB_a = PW_SIZE_a AND PW_FILTER_PSUB_a
    SETLAYER PW_SIZE_1 = SIZE PW_MINUS_PTAP_PSUB_a BY 30 INSIDE OF PW_FILTER_PSUB_a STEP 0.38 BEVEL 4
    SETLAYER NMOS_PSUB_a = (NMOS1 AND PSUB) NOT INTERACT DNW
    OUTLAYER (OUTSIDE EDGE NMOS_PSUB_a PW_SIZE_1) NOT INSIDE EDGE MARKS
    
	SETLAYER SIZE_PTAP_AND_DNW = (PTAP AND (PW INTERACT PSUB)) INTERACT DNW
    SETLAYER PW_SIZE_b = SIZE SIZE_PTAP_AND_DNW BY 5 INSIDE OF SIZE_REGION STEP 0.38 BEVEL 4
    SETLAYER MAYBE_BAD_PSUB_b = SIZE_REGION NOT PW_SIZE_b
    SETLAYER PW_FILTER_PSUB_b = SIZE_REGION INTERACT MAYBE_BAD_PSUB_b
    SETLAYER PW_MINUS_PTAP_PSUB_b = PW_SIZE_b AND PW_FILTER_PSUB_b
    SETLAYER PW_SIZE_2 = SIZE PW_MINUS_PTAP_PSUB_b BY 30 INSIDE OF PW_FILTER_PSUB_b STEP 0.38 BEVEL 4
    SETLAYER NMOS_PSUB_b = (NMOS1 AND PSUB) INTERACT DNW
    OUTLAYER (OUTSIDE EDGE NMOS_PSUB_b PW_SIZE_2) NOT INSIDE EDGE MARKS
}

RULECHECK LU_7_G {
@ Double guard ring should be used to surround 3.3V N/PMOS connected to I/O pad.
@ Double guard ring definition:
@ For NMOS, double guard ring includes P+ pickup (tied to Vss) and N+ in NW (tied to Vdd).
@ For PMOS, double guard ring includes N+ pickup (tied to Vdd) and P+ in PW (tied to Vss)
  OUTLAYER ((NMOS_IO_PAD ENCLOSE GATEMV) NOT PGUARDRING) NOT (MARKS OR LUWMK1)
  OUTLAYER ((NMOS_IO_PAD ENCLOSE GATEMV) NOT NGUARDHOLE_2) NOT (MARKS OR LUWMK1)
  
  OUTLAYER ((PMOS_IO_PAD ENCLOSE GATEMV) NOT NGUARDRING) NOT (MARKS OR LUWMK1)
  OUTLAYER ((PMOS_IO_PAD ENCLOSE GATEMV) NOT PGUARDHOLE_2) NOT (MARKS OR LUWMK1)
}

VERBATIM {
#ENDIF
}
