VERBATIM {
//*************************************
//     DIRECTIVE SECTION  
//*************************************

LAYOUT PRIMARY "*"
LAYOUT PATH "*.gds"
LAYOUT SYSTEM GDSII

DRC RESULTS DATABASE "drc_CAL.OUT" ASCII
DRC SUMMARY REPORT "drc_CAL.SUM"

PRECISION  1000
RESOLUTION  1	     

FLAG ACUTE YES
FLAG NONSIMPLE YES
//FLAG OFFGRID YES
FLAG SKEW YES

/*skew_edge_check {
@ Skew edge check
  DRAWN SKEW 
}*/

DGR_3 {
@ Only shapes of geometry that are orthogonal or 45-degree angle are allowed, excluding Inductor region and 3.3V SRAM.
	X = DFM COPY (DRAWN SKEW) EDGE
    ((X NOT INSIDE EDGE INDMY) NOT INSIDE EDGE 33SRAM) NOT INSIDE EDGE MARKS
}
// Does not check layers that do not appear in other rule

TEXT DEPTH ALL  
//"PRIMARY" is default only select topcell, if you want to select throughout the hierarchy, you can use "ALL" 
LVS POWER NAME "?VDD?" "?VCC?"


