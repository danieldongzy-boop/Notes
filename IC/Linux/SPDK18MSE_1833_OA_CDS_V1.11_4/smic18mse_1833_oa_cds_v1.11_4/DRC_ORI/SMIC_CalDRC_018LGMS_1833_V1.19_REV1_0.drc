AAO = AAi NOT EXCLU 
GTO = GTi NOT EXCLU
DGO = DGi NOT EXCLU
GT0 = GTi NOT (SAB OR (RESP1 OR HRPDMY))

AA_all = AA OR AADUM
GT_all = GT OR GTDUM
AA_all_O = AAO OR AADUM
GT_all_O = GTO OR GTDUM
                
NW = NWi NOT EXCLU
DG = DGi NOT EXCLU
SN = SNi NOT EXCLU
SP = SPi NOT EXCLU
NLL = NLLi NOT EXCLU
NLH = NLHi NOT EXCLU
PLH = PLHi NOT EXCLU
PLL = PLLi NOT EXCLU
SAB = SABi NOT EXCLU
CTO = CTi NOT EXCLU

//for connectivity
M10 = M1i NOT M1SLOTi

//for DRC check
M1O = (COPY M10) NOT EXCLU

//for metal width&space check
M1_all = M1 OR M1DUM

//for density rule check
GTi_all = GTi OR GTDUMi
M1i_all = M10 OR M1DUMi

M1SLOT = M1SLOTi NOT EXCLU

V1O = V1i NOT EXCLU
AADUM = AADUMi NOT EXCLU
GTDUM = GTDUMi NOT EXCLU
M1DUM = M1DUMi NOT EXCLU
}

for { set j 2 } { 0 <= [expr $metal_counts -$j] } { incr j } {
SETLAYER M${j}0 = M${j}i NOT M${j}SLOTi
SETLAYER M${j} = (COPY M${j}0) NOT EXCLU
SETLAYER M${j}_all = M${j} OR M${j}DUM

SETLAYER M${j}i_all = M${j}0 OR M${j}DUMi
SETLAYER M${j}DUM = M${j}DUMi NOT EXCLU
SETLAYER M${j}SLOT = M${j}SLOTi NOT EXCLU
}


for { set j 2 } { 1 <= [expr $metal_counts -$j] } { incr j } {
SETLAYER V${j} = V${j}i NOT EXCLU
}

for { set j 1 } { 0 <= [expr $metal_counts - $j] } { incr j } {
SETLAYER M${j}RES = M${j} AND M${j}R
}


VERBATIM {
DNW = DNWi NOT EXCLU
MVN = MVNi NOT EXCLU
MVP = MVPi NOT EXCLU
HRP = HRPi NOT EXCLU

PA = PAi NOT EXCLU
PI = PIi NOT EXCLU
MIM = MIMi NOT EXCLU
PSUB = PSUBi NOT EXCLU
RESP1 = RESP1i NOT EXCLU
RESAA = RESAAi NOT EXCLU


//*******************************************       
//    LAYER DERIVATIONS AND OPERATIONS
//*******************************************       

AA = NOT AAO OPCBA
GT = NOT GTO OPCBP
CT = NOT CTO OPCBM
M1 = NOT M1O OPCBM
V1 = NOT V1O OPCBM


DRC:1 = EXTENT
BULK = SIZE DRC:1 BY 1.0
//PW = (BULK NOT NWi) NOT PSUB
PW = (BULK NOT NWi) NOT PSUBi
PW0 = BULK NOT NWi

//=====================
//   For Connectivity
//=====================

//new add for SRAM except EXCLU
NACTO = SN AND AAO
PACTO = SP AND AAO
PTAPO = PACTO NOT NW
NTAPO = NACTO AND NW
TAPO = PTAPO OR NTAPO
PGATEO = PACTO AND GTO
NGATEO = NACTO AND GTO
GATEO = PGATEO OR NGATEO
MOSPO = PACTO AND NW
MOSNO = NACTO NOT NW
PSDO = MOSPO NOT GTO
NSDO = MOSNO NOT GTO
SDO = PSDO OR NSDO





PACTi = SPi AND AAi
NACTi = SNi AND AAi
ACTi = PACTi OR NACTi


PTAPi = PACTi NOT NWi
NTAPi = NACTi AND NWi
TAPi = PTAPi OR NTAPi

PGCTi = SPi AND GTi
NGCTi = SNi AND GTi 
PGATEi = PACTi AND GTi
NGATEi = NACTi AND GTi
GATEii = PGATEi OR NGATEi

MOSPi = PACTi AND NWi
MOSNi = NACTi NOT NWi
PSDi = MOSPi NOT GTi
NSDi = MOSNi NOT GTi
SDi = PSDi OR NSDi


PSD_NOT_SABi = PSDi NOT SABi
NSD_NOT_SABi = NSDi NOT SABi

PACT = SP AND AA
NACT = SN AND AA
ACT = PACT OR NACT
MOSP = PACT AND NW
PTAP = PACT NOT NW
MOSN = NACT NOT NW
NTAP = NACT AND NW
TAP = PTAP OR NTAP
MOSAA = MOSP OR MOSN

PGCT = SP AND GT
NGCT = SN AND GT
GCT = PGCT OR NGCT

PGATE = MOSP AND GT
NGATE = MOSN AND GT
GATE = AA AND GT
GATE_O = AAO AND GTO

//PSD = (MOSP NOT PGATE) TOUCH PGATE
//NSD = (MOSN NOT NGATE) TOUCH NGATE
PSD = (MOSP NOT GT) TOUCH PGATE
NSD = (MOSN NOT GT) TOUCH NGATE

SD = PSD OR NSD

NGATE_CAP = (NACT AND GT) AND NW
MOSN_CAP = NACT INTERACT NGATE_CAP
GT_MOSCAP = GT INTERACT NGATE_CAP
NSD_CAP = (MOSN_CAP NOT GT_MOSCAP) TOUCH NGATE_CAP

//New add for SRGT_13
NGATE_CAPO = (NACTO AND GTO) AND NW
MOSN_CAPO = NACTO INTERACT NGATE_CAPO
GT_MOSCAPO = GTO INTERACT NGATE_CAPO
NSD_CAPO = (MOSN_CAPO NOT GT_MOSCAPO) TOUCH NGATE_CAPO


AA_GATE_EDGE = AA INSIDE EDGE GT

//New add for SRAA
AA_GATE_EDGEO = AAO INSIDE EDGE GTO

AA_OUT_EDGE  = AA NOT INSIDE EDGE GT
GT_NACT_EDGE = GT INSIDE EDGE NACT
GT_PACT_EDGE = GT INSIDE EDGE PACT
GT_AA_EDGE = GT INSIDE EDGE AA
GT_AA_EDGE_O = GTO INSIDE EDGE AAO

// This is for NLL_8_12 and NLH_8_12 SN_7_17
EX_GT_NACT_EDGE = EXPAND EDGE GT_NACT_EDGE INSIDE BY 0.32 OUTSIDE BY 0.32 CORNER FILL
NGATE_NACT_EDGE = NGATE COIN EDGE NACT
EX_NGATE_NACT_EDGE = EXPAND EDGE NGATE_NACT_EDGE OUTSIDE BY 0.35 EXTEND BY 0.32
EX_NGATE = EX_GT_NACT_EDGE OR EX_NGATE_NACT_EDGE

// This is for PLL_8_12 and PLH_8_12 SP_7_17
EX_GT_PACT_EDGE = EXPAND EDGE GT_PACT_EDGE INSIDE BY 0.32 OUTSIDE BY 0.32 CORNER FILL
PGATE_PACT_EDGE = PGATE COIN EDGE PACT
EX_PGATE_PACT_EDGE = EXPAND EDGE PGATE_PACT_EDGE OUTSIDE BY 0.35 EXTEND BY 0.32
EX_PGATE = EX_GT_PACT_EDGE OR EX_PGATE_PACT_EDGE

NTAPBUT = NTAP TOUCH PACT
PTAPBUT = PTAP TOUCH NACT
NTAPBUT_EDGE = NTAP COIN EDGE PACT
NTAPNOBUT_EDGE = NTAP NOT COIN EDGE PACT
PTAPBUT_EDGE = PTAP COIN EDGE NACT
PTAPNOBUT_EDGE = PTAP NOT COIN EDGE NACT

HVAA = AA AND DG
LVAA = AA NOT DG
HPGATE = PGATE AND DG
HNGATE = NGATE AND DG
HGATE = GATE AND DG 
LGATE = GATE NOT DG

NLLAA = AA AND NLL
NLHAA = AA AND NLH
PLLAA = AA AND PLL
PLHAA = AA AND PLH

NR = (NW INSIDE AA) INTERACT RESNW
AAR = AA INTERACT NR
SNR = SN INTERACT NR

GT_HRP = GT INTERACT HRP
HR_GT = GT_HRP AND HRPDMY
SAB_GT = GT_HRP AND SAB

GTR = (GT NOT INTERACT HRP) INTERACT RESP1
RESP3T_HRP = RESP3T INTERACT HRP
GTR_3T = GT_HRP INTERACT RESP3T_HRP
GTR_N3T = GT_HRP NOT GTR_3T

NWDEV = NW NOT NR 
NW_USIZE = SIZE NW BY -0.43
PW_USIZE = SIZE PW BY -0.43

ACT_CT = CT AND ACT

GCT_CT = CT AND GCT
INTERGT = GT NOT GATE
INTERCT = CT AND INTERGT

//New add for SRCT_?
INTERGTO = GTO NOT GATEii
INTERCTO = CTO AND INTERGTO
ACT_CTO = CTO AND ACTi




PSUB_AA = AA AND PSUB
PSUB_GT = GT AND PSUB
PSUB_GATE = GATE AND PSUB
PSUB_GATE_WID = PSUB_GATE INSIDE EDGE AA
PSUB_HGATE = HGATE AND PSUB
PSUB_HGATE_WID = PSUB_HGATE INSIDE EDGE AA
NOMI_AA = AA NOT PSUB_AA

MVN_AA = AA AND MVN
MVN_GT = GT AND MVN
MVN_GATE = GATE AND MVN
MVN_GATE_WID = MVN_GATE INSIDE EDGE AA
MVN_LGATE = LGATE AND MVN
MVN_LGATE_WID = MVN_LGATE INSIDE EDGE AA
MVN_HGATE = HGATE AND MVN
MVN_HGATE_WID = MVN_HGATE INSIDE EDGE AA

MVP_AA = AA AND MVP
MVP_GT = GT AND MVP
MVP_GATE = GATE AND MVP
MVP_GATE_WID = MVP_GATE INSIDE EDGE AA
MVP_LGATE = LGATE AND MVP
MVP_LGATE_WID = MVP_LGATE INSIDE EDGE AA
MVP_HGATE = HGATE AND MVP
MVP_HGATE_WID = MVP_HGATE INSIDE EDGE AA

RESP1R = (RESP1 INTERACT SAB) INTERACT GT
RESP1R_STI = (RESP1 NOT INTERACT SAB) INTERACT GT

RES1 = RESP1 OR RESAA
POLY = GT OUTSIDE RESP1
GATEI = POLY AND AA
NMOS = NACT ENCLOSE GATEI
PMOS = PACT ENCLOSE GATEI

MT = MTi NOT EXCLU            
TV = TVi NOT EXCLU            
TVi_NOT_MIMi = TVi NOT MIMi
TVi_AND_MIMi = TVi AND MIMi
TVi_NOT_MIM = TVi_NOT_MIMi NOT EXCLU  
TVi_AND_MIM = TVi_AND_MIMi NOT EXCLU  

CONNECT M20 M10 BY V1i
CONNECT M10 GT0 NTAPi PTAPi PSD_NOT_SABi NSD_NOT_SABi BY CTi
CONNECT NTAPi PSD_NOT_SABi
CONNECT PTAPi NSD_NOT_SABi
CONNECT PTAPi PW
CONNECT NTAPi NWi
CONNECT NWi DNWi
CONNECT NWi NW


LAYER  M1_TEXT   1411 1412
LAYER  MAP  61  TEXTTYPE==0   1411
LAYER  MAP 141  TEXTTYPE==0   1412

LAYER  M2_TEXT   1421 1422
LAYER  MAP  62  TEXTTYPE==0   1421
LAYER  MAP 142  TEXTTYPE==0   1422

LAYER  M3_TEXT   1431 1432
LAYER  MAP  63  TEXTTYPE==0   1431
LAYER  MAP 143  TEXTTYPE==0   1432

LAYER  M4_TEXT   1441 1442
LAYER  MAP  64  TEXTTYPE==0   1441
LAYER  MAP 144  TEXTTYPE==0   1442

LAYER  M5_TEXT   1451 1452
LAYER  MAP  65  TEXTTYPE==0   1451
LAYER  MAP 145  TEXTTYPE==0   1452

LAYER  M6_TEXT   1461 1462
LAYER  MAP  66  TEXTTYPE==0   1461
LAYER  MAP 146  TEXTTYPE==0   1462

//TEXT  LAYER   M1_TEXT M2_TEXT M3_TEXT M4_TEXT M5_TEXT M6_TEXT
}


set metal_list " "
set via_list " "
for { set j 1 } { 0 <= [expr $metal_counts -$j] } { incr j } {
  lappend metal_list M$j
}

for { set j 1 } { 1 <= [expr $metal_counts -$j] } { incr j } {
  lappend via_list V$j
}

if { 6 == $metal_counts } {
  ATTACH   M1_TEXT   M10
  ATTACH   M2_TEXT   M20
  ATTACH   M3_TEXT   M30
  ATTACH   M4_TEXT   M40
  ATTACH   M5_TEXT   M50
  ATTACH   M6_TEXT   MT0

  SETLAYER MT0 = COPY M60
  SETLAYER MTi = COPY MT0
  SETLAYER TVi = COPY V5i
  SETLAYER MTSLOT = COPY M6SLOT
  SETLAYER MTR = COPY M6R
  SETLAYER Vn = ((V1 OR V2) OR V3) OR V4 
  SETLAYER Mn = ((M1 OR M2) OR M3) OR M4

  CONNECT MT0 M50 BY TVi_NOT_MIMi
  CONNECT MT0 MIMi BY TVi_AND_MIMi
  CONNECT M50 M40 BY V4i
  CONNECT M40 M30 BY V3i
  CONNECT M30 M20 BY V2i
  #LABEL ORDER MT0 M50 M40 M30 M20 M10 NTAPi PTAPi NSD_NOT_SABi PSD_NOT_SABi GT0 NWi
} elseif { 5 == $metal_counts } {
  ATTACH   M1_TEXT   M10
  ATTACH   M2_TEXT   M20
  ATTACH   M3_TEXT   M30
  ATTACH   M4_TEXT   M40
  ATTACH   M5_TEXT   MT0

  SETLAYER MT0 = COPY M50
  SETLAYER MTi = COPY MT0
  SETLAYER TVi = COPY V4i
  SETLAYER MTSLOT = COPY M5SLOT
  SETLAYER MTR = COPY M5R
  SETLAYER Vn = (V1 OR V2) OR V3 
  SETLAYER Mn = (M1 OR M2) OR M3

  CONNECT MT0 M40 BY TVi_NOT_MIMi
  CONNECT MT0 MIMi BY TVi_AND_MIMi
  CONNECT M40 M30 BY V3i
  CONNECT M30 M20 BY V2i
  #LABEL ORDER MT0 M40 M30 M20 M10 NTAPi PTAPi NSD_NOT_SABi PSD_NOT_SABi GT0 NWi
} elseif { 4 == $metal_counts } {
  ATTACH   M1_TEXT   M10
  ATTACH   M2_TEXT   M20
  ATTACH   M3_TEXT   M30
  ATTACH   M4_TEXT   MT0

  SETLAYER MT0 = COPY M40
  SETLAYER MTi = COPY MT0
  SETLAYER TVi = COPY V3i
  SETLAYER MTSLOT = COPY M4SLOT
  SETLAYER MTR = COPY M4R
  SETLAYER Vn = V1 OR V2
  SETLAYER Mn = M1 OR M2

  CONNECT MT0 M30 BY TVi_NOT_MIMi
  CONNECT MT0 MIMi BY TVi_AND_MIMi
  CONNECT M30 M20 BY V2i
  #LABEL ORDER MT0 M30 M20 M10 NTAPi PTAPi NSD_NOT_SABi PSD_NOT_SABi GT0 NWi
} elseif { 3 == $metal_counts } {
  ATTACH   M1_TEXT   M10
  ATTACH   M2_TEXT   M20
  ATTACH   M3_TEXT   MT0

  SETLAYER MT0 = COPY M30
  SETLAYER MTi = COPY MT0
  SETLAYER TVi = COPY V2i
  SETLAYER MTSLOT = COPY M3SLOT
  SETLAYER MTR = COPY M3R
  SETLAYER Vn = COPY V1
  SETLAYER Mn = COPY M1

  CONNECT MT0 M30

#  CONNECT MT0 M30 BY TVi_NOT_MIMi
#  CONNECT MT0 MIMi BY TVi_AND_MIMi
  CONNECT M30 M20 BY V2i
  #LABEL ORDER MT0 M20 M10 NTAPi PTAPi NSD_NOT_SABi PSD_NOT_SABi GT0 NWi
}

#//****************************       
#//    DEFINITION FOR MIM
#//****************************
SETLAYER MT_1_CAPMIM = (SIZE [lindex $metal_list end-1] BY 2 UNDEROVER) INTERACT CAP_MIM
SETLAYER MT_1_DMYMIM = [lindex $metal_list end-1] INTERACT DMY_MIM

SETLAYER TV_MIM = [lindex $via_list end] AND CAP_MIM
SETLAYER MT_1_MIM = (SIZE [lindex $metal_list end-1] BY 2 UNDEROVER) INTERACT MIM

SETLAYER TV_CAPMT_1 = ([lindex $via_list end] AND MT_1_CAPMIM) NOT TV_MIM
 
SETLAYER TV_MT_1_MIM = ([lindex $via_list end] AND MT_1_MIM) NOT MIM
SETLAYER MT_1_LAYER = COPY [lindex $metal_list end-1]

#//****************************       
#//    DEFINITION FOR SRCK
#//****************************
SETLAYER CTS = CTi AND MARKS
SETLAYER AAS = AAi AND (AAi ENCLOSE CTS)

foreach k $metal_list {
SETLAYER ${k}S = ${k}i AND MARKS
SETLAYER ${k}S_OUTER = HOLES ${k}S
SETLAYER ${k}S_RING = ${k}i AND (${k}S INTERACT ${k}S_OUTER)
SETLAYER ${k}_CORNER = NOT RECTANGLE ${k}S 
}

foreach via_layer $via_list {
SETLAYER ${via_layer}S = ${via_layer}i AND MARKS
}

#//***************************       
#//    DEFINITION FOR FUSE
#//***************************  
SETLAYER MT_1_FUSE = FUSE AND MT_1_LAYER
SETLAYER PIFUSE_RING = (PI INTERACT FUSE) NOT FUSE
SETLAYER CT_FUSE = CT AND (PI INTERACT FUSE)

foreach metal1_layer $metal_list {
SETLAYER ${metal1_layer}FUSE_RING = PIFUSE_RING AND ${metal1_layer}
SETLAYER A${metal1_layer} = HOLES ${metal1_layer}FUSE_RING
SETLAYER B${metal1_layer} = ${metal1_layer}FUSE_RING TOUCH A${metal1_layer}
}

if { 6 == $metal_counts } {
SETLAYER V1FUSE_RING = V1 INSIDE BM1
SETLAYER V2FUSE_RING = V2 INSIDE BM2
SETLAYER V3FUSE_RING = V3 INSIDE BM3
SETLAYER V4FUSE_RING = V4 INSIDE BM4
SETLAYER V5FUSE_RING = V5 INSIDE BM5
SETLAYER V1_FUSE = (PI INTERACT FUSE) AND V1
SETLAYER V2_FUSE = (PI INTERACT FUSE) AND V2
SETLAYER V3_FUSE = (PI INTERACT FUSE) AND V3
SETLAYER V4_FUSE = (PI INTERACT FUSE) AND V4
} elseif { 5 == $metal_counts } {
SETLAYER V1FUSE_RING = V1 INSIDE BM1
SETLAYER V2FUSE_RING = V2 INSIDE BM2
SETLAYER V3FUSE_RING = V3 INSIDE BM3
SETLAYER V4FUSE_RING = V4 INSIDE BM4
SETLAYER V1_FUSE = (PI INTERACT FUSE) AND V1
SETLAYER V2_FUSE = (PI INTERACT FUSE) AND V2
SETLAYER V3_FUSE = (PI INTERACT FUSE) AND V3
} elseif { 4 == $metal_counts } {
SETLAYER V1FUSE_RING = V1 INSIDE BM1
SETLAYER V2FUSE_RING = V2 INSIDE BM2
SETLAYER V3FUSE_RING = V3 INSIDE BM3
SETLAYER V1_FUSE = (PI INTERACT FUSE) AND V1
SETLAYER V2_FUSE = (PI INTERACT FUSE) AND V2
} elseif { 3 == $metal_counts } {
SETLAYER V1FUSE_RING = V1 INSIDE BM1
SETLAYER V2FUSE_RING = V2 INSIDE BM2
SETLAYER V1_FUSE = (PI INTERACT FUSE) AND V1
}

VIRTUAL CONNECT NAME "?VDD?" "?VCC?" "?VSS?" "?GND?"
VIRTUAL CONNECT COLON YES 



#-----------------------------//--* Find Wide Metal *--//----------------------------------------------------------
foreach mn $metal_list {
SETLAYER WIDE_${mn} = ${mn} INTERACT (SIZE ${mn} BY -5)   
#// wide metal

#// begin shrink
SETLAYER WD${mn}_45 = ANGLE WIDE_${mn} >0<90
SETLAYER WD${mn}_90 = NOT ANGLE WIDE_${mn} >0<90

SETLAYER WD${mn}_EXP_45 = EXPAND EDGE WD${mn}_45 INSIDE BY 5*1.414213562
SETLAYER WD${mn}_EXP_90 = EXPAND EDGE WD${mn}_90 INSIDE BY 5 EXTEND BY 5

SETLAYER THIN_${mn}_TMP = WIDE_${mn} NOT (WD${mn}_EXP_45 OR WD${mn}_EXP_90)
SETLAYER THIN_${mn} = SNAP THIN_${mn}_TMP 1            
#// end of shrink

#// begin grow
SETLAYER TN${mn}_45 = ANGLE THIN_${mn} >0<90
SETLAYER TN${mn}_90 = NOT ANGLE THIN_${mn} >0<90

SETLAYER TN${mn}_EXP_45_TMP = EXPAND EDGE TN${mn}_45 OUTSIDE BY 5*1.414213562
SETLAYER TN${mn}_EXP_45 = SNAP TN${mn}_EXP_45_TMP 1
SETLAYER TN${mn}_EXP_90 = EXPAND EDGE TN${mn}_90 OUTSIDE BY 5 EXTEND BY 5

SETLAYER TN${mn}_EXP = TN${mn}_EXP_45 OR TN${mn}_EXP_90

SETLAYER WD${mn}_PRE = TN${mn}_EXP OR THIN_${mn}
SETLAYER WD${mn}_PRE_FILL = EXT WD${mn}_PRE < 5 ABUT>0<90 INTERSECTING ONLY REGION

SETLAYER ${mn}OVER10 = WD${mn}_PRE OR WD${mn}_PRE_FILL    
#// end of grow
}

#-----------------------------//--* Find Wide Metal Dummy*--//----------------------------------------------------------
foreach md $metal_list {
SETLAYER WIDE_${md}DUM = ${md}DUM INTERACT (SIZE ${md}DUM BY -5)   
#// wide metal dummy

#// begin shrink
SETLAYER WD${md}DUM_45 = ANGLE WIDE_${md}DUM >0<90
SETLAYER WD${md}DUM_90 = NOT ANGLE WIDE_${md}DUM >0<90

SETLAYER WD${md}DUM_EXP_45 = EXPAND EDGE WD${md}DUM_45 INSIDE BY 5*1.414213562
SETLAYER WD${md}DUM_EXP_90 = EXPAND EDGE WD${md}DUM_90 INSIDE BY 5 EXTEND BY 5

SETLAYER THIN_${md}DUM_TMP = WIDE_${md}DUM NOT (WD${md}DUM_EXP_45 OR WD${md}DUM_EXP_90)
SETLAYER THIN_${md}DUM = SNAP THIN_${md}DUM_TMP 1            
#// end of shrink

#// begin grow
SETLAYER TN${md}DUM_45 = ANGLE THIN_${md}DUM >0<90
SETLAYER TN${md}DUM_90 = NOT ANGLE THIN_${md}DUM >0<90

SETLAYER TN${md}DUM_EXP_45_TMP = EXPAND EDGE TN${md}DUM_45 OUTSIDE BY 5*1.414213562
SETLAYER TN${md}DUM_EXP_45 = SNAP TN${md}DUM_EXP_45_TMP 1
SETLAYER TN${md}DUM_EXP_90 = EXPAND EDGE TN${md}DUM_90 OUTSIDE BY 5 EXTEND BY 5

SETLAYER TN${md}DUM_EXP = TN${md}DUM_EXP_45 OR TN${md}DUM_EXP_90

SETLAYER WD${md}DUM_PRE = TN${md}DUM_EXP OR THIN_${md}DUM
SETLAYER WD${md}DUM_PRE_FILL = EXT WD${md}DUM_PRE < 5 ABUT>0<90 INTERSECTING ONLY REGION

SETLAYER ${md}DUMOVER10 = WD${md}DUM_PRE OR WD${md}DUM_PRE_FILL    
#// end of grow
}

for { set j 1 } { 0 <= [expr $metal_counts -$j] } { incr j } {
SETLAYER  M${j}_h = ((rectangle (HOLES M${j} INNER EMPTY)) with width < 6) OR ((rectangle M${j}SLOT) with width < 6)
SETLAYER  M${j}_with_h = M${j} OR M${j}_h
}
#---For stack metal check rule--------------------------------------
#---For Mn_10, Mn_10_R----------------------------------------------
#---Update by 20180125

#---For Mn_12-------------------------------
proc Mn_12_check { layer } {
SETLAYER X = $layer WITH WIDTH > 25
SETLAYER Y = LENGTH X > 100
SETLAYER A = X WITH EDGE Y
SETLAYER B = AREA $layer < 1
OUTLAYER EXT A B < 1 ABUT<90 SINGULAR REGION
}

VERBATIM {
//=====================
//  DNW - D DRC
//=====================

GROUP GDNW DNW_?

//HOLE_INNW = HOLES NW
//NW_HOLE = NW TOUCH HOLE_INNW

DNW_1 {
@ DNW must be surrounded by NW
  DNW NOT INSIDE EDGE NW
}
DNW_2 {
@ It is not allowed to use DNW layer as resistor
  AND DNW RESNW
}
/*
DNW_3 {
@ 3.3V PMOS is not allowed in the NW connected to DNW
  ((PACT AND GT) AND DG) AND (NW INTERACT DNW)
}
*/
DNW_4 {
@ Extension of NW beyond DNW is >= 1.50um
//  ENC DNW NW_HOLE < 1.5 ABUT<90
  ENC DNW NW < 1.5 ABUT<90 SINGULAR REGION
}
DNW_5 {
@ Overlap of NW and DNW region is >= 2.00um
//  ENC HOLE_INNW DNW < 2 ABUT<90 SINGULAR REGION
  X = DNW WITH WIDTH > 4
  Y = DNW NOT X
  INT X NW < 2 ABUT<90 SINGULAR REGION
  Y NOT NW
}

LAYER MAP 9990 DATATYPE 1110 4221
LAYER EMPTY22 4221
DNW_EMPTY = EMPTY22 OR DNWi
NW_EMPTY = EMPTY22 OR NWi
CONNECT DNW_EMPTY NW_EMPTY

DNW_6 {
@ Space from DNW to a NW is >= 3.50um
  EXT DNW_EMPTY NW_EMPTY < 3.5 ABUT<90 SINGULAR REGION NOT CONNECTED MEASURE ALL
}
DNW_7 {
@ DNW width is >= 3.00um
  INT DNW < 3 ABUT<90 SINGULAR REGION
}
DNW_8 {
@ Space between two DNW regions is >= 5.00um
  EXT DNW < 5 ABUT<90 SINGULAR REGION
}
DNW_11 {
@ It is not allowed to use NW connect to DNW as resistor
  (NW INTERACT DNW) AND RESNW
}

/*DNW_12 {
@Space between (PW INSIDE DNW) and PW at different nets. >=1.40um
  Z = PW INSIDE DNW
  H = PW AND (PW NOT DNW)

  OUT1 = EXT Z < 1.4 ABUT < 90 REGION NOT CONNECTED
  OUT1 NOT MARKS
  OUT2 = EXT Z PW < 1.4 ABUT < 90 REGION NOT CONNECTED
  OUT2 NOT MARKS
}
*/
//; DNW_9 { PURPOSELY BLANK }
//; DNW_10_NC_R {
//; @ Recommend to keep NW connected to DNW with PW be in reverse bias for lower leakage application }

#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
DNW_12_R {
@ AA straddle on DNW is not allowed.
  (AA CUT DNW) NOT (AA INSIDE DNW)
}
#ENDIF

//=====================
//  NW - Nwell DRC
//=====================

GROUP GNW NW_?

NW_1 {
@ NW width is >= 0.86um
  INT NW < 0.86 ABUT<90 SINGULAR REGION
}
NW_2a {
@ Space between two NW regions with the same net is >= 0.60um
@ Merge if space is less than 0.6m
  EXT NW < 0.6 ABUT<90 SINGULAR REGION CONNECTED
}
}

VERBATIM {
#IFDEF NW_space_check 180 
}
RULECHECK NW_2b {
@ Space between two NW with different net is >= 1.40um
OUTLAYER  EXT NW < 1.4 ABUT<90 SINGULAR REGION NOT CONNECTED
}
VERBATIM {
#ENDIF

#IFDEF NW_space_check 153
#IFDEF 153_shrink_check YES
}

RULECHECK NW_2c {
@ Space between two NW with different net is >= 1.70um
@ (This rule is only used for the design that it will be shrinkage from 0.18um to 0.153um. Designer can waive this rule for
@ 0.18um design only.)
OUTLAYER  EXT NW < 1.7 ABUT<90 SINGULAR REGION NOT CONNECTED
}

VERBATIM {
#ENDIF
#ENDIF	
}

if { 6 == $metal_counts } {
VERBATIM {
NW_3 {
@ Dimension of an NW region not connected to the most positive power supply is >= 2.10um, which net name including VDD or VCC
@ DRC waive check below condition:
@ 1.	Waive check RESNW covered NW resistor region.
@ 2.	Waive check the pickup purpose NW patterns width <2.1um and not interact with GATE.
  NWwoMPV =  NOT NET NWi ?VDD? ?VCC?
  RESULT1 = INT NWwoMPV < 2.1 ABUT<90 SINGULAR REGION

  A1 = M10 WITH TEXT ?VDD? M1_TEXT
  B1 = M10 WITH TEXT ?VCC? M1_TEXT
  A2 = M20 WITH TEXT ?VDD? M2_TEXT
  B2 = M20 WITH TEXT ?VCC? M2_TEXT
  A3 = M30 WITH TEXT ?VDD? M3_TEXT
  B3 = M30 WITH TEXT ?VCC? M3_TEXT
  A4 = M40 WITH TEXT ?VDD? M4_TEXT
  B4 = M40 WITH TEXT ?VCC? M4_TEXT
  A5 = M50 WITH TEXT ?VDD? M5_TEXT
  B5 = M50 WITH TEXT ?VCC? M5_TEXT
  A6 = MT0 WITH TEXT ?VDD? M6_TEXT
  B6 = MT0 WITH TEXT ?VCC? M6_TEXT

  VDD_M1a_1 = (NET AREA RATIO M10 A1 [!!area(M10)*!!area(A1)] > 0) OR (NET AREA RATIO M10 A2 [!!area(M10)*!!area(A2)] > 0)
  VDD_M1a_2 = (NET AREA RATIO M10 A3 [!!area(M10)*!!area(A3)] > 0) OR (NET AREA RATIO M10 A4 [!!area(M10)*!!area(A4)] > 0)
  VDD_M1a_3 = (NET AREA RATIO M10 A5 [!!area(M10)*!!area(A5)] > 0) OR (NET AREA RATIO M10 A6 [!!area(M10)*!!area(A6)] > 0)
  VDD_M1b_1 = (NET AREA RATIO M10 B1 [!!area(M10)*!!area(B1)] > 0) OR (NET AREA RATIO M10 B2 [!!area(M10)*!!area(B2)] > 0)
  VDD_M1b_2 = (NET AREA RATIO M10 B3 [!!area(M10)*!!area(B3)] > 0) OR (NET AREA RATIO M10 B4 [!!area(M10)*!!area(B4)] > 0)
  VDD_M1b_3 = (NET AREA RATIO M10 B5 [!!area(M10)*!!area(B5)] > 0) OR (NET AREA RATIO M10 B6 [!!area(M10)*!!area(B6)] > 0)
  VDD_M1a = (VDD_M1a_1 OR VDD_M1a_2) OR VDD_M1a_3
  VDD_M1b = (VDD_M1b_1 OR VDD_M1b_2) OR VDD_M1b_3

  VDD_M1 = VDD_M1a OR VDD_M1b
  VDD_CT = CTi AND VDD_M1
  VDD_NTAP = NTAPi INTERACT VDD_CT
  VDD_PSD = PSDi INTERACT VDD_CT
  NO_VDD_NW = NWi NOT INTERACT (VDD_NTAP OR VDD_PSD)
  RESULT2 = INT NO_VDD_NW < 2.1 ABUT<90 SINGULAR REGION
  ((RESULT1 AND RESULT2) NOT INTERACT (RESNW OR EXCLU)) INTERACT (AAi AND GTi)
}
}}

if { 5 == $metal_counts } {
VERBATIM {
NW_3 {
@ Dimension of an NW region not connected to the most positive power supply is >= 2.10um, which net name including VDD or VCC
@ DRC waive check below condition:
@ 1.	Waive check RESNW covered NW resistor region.
@ 2.	Waive check the pickup purpose NW patterns width <2.1um and not interact with GATE.

  NWwoMPV =  NOT NET NWi ?VDD? ?VCC?
  RESULT1 = INT NWwoMPV < 2.1 ABUT<90 SINGULAR REGION

  A1 = M10 WITH TEXT ?VDD? M1_TEXT
  B1 = M10 WITH TEXT ?VCC? M1_TEXT
  A2 = M20 WITH TEXT ?VDD? M2_TEXT
  B2 = M20 WITH TEXT ?VCC? M2_TEXT
  A3 = M30 WITH TEXT ?VDD? M3_TEXT
  B3 = M30 WITH TEXT ?VCC? M3_TEXT
  A4 = M40 WITH TEXT ?VDD? M4_TEXT
  B4 = M40 WITH TEXT ?VCC? M4_TEXT
  A5 = MT0 WITH TEXT ?VDD? M5_TEXT
  B5 = MT0 WITH TEXT ?VCC? M5_TEXT

  VDD_M1a_1 = (NET AREA RATIO M10 A1 [!!area(M10)*!!area(A1)] > 0) OR (NET AREA RATIO M10 A2 [!!area(M10)*!!area(A2)] > 0)
  VDD_M1a_2 = (NET AREA RATIO M10 A3 [!!area(M10)*!!area(A3)] > 0) OR (NET AREA RATIO M10 A4 [!!area(M10)*!!area(A4)] > 0)
  VDD_M1a_3 = NET AREA RATIO M10 A5 [!!area(M10)*!!area(A5)] > 0
  VDD_M1b_1 = (NET AREA RATIO M10 B1 [!!area(M10)*!!area(B1)] > 0) OR (NET AREA RATIO M10 B2 [!!area(M10)*!!area(B2)] > 0)
  VDD_M1b_2 = (NET AREA RATIO M10 B3 [!!area(M10)*!!area(B3)] > 0) OR (NET AREA RATIO M10 B4 [!!area(M10)*!!area(B4)] > 0)
  VDD_M1b_3 = NET AREA RATIO M10 B5 [!!area(M10)*!!area(B5)] > 0
  VDD_M1a = (VDD_M1a_1 OR VDD_M1a_2) OR VDD_M1a_3
  VDD_M1b = (VDD_M1b_1 OR VDD_M1b_2) OR VDD_M1b_3

  VDD_M1 = VDD_M1a OR VDD_M1b
  VDD_CT = CTi AND VDD_M1
  VDD_NTAP = NTAPi INTERACT VDD_CT
  VDD_PSD = PSDi INTERACT VDD_CT
  NO_VDD_NW = NWi NOT INTERACT (VDD_NTAP OR VDD_PSD)
  RESULT2 = INT NO_VDD_NW < 2.1 ABUT<90 SINGULAR REGION
  ((RESULT1 AND RESULT2) NOT INTERACT (RESNW OR EXCLU)) INTERACT (AAi AND GTi)
}}}

if { 4 == $metal_counts } {
VERBATIM {
NW_3 {
@ Dimension of an NW region not connected to the most positive power supply is >= 2.10um, which net name including VDD or VCC
@ DRC waive check below condition:
@ 1.	Waive check RESNW covered NW resistor region.
@ 2.	Waive check the pickup purpose NW patterns width <2.1um and not interact with GATE.

  NWwoMPV =  NOT NET NWi ?VDD? ?VCC?
  RESULT1 = INT NWwoMPV < 2.1 ABUT<90 SINGULAR REGION

  A1 = M10 WITH TEXT ?VDD? M1_TEXT
  B1 = M10 WITH TEXT ?VCC? M1_TEXT
  A2 = M20 WITH TEXT ?VDD? M2_TEXT
  B2 = M20 WITH TEXT ?VCC? M2_TEXT
  A3 = M30 WITH TEXT ?VDD? M3_TEXT
  B3 = M30 WITH TEXT ?VCC? M3_TEXT
  A4 = MT0 WITH TEXT ?VDD? M4_TEXT
  B4 = MT0 WITH TEXT ?VCC? M4_TEXT

  VDD_M1a_1 = (NET AREA RATIO M10 A1 [!!area(M10)*!!area(A1)] > 0) OR (NET AREA RATIO M10 A2 [!!area(M10)*!!area(A2)] > 0)
  VDD_M1a_2 = (NET AREA RATIO M10 A3 [!!area(M10)*!!area(A3)] > 0) OR (NET AREA RATIO M10 A4 [!!area(M10)*!!area(A4)] > 0)
  VDD_M1b_1 = (NET AREA RATIO M10 B1 [!!area(M10)*!!area(B1)] > 0) OR (NET AREA RATIO M10 B2 [!!area(M10)*!!area(B2)] > 0)
  VDD_M1b_2 = (NET AREA RATIO M10 B3 [!!area(M10)*!!area(B3)] > 0) OR (NET AREA RATIO M10 B4 [!!area(M10)*!!area(B4)] > 0)
  VDD_M1a = VDD_M1a_1 OR VDD_M1a_2
  VDD_M1b = VDD_M1b_1 OR VDD_M1b_2

  VDD_M1 = VDD_M1a OR VDD_M1b
  VDD_CT = CTi AND VDD_M1
  VDD_NTAP = NTAPi INTERACT VDD_CT
  VDD_PSD = PSDi INTERACT VDD_CT
  NO_VDD_NW = NWi NOT INTERACT (VDD_NTAP OR VDD_PSD)
  RESULT2 = INT NO_VDD_NW < 2.1 ABUT<90 SINGULAR REGION
  ((RESULT1 AND RESULT2) NOT INTERACT (RESNW OR EXCLU)) INTERACT (AAi AND GTi)
}}}

if { 3 == $metal_counts } {
VERBATIM {
NW_3 {
@ Dimension of an NW region not connected to the most positive power supply is >= 2.10um, which net name including VDD or VCC
@ DRC waive check below condition:
@ 1.	Waive check RESNW covered NW resistor region.
@ 2.	Waive check the pickup purpose NW patterns width <2.1um and not interact with GATE.

  NWwoMPV =  NOT NET NWi ?VDD? ?VCC?
  RESULT1 = INT NWwoMPV < 2.1 ABUT<90 SINGULAR REGION

  A1 = M10 WITH TEXT ?VDD? M1_TEXT
  B1 = M10 WITH TEXT ?VCC? M1_TEXT
  A2 = M20 WITH TEXT ?VDD? M2_TEXT
  B2 = M20 WITH TEXT ?VCC? M2_TEXT
  A3 = MT0 WITH TEXT ?VDD? M3_TEXT
  B3 = MT0 WITH TEXT ?VCC? M3_TEXT

  VDD_M1a_1 = (NET AREA RATIO M10 A1 [!!area(M10)*!!area(A1)] > 0) OR (NET AREA RATIO M10 A2 [!!area(M10)*!!area(A2)] > 0)
  VDD_M1a_2 = NET AREA RATIO M10 A3 [!!area(M10)*!!area(A3)] > 0
  VDD_M1b_1 = (NET AREA RATIO M10 B1 [!!area(M10)*!!area(B1)] > 0) OR (NET AREA RATIO M10 B2 [!!area(M10)*!!area(B2)] > 0)
  VDD_M1b_2 = NET AREA RATIO M10 B3 [!!area(M10)*!!area(B3)] > 0
  VDD_M1a = VDD_M1a_1 OR VDD_M1a_2
  VDD_M1b = VDD_M1b_1 OR VDD_M1b_2

  VDD_M1 = VDD_M1a OR VDD_M1b
  VDD_CT = CTi AND VDD_M1
  VDD_NTAP = NTAPi INTERACT VDD_CT
  VDD_PSD = PSDi INTERACT VDD_CT
  NO_VDD_NW = NWi NOT INTERACT (VDD_NTAP OR VDD_PSD)
  RESULT2 = INT NO_VDD_NW < 2.1 ABUT<90 SINGULAR REGION
  ((RESULT1 AND RESULT2) NOT INTERACT (RESNW OR EXCLU)) INTERACT (AAi AND GTi)
}}}

VERBATIM {
NW_4 {
@ Dummy AA cannot straddle on a boundary of NW
  AADUM CUT NW
}
NW_5 {
@ It is not allowed if N+AA/P+AA straddle on a boundary of the NW except NW resistor region
  NACT CUT (NW NOT INTERACT RESNW)
  PACT CUT (NW NOT INTERACT RESNW)
}



//==============================
//  PSUB - Native Device(NN) DRC
//==============================

GROUP GNN NN_?

NN_1 {
@ NN inside or cross over a N-Well is not allowed
  PSUB AND NW
}
NN_2 {
@ NN inside or cross over a Deep N-Well is not allowed
  PSUB AND DNW
}
NN_3 {
@ NN width is >= 0.84um
  INT PSUB < 0.84 ABUT<90 SINGULAR REGION
}
NN_4 {
@ Space between 2 NN regions is >= 0.84um
  EXT PSUB < 0.84 ABUT<90 SINGULAR REGION
}
NN_5 {
@ Gate dimension of 1.8V native device is >= 1.00um
  INT PSUB_GATE_WID < 1.00 ABUT<90 REGION
}
NN_5a {
@ Gate dimension of 3.3V native device is >= 1.80um
  INT PSUB_HGATE_WID < 1.8 ABUT<90 REGION
}
NN_6 {
@ NN enclosure beyond SN(N+) AA region is = 0.26um
  NACT_PSUB = NACT INTERACT PSUB
  SIZE_NACT = SIZE NACT_PSUB BY 0.26
  PSUB_NACT = PSUB INTERACT NACT_PSUB
  XOR PSUB_NACT SIZE_NACT
  PSUB NOT INTERACT AA
}
NN_7 {
@ Space from NN region to a nominal AA region is >= 0.52um
  EXT PSUB NOMI_AA < 0.52 ABUT<90 SINGULAR REGION
}
NN_8 {
@ Space from NN region to N-Well edge is >= 1.62um
  EXT PSUB NW < 1.62 ABUT<90 SINGULAR REGION
}
NN_9 {
@ Bent Gate Poly is not allowed to put in NN region
  INT PSUB_GATE_WID < 0.005 ABUT<180 REGION
} 
NN_10 {
@ P+GATE region is not allowed to put in NN region
  X = PSUB INTERACT GATE
  AND SP X
}
NN_11 {
@ Only one AA region is allowed to put in NN region, exclude CAPBP and INDMY region.
  (PSUB NOT INTERACT (INDMY OR CAPBP)) INTERACT AA > 1
}

//==========================
//  MVN - Medium VTN DRC
//==========================

GROUP GMVN MVN_?

MVN_1 {
@ MVN inside or cross over Nwell or Psub is not allowed
  MVN INTERACT NW
  MVN INTERACT PSUB
}
MVN_2 {
@ MVN inside or cross over Deep NWell is not allowed
  MVN INTERACT DNW
}
MVN_3 {
@ A bent Gate is not allowed put in MVN region
  INT MVN_GATE_WID <0.005 ABUT<180 REGION
}
MVN_4 {
@ MVN width is >= 0.72um
  INT MVN < 0.72 ABUT<90 SINGULAR REGION
}
MVN_5 {
@ Dimension of a Gate area of a 1.8V Medium NMOS device is >= 0.30um
  INT MVN_LGATE_WID < 0.3 ABUT<90 REGION
}
MVN_5a {
@ Dimension of a Gate area of a 3.3V Medium NMOS device is >= 0.60um
  INT MVN_HGATE_WID < 0.6 ABUT<90 REGION
}
MVN_6 {
@ Space from a MVN region to a SN(N+) AA region is >= 0.70um
  EXT MVN NACT < 0.7 ABUT<90 SINGULAR REGION
}
MVN_7 {
@ Space from a MVN region to a N-well edge is >= 0.42um
  EXT MVN NW < 0.42 ABUT<90 SINGULAR REGION
}
MVN_8 {
@ Extension from a MVN region beyond SN(N+) AA region is >= 0.25um
  ENC NACT MVN < 0.25 ABUT<90 SINGULAR REGION
}
MVN_9 {
@ Space between two MVN areas is >= 0.42um. Merge if < 0.42um
  EXT MVN >0 < 0.42 ABUT<90 SINGULAR REGION
}
MVN_10 {
@ A SP(P+) region is not allowed in a MVN region
  AND SP MVN
}


//==========================
//  MVP - Medium VTP DRC
//==========================

GROUP GMVP MVP_?

MVP_1 {
@ MVP inside or cross over Pwell or Psub is not allowed
  MVP INTERACT PW
  MVP INTERACT PSUB
}
MVP_2 {
@ MVP inside or cross over Deep NWell is not allowed
  MVP INTERACT DNW
}
MVP_3 {
@ A bent Gate is not allowed put in MVP region
  INT MVP_GATE_WID <0.005 ABUT<180 REGION
}
MVP_4 {
@ MVP width is >= 0.72um
  INT MVP < 0.72 ABUT<90 SINGULAR REGION
}
MVP_5 {
@ Dimension of a Gate area of a 1.8V Medium PMOS device is >= 0.25um
  INT MVP_LGATE_WID < 0.25 ABUT<90 REGION
}
MVP_6 {
@ Space from a MVP region to a SP(P+) AA region is >= 0.70um
  EXT MVP PACT < 0.7 ABUT<90 SINGULAR REGION
}
MVP_7 {
@ Extension from a Nwell region beyond MVP region is >= 0.42um
  ENC MVP NW < 0.42 ABUT<90 SINGULAR REGION
}
MVP_8 {
@ Extension from a MVP region beyond SP(P+) AA region is >= 0.25um
  ENC PACT MVP < 0.25 ABUT<90 SINGULAR REGION
}
MVP_9 {
@ Space between two MVP regions is >= 0.42um. Merge if the space is < 0.42um
  EXT MVP < 0.42 ABUT<90 SINGULAR REGION
}
MVP_10 {
@ A SN(N+) region is not allowed in a MVP region
  AND SN MVP
}

SRAM = OR OPCBA OPCBP OPCBM INST
18SRAM = (OR OPCBA OPCBP OPCBM) NOT DG
33SRAM = (OR OPCBA OPCBP OPCBM) AND DG

//===========================
//  AA - Active area DRC
//===========================

GROUP GAA AA_?

AA_1_2 {
@ AA width for interconnect (N+/P+) is >= 0.22um, exclude 1.8V SRAM region.
@ AA width to define the width of NMOS/PMOS, exclude 1.8V SRAM region.	>=	0.22 um
 // INT AA < 0.22 ABUT<90 SINGULAR REGION
 (INT AA_all_O < 0.22 ABUT<90 SINGULAR REGION) NOT INSIDE 18SRAM
}
AA_3 {
@ Space between N+ AA and N+ AA or P+ AA and P+ AA is >= 0.28um
@ (both regions are either inside or outside NW), exclude SRAM region.
 // EXT AA < 0.28 ABUT<90 SINGULAR REGION
  (EXT AA_all < 0.28 ABUT<90 SINGULAR REGION) NOT INSIDE SRAM
}
AA_4 {
@ NW enclosure of an N-well pick-up AA except NW resistor under AA region >= 0.12um.
  ENC NTAP (NW NOT (NW INTERACT ((NW AND (AA AND RESNW)) AND SAB))) < 0.12 ABUT<90 SINGULAR REGION
}
AA_5 {
@ Space between N-Well edge and an N+ AA region which is outside an NW is >= 0.43um, exclude SRAM region.
  (EXT NW NACT < 0.43 ABUT<90 SINGULAR REGION) NOT INSIDE SRAM
}
AA_6 {
@ N-Well enclosure of a P+ AA region which inside an NW is >= 0.43um, exclude SRAM region.
  (ENC PACT NW < 0.43 ABUT<90 SINGULAR REGION) NOT INSIDE SRAM
}
AA_7 {
@ Space between N-Well edge and a P+ AA region (for PW pick-up) outside an NW is >= 0.12um
  EXT NW PTAP < 0.12 ABUT<90 SINGULAR REGION
}
AA_8 {
@ Space between GATE edge and edge of a butted diffusion AA region is >= 0.32um, exclude 1.8V SRAM region.
  (EXT GATEO TAPO < 0.32 ABUT<90 SINGULAR REGION) NOT INSIDE 18SRAM
}
AA_9 {
@ Space between N+ AA and P+ AA for butted diffusion is >= 0.00um
  AND PACT NACT
}
AA_10a {
@ Area of a butted diffusion AA is >= 0.176um
  AREA NTAPBUT < 0.176
  AREA PTAPBUT < 0.176
}
AA_10b { 
@ At lease one segment(AA.10) of the consecutive SN/SP edge of butted diffusion AA should be >= 0.42um
  Y = LENGTH NTAPBUT_EDGE >= 0.42
  NTAPBUT NOT WITH EDGE Y >= 1
  B = LENGTH PTAPBUT_EDGE >= 0.42
  PTAPBUT NOT WITH EDGE B >= 1
}
AA_11 {
@ AA Area is >= 0.20um
  AREA AA_all < 0.20
}
AA_12 {
@ For the situation where N-well and P-well pick-ups are put head-to-head across the well boundary,the space
@ between N-pick-up and P-pick-up should be larger than 0.36um in order to meet the implant layout rules.
  EXT NTAP PTAP < 0.36 ABUT<90 SINGULAR REGION
}
}

VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
}
RULECHECK AA_13_R {
@ Space between N+ AA to P+AA for non-butted diffusion in same well (NW or PW)is >= 0.28um
OUTLAYER  EXT ((NACT AND NW) NOT COIN EDGE PACT) (PACT AND NW) < 0.28 ABUT<90 REGION 
OUTLAYER  EXT ((NACT AND PW) NOT COIN EDGE PACT) (PACT AND PW) < 0.28 ABUT<90 REGION
}

VERBATIM {
#ENDIF


AA_14 {
@ Dummy AA must not touch AA, GT, RESAA, RESNW, or RESP1
  AADUM INTERACT AA
  AADUM INTERACT GT
  AADUM INTERACT RESAA
  AADUM INTERACT RESNW
  AADUM INTERACT RESP1
}


//==========================
//  DG - Dual Gate DRC
//==========================

GROUP GDG DG_?

DG_1 {
@ Enclosure of DG beyond the active AA region,exclude 3.3V SRAM is >= 0.32um
  (ENC AAO DG < 0.32 ABUT<90 SINGULAR REGION) NOT INSIDE 33SRAM
}
DG_2 {
@ Space between two DG regions is >= 0.45um, merge if the space is < 0.45um
  EXT DG < 0.45 ABUT<90 SINGULAR REGION
}
DG_3 {
@ Space between DG edge and AA with devices is >= 0.32um
  X = AA NOT TAP 
  EXT DG X < 0.32 ABUT<90 SINGULAR REGION
}
DG_4 {
@ Space between DG region and 1.8V transistor channel(overlap of Poly and AA) along
@ source/drain direction is >= 0.40um 
  X = LGATE NOT TOUCH EDGE AA
  EXT DG X < 0.4 ABUT<90 REGION
}
DG_5 {
@ Enclosed 3.3V transistor channel (overlap of Poly and AA) by DG along source/drain direction is >= 0.40um
  X = HGATE NOT TOUCH EDGE AA
  ENC X DG < 0.4 ABUT<90 OPPOSITE REGION
}
}

VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
}
RULECHECK DG_6_R {
@ Overlap between DG and other voltage MOS AA is forbidden
OUTLAYER  (((AA INTERACT GT) CUT DG) NOT DG) INTERACT GT 
}
RULECHECK DG_7_R {
@ AA interact GT in DG hole is not allowed
OUTLAYER  AA INTERACT (GT AND (HOLES DG))
}
VERBATIM {
#ENDIF
DG_8 {
@ GATE (AA AND GT) CUT DG is not allowed.
  (AA AND GT) CUT DG
}
}


VERBATIM {
//========================
//  GT - Poly 1 Gate DRC
//========================

GROUP GGT GT_?

GT_1 {
@ GT width, exclude 1.8V SRAM region. >= 0.18um.
  //INT INTERGT < 0.18 ABUT<90 SINGULAR REGION
 (INT GT_all_O < 0.18 ABUT<90 SINGULAR REGION) NOT INSIDE 18SRAM
}
GT_2 {
@ GT width for channel length of 1.8V PMOS/NMOS is >= 0.18um
  INT GT_AA_EDGE < 0.18 ABUT<90 REGION
}
GT_3 {
@ Space between two GT regions on AA which is with no contact, exclude 1.8V SRAM region is >= 0.25um.
//  EXT GATE < 0.25 ABUT<90 SINGULAR REGION
  (EXT (AA_all_O AND GT_all_O) < 0.25 ABUT<90 SINGULAR REGION) NOT INSIDE 18SRAM
}
GT_4 {
@ Space between two GT regions on field oxide area,exclude 1.8V SRAM region is >= 0.25um, .
//  X = INTERGT NOT COIN EDGE GATE
//  EXT X < 0.25 ABUT<90 REGION
  Y = AA_all_O AND GT_all_O
  X = (GT_all_O NOT Y) NOT COIN EDGE Y
  (EXT X < 0.25 ABUT<90 REGION) NOT INSIDE 18SRAM
}
GT_5 {
@ Poly extension of AA, exclude 1.8V SRAM region is >= 0.22um, .
  (ENC AA_GATE_EDGEO GTO < 0.22 ABUT<90 REGION) NOT INSIDE 18SRAM
}
GT_6 {
@ Extension from AA region to GT is >= 0.32um, exclude SRAM region.
  (ENC GT AA < 0.32 ABUT<90 SINGULAR REGION) NOT INSIDE SRAM
}
GT_7 {
@ Space between field interconnect poly and AA is >= 0.10um, exclude SRAM region.
  (EXT AA_OUT_EDGE INTERGT < 0.1 ABUT<90 REGION) NOT INSIDE SRAM
  (EXT AADUM INTERGT < 0.1 ABUT<90 REGION) NOT INSIDE SRAM
  (EXT AA_OUT_EDGE GTDUM < 0.1 ABUT<90 REGION) NOT INSIDE SRAM
}
GT_8 {
@ Channel length for 3.3V PMOS is >= 0.30um
  X = GT INSIDE EDGE (HVAA AND SP)
  INT X < 0.30 ABUT<90 REGION
}
GT_9 {
@ Channel length for 3.3V NMOS,exclude 3.3V SRAM is >= 0.35um
  X = GT INSIDE EDGE (HVAA AND SN)
  (INT X < 0.35 ABUT<90 REGION) NOT INSIDE 33SRAM
}
GT_10a_10b {
@ Length of salicide poly on STI between two contacts when poly width <= 0.24um is <= 50um 
@ Length of salicide poly on STI between one contact and any point of poly when poly width <= 0.24um is <= 50um
  Thin_poly_a = INTERGT INTERACT ( INTERGT WITH WIDTH <= 0.24 )
  Thin_poly = area Thin_poly_a >= 9
  POLY = Thin_poly ENCLOSE CT > 0

  X = SIZE INTERCT BY 25 INSIDE OF POLY STEP 0.25
  POLY INTERACT X > 1
  Y = SIZE X BY 25 INSIDE OF POLY STEP 0.25
  POLY NOT Y
}
GT_11a {
@ 90° bends on active area are not allowed, exclude SRAM region.
  (INT GT_AA_EDGE < 0.01 ABUT == 90 REGION) NOT INSIDE SRAM
  (EXT GT_AA_EDGE < 0.01 ABUT == 90 REGION) NOT INSIDE SRAM
}
GT_11b { 
@ GT must enter AA perpendicularly, exclude SRAM region.  
  X = AA INSIDE EDGE GT
  Y = GT INSIDE EDGE AA
  (INT X Y < 0.005 ABUT!= 90 REGION) NOT INSIDE SRAM
}
#IFDEF DENSITY_CHECK YES
GT_12 { 
@ GT density is >= 14%
  DENSITY GTi_all < 0.14
}
#ENDIF
GT_13 {
@ Space between two GTs on AA which is with CT is >= 0.375um, exclude 1.8V SRAM region.
  X = (SDO OR NSD_CAPO) INTERACT CTO
  Y = GATEO COINCIDENT EDGE X
  (EXT Y < 0.375 ABUT<90 REGION) NOT INSIDE 18SRAM
}
GT_14 {
@ Channel length of 1.8V device poly gate on AA with 45 bent is >= 0.21um 
  X = ANGLE GATE == 45
  INT X < 0.21 ABUT<90 REGION 
} 
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
}

RULECHECK GT_15_R {
@ GT must be enclosed by (SN or SP) except the MOM/MIM, HRP region
OUTLAYER  (GT NOT (SN OR SP)) NOT (MOMDMY OR (MIMDMY OR HRP)) 
} 

VERBATIM {
#ENDIF

#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
GT_16_R {
@ Poly interacting AA must separate at least two AA diffusions (exclude dummy pattern).
@ DRC doesn't check:
@ 1.	SRAM, MOS capacitor (CAPBP), LOGO and INDMY covered region. 
@ 2.	When AA or poly not interact with CT.
  AA_CT = (AA INTERACT CT) NOT INSIDE (OR LOGO INDMY CAPBP)
  GT_CT = (GT INTERACT CT) NOT INSIDE (OR LOGO INDMY CAPBP)
  X_GATE1 = GATE INSIDE (AA_CT AND GT_CT)
  (TOUCH X_GATE1 (AA_CT NOT X_GATE1) <2) NOT INSIDE SRAM
}
#ENDIF
}

VERBATIM {
//====================================
//  NLL - 1.8V NLDD Implantation DRC
//====================================

GROUP GNLL NLL_?

NLL_1 {
@ NLL width is >= 0.44um
  INT NLL < 0.44 ABUT<90 SINGULAR REGION
}
NLL_2 {
@ Space between two NLL regions is >= 0.44um
@ Merge if the space is less than 0.44m
  EXT NLL < 0.44 ABUT<90 SINGULAR REGION
}
NLL_3 {
@ Space between an NLL region and a P+ AA region is >= 0.26um
  X = MOSP NOT COIN EDGE NLL
  EXT NLL X < 0.26 ABUT<90 REGION
}
NLL_4 {
@ Space between an NLL region and a P+ pick-up AA region is >= 0.10um
  EXT NLL PTAPNOBUT_EDGE < 0.10 ABUT<90 REGION
}
NLL_5 {
@ Overlap from an NLL edge to an AA is >= 0.23um
  INT NLL NACT < 0.23 ABUT<90 SINGULAR REGION
}
NLL_6 {
@ Enclosure of an NLL region over SN active region is >= 0.18um
   X = (MOSN NOT SNR) NOT COIN EDGE PACT
   ENC X NLL < 0.18 ABUT<90 REGION
}
NLL_7 {
@ Space between an NLL region and an NLH AA region is >= 0.21um
  X = NLHAA NOT COIN EDGE NLLAA
  EXT NLL X < 0.21 ABUT<90 REGION
}
NLL_8_12 {
@ Enclosure of an NLL region to an N-channel poly gate is >= 0.32um
@ Enclosure of an NLL region over N-channel along the direction of poly gate is >= 0.35um
  (EX_NGATE INTERACT NLL) NOT NLL
}
NLL_9 {
@ NLL area is >= 0.40um
  AREA NLL < 0.40
}
NLL_10 {
@ Separation from an NLL to a butted edge of a butted diffustion P+ AA is >= 0.00um (inside P-Well)
  AND NLL PTAP
}
NLL_11_NLH_11 {
@ Space between NLL and NLH is 0.00um if two AAs are overlapped is >= 0um
  X = AND NLL NLH
  X INTERACT AA
}
NLL_14 {
@ NLL implant is not allowed in non-salicide AA/Poly resistor region
  NLL AND ((AA INTERACT RESAA) AND SAB)    
  NLL AND (GTR AND SAB) 
} 
//; NLL_13_NC {
//; @ Minimum NLL area for a N-channel poly gate must follow NLL.8 and NLL.12 }




//======================================
//   PLL - 1.8V PLDD Implantation DRC
//======================================

GROUP GPLL PLL_?

PLL_1 {
@ PLL width is >= 0.44um
  INT PLL < 0.44 ABUT<90 SINGULAR REGION
}
PLL_2 {
@ Space between two PLL regions is >= 0.44um
@ Merge if the space is less than 0.44m
  EXT PLL < 0.44 ABUT<90 SINGULAR REGION
}
PLL_3 {
@ Space from a PLL region to an N+ AA region is >= 0.26um.(inside P-well)
  X = MOSN NOT COIN EDGE PLL
  EXT PLL X < 0.26 ABUT<90 REGION
}
PLL_4 {
@ Space from a PLL region to an N+ pick-up AA region is >= 0.10um
  EXT PLL NTAPNOBUT_EDGE < 0.10 ABUT<90 REGION
}
PLL_5 {
@ Overlap from a PLL edge to an AA is >= 0.23um
  INT PLL PACT < 0.23 ABUT<90 SINGULAR REGION
}
PLL_6 {
@ Enclosure of a PLL region beyond a SP active region is >= 0.18um
  X = MOSP NOT COIN EDGE NACT
  ENC X PLL < 0.18 ABUT<90 REGION
}
PLL_7 {
@ Space of a PLL region to a PLH AA region is >= 0.21um
  X = PLHAA NOT COIN EDGE PLLAA
  EXT PLL X < 0.21 ABUT<90 REGION
}
PLL_8_12 {
@ Enclosure of an PLL region to an P-channel poly gate is >= 0.32um
@ Enclosure of an PLL region over P-channel along the direction of poly gate is >= 0.35um
 (EX_PGATE INTERACT PLL) NOT PLL
}
PLL_9 {
@ PLL area is >= 0.40um
  AREA PLL < 0.40
}
PLL_10 {
@ Separation from a PLL to a butted edge of a butted diffustion N+ AA is >= 0.00um (inside N-Well)
  AND PLL NTAP
}
PLL_11_PLH_11 {
@ Space between PLL and PLH if two AAs are overlapped is >= 0.00um
 X = AND PLL PLH
 X INTERACT AA
}
PLL_14 {
@ PLL implant is not allowed in Non-salicide AA/poly resistor region
  PLL AND ((AA INTERACT RESAA) AND SAB)
  PLL AND (GTR AND SAB) 
} 
//; PLL_13_NC {
//; @ Minimum PLL area for a P-channel poly gate must follow PLL.8 and PLL.12 }



//=====================================
//  NLH - 3.3V NLDD Implantation DRC
//=====================================

GROUP GNLH NLH_?

NLH_1 {
@ Width of an NLH is >= 0.44um
  INT NLH < 0.44 ABUT<90 SINGULAR REGION
}
NLH_2 {
@ Space between two NLH regions is >= 0.44um
@ Merge if the space is less than 0.44m
  EXT NLH < 0.44 ABUT<90 SINGULAR REGION
}
NLH_3 {
@ Space between an NLH region and a P+ AA region is >= 0.26um.(inside N-well)
  X = MOSP NOT COIN EDGE NLH
  EXT NLH X < 0.26 ABUT<90 REGION
}
NLH_4 {
@ Space between an NLH region and a Pwell pick-up P+ AA is >= 0.10um
  EXT NLH PTAPNOBUT_EDGE < 0.10 ABUT<90 REGION
}
NLH_5 {
@ Overlap from an NLH edge to an AA is >= 0.23um
  INT NLH NACT < 0.23 ABUT<90 SINGULAR REGION
}
NLH_6 {
@ Enclosure of an NLH region beyond an NP active region is >= 0.18um
  X = (MOSN NOT SNR) NOT COIN EDGE PACT
  ENC X NLH < 0.18 ABUT<90 REGION
}
NLH_7 {
@ Space between an NLH region and an NLL AA region is >= 0.21um
  X = NLLAA NOT COIN EDGE NLHAA
  EXT NLH X < 0.21 ABUT<90 REGION
}
NLH_8_12 {
@ Enclosure of an NLH region to an N-channel is >= 0.32um
@ Enclosure of an NLH region over N-channel along the direction of poly gate is >= 0.35um
  (EX_NGATE INTERACT NLH) NOT NLH
}
NLH_9 {
@ NLH area is >= 0.40um
  AREA NLH < 0.40
}
NLH_10 {
@ Separation from an NLH to a butted edge of a butted diffustion P+ AA is >= 0.00um (inside P-Well)
  AND NLH PACT
}
NLH_14 {
@ NLH implant is not allowed in non-salicide AA/Poly resistor region
  NLH AND ((AA INTERACT RESAA) AND SAB) 
  NLH AND (GTR AND SAB) 
} 
//; NLH_13_NC {
//; @ Minimum NLH area for a N-channel poly gate must follow NLH.8 and NLH.12 }  



//====================================
//  PLH - 3.3V PLDD Implantation DRC
//====================================

GROUP GPLH PLH_?

PLH_1 {
@ PLH width is >= 0.44um
  INT PLH < 0.44 ABUT<90 SINGULAR REGION
}
PLH_2 {
@ Space between two PLH regions is >= 0.44um
@ Merge if the space is less than 0.44m
  EXT PLH < 0.44 ABUT<90 SINGULAR REGION
}
PLH_3 {
@ Space between a PLH region and an N+ AA is >= 0.26um.(inside P-well)
  X = MOSN NOT COIN EDGE PLH
  EXT PLH X < 0.26 ABUT<90 REGION
}
PLH_4 {
@ Minimum space between a PLH region and an N+ pick-up AA region is 0.10um
  EXT PLH NTAPNOBUT_EDGE < 0.10 ABUT<90 REGION
}
PLH_5 {
@ Overlap from a PLH edge to an AA is >= 0.23um
  INT PLH PACT < 0.23 ABUT<90 SINGULAR REGION
}
PLH_6 {
@ Enclosure of a PLH region beyond a SP active region is >= 0.18um
   X = MOSP NOT COIN EDGE NACT
   ENC X PLH < 0.18 ABUT<90 REGION
}
PLH_7 {
@ Space between a PLH region and a PLL AA region is >= 0.21um
  X = PLLAA NOT COIN EDGE PLHAA
  EXT PLH X < 0.21 ABUT<90 REGION
}
PLH_8_12 {
@ Enclosure of an PLH region to an P-channel poly gate is >= 0.32um
@ Enclosure of an PLH region over P-channel along the direction of poly gate is >= 0.35um
  (EX_PGATE INTERACT PLH) NOT PLH
}
PLH_9 {
@ PLH area is >= 0.40um
  AREA PLH < 0.40
}
PLH_10 {
@ Separation from a PLH to butted edge of a butted N+ AA (inside N-Well) is >= 0.00um
  AND PLH NTAP
}
PLH_14 {
@ PLH implant is not allowed in non-salicide AA/Poly resistor region
  PLH AND ((AA INTERACT RESAA) AND SAB) 
  PLH AND (GTR AND SAB) 
} 
//; PLH_13_NC {
//; @ Minimum PLH area for a P-channel poly gate must follow PLH.8 and PLH.12 }



//=============================
//  SN - N+ Implantation DRC
//=============================

GROUP GSN SN_?

SN_1 {
@ SN width, exclude 3.3V SRAM is >= 0.44um
  (INT SN < 0.44 ABUT<90 SINGULAR REGION) NOT INSIDE 33SRAM
}
SN_2 {
@ Space between two SN regions is >= 0.44um
@ Merge if the space is less than 0.44m,exclude 3.3V SRAM
  (EXT SN < 0.44 ABUT<90 SINGULAR REGION) NOT INSIDE 33SRAM
}
SN_3 {
@ Space between SN and a P+ AA region. (inside N-well), exclude SRAM region.>= 0.26um
  X = NOT COIN EDGE MOSP SN
  (EXT SN X < 0.26 ABUT<90 REGION) NOT INSIDE SRAM
}
SN_4 {
@ Space between SN and a non-butted edge of P+ pick-up AA region (exclude SRAM region) 
@ if the distance between P+AA and N-well >=0.43µm.	>=	0.10	um
  X = EXT SN PTAPNOBUT_EDGE < 0.10 ABUT<90 REGION
  Y = PTAP NOT INTERACT CT
  (X NOT INTERACT Y) NOT INSIDE SRAM
}
SN_5 {
@ Space between a SN region and a non-butted edge of P-well pick-up P+AA region (exclude SRAM region) 
@ if the distance between P+AA and N-well <0.43µm	>=	0.18	um
  NW_over = SIZE NWDEV BY 0.43
  NW_over2 = SIZE NWDEV BY 0.429

  Y = PTAP AND NW_over
  Z = PTAP NOT NW_over2
  X = SN NOT INSIDE EDGE AA
  A = EXT Y X < 0.18 ABUT>0<90 REGION OPPOSITE
  B = EXT Z X < 0.10 ABUT>0<90 REGION OPPOSITE
  C = PTAP NOT INTERACT CT
  (A NOT INTERACT C) NOT INSIDE SRAM
  (B NOT INTERACT C) NOT INSIDE SRAM
}

SN_6 {
@ Space from a SN edge to a P-channel Poly gate is >= 0.32um
  X = PGATE NOT TOUCH EDGE AA
  EXT SN X < 0.32 ABUT<90 OPPOSITE
}
SN_7_17 {
@ Enclosure of a SN edge to an N-channel Poly gate along source/drain direction,exclude 3.3V SRAM is >= 0.32um
@ Enclosure of a SN edge to a N-channel Poly gate along the direction of poly gate, exclude SRAM region. is >= 0.35um
  (ENC GT_AA_EDGE_O SN < 0.32 ABUT<90 REGION) NOT INSIDE 33SRAM
  E2 = AA INSIDE EDGE GT
  R = ENC E2 SN < 0.35 ABUT<90 REGION
  (R AND EX_NGATE) NOT INSIDE SRAM
}
SN_8 {
@ Overlap from a SN edge to an AA is >= 0.23um
  X = NOT COIN EDGE SN AA
  INT AA X < 0.23 ABUT<90 REGION
}
SN_9 {
@ Enclosure of a SN region beyond a SN active AA region is >= 0.18um (DRC doesn't check pick-up AA)
  X = (MOSN NOT SNR) NOT COIN EDGE PACT
  ENC X SN < 0.18 ABUT<90 REGION
}
SN_10_11 {
@ SN.10. Enclosure of a SN region beyond an N+ pick-up AA region, exclude SRAM region. is >= 0.02um if 
@ the distance between N+ AA and P-well >= 0.43um
@ SN.11. Enclosure of a SN region beyond an N+ pick-up AA region, exclude SRAM region. is >= 0.18um if
@ the distance between N+ AA and P-Well < 0.43m
@ a. To obey this rule and SN.3 simultaneously, the minimum space
@ between N+ pick-up AA and SP active AA should be increased to 0.44um
@ b. To obey this rule and SN.5 simultaneously, the minimum space
@ between N+ pick-up AA and SP active AA should be increased to 0.36um
  PW_SIZE = SIZE PW BY 0.43
  NTAP1_EDGE = (NTAP NOT AAR) INSIDE EDGE PW_SIZE
  NTAP2_EDGE = (NTAP NOT AAR) COIN EDGE PW_SIZE 
  A= ENC (((NTAP NOT AAR) NOT COIN EDGE NTAP1_EDGE) NOT COIN EDGE SP) SN < 0.02  ABUT < 90 REGION OPPOSITE 
  B= ENC (((NTAP NOT AAR) COIN EDGE NTAP2_EDGE) NOT COIN EDGE SP) SN < 0.02  ABUT < 90 REGION OPPOSITE
  X= EXT ((NTAP NOT AAR) COIN EDGE NTAP1_EDGE) PW < 0.43  ABUT< 90 REGION OPPOSITE
  Y = ((NTAP NOT AAR) COIN EDGE X) NOT COIN EDGE SP
  Z = (((NTAP NOT AAR) COIN EDGE NTAP1_EDGE) NOT COIN EDGE X) NOT COIN EDGE SP
  C = ENC Y SN < 0.18 ABUT < 90 REGION OPPOSITE
  D = ENC Z SN < 0.02 ABUT < 90 REGION OPPOSITE
  E = NTAP NOT INTERACT CT
  (A NOT INTERACT E) NOT INSIDE SRAM
  (B NOT INTERACT E) NOT INSIDE SRAM
  (C NOT INTERACT E) NOT INSIDE SRAM
  (D NOT INTERACT E) NOT INSIDE SRAM
}
SN_12_SP_12 {
@ Separation from a SN region to butted edge of a butted diffusion SP AA is >= 0.00um (inside P-well)
@ Separation from a SP region to butted edge of a butted diffusion SN AA is >= 0.00um (inside N-well)
  AND MOSN PTAP
  X = NTAPBUT NOT COIN EDGE PACT
  (X TOUCH EDGE SP) NOT COIN EDGE (NTAP NOT INTERACT CT)
  Y = PTAPBUT NOT COIN EDGE NACT
  (Y TOUCH EDGE SN) NOT COIN EDGE (PTAP NOT INTERACT CT)
}
SN_13_SP_13 {
@ Extension of a SN region along the edge of a butted diffusion N+ AA/P+ AA is >= 0.00um 
@ Extension of a SP region along the edge of a butted diffusion P+ AA/N+ AA is >= 0.00um
  AND MOSP NTAP
}
SN_14 {
@ SN area is >= 0.38um
  AREA SN < 0.38
}
SN_15 {
@ Extension of a SN region beyond a poly as a resistor is >= 0.18um.
@ SAB poly without SN or SP implant is not allowed,exclude (HRP AND SAB) region.
(ENC GTR SN < 0.18 ABUT<90 SINGULAR REGION) NOT INSIDE (HRP AND SAB)
 (((GTR INTERACT SAB) NOT SN) NOT SP ) NOT INSIDE (HRP AND SAB)
}
SN_16 {
@ Space from a SN edge to a P-channel Poly gate along the direction of poly gate, exclude SRAM region. is >= 0.35um
  //;X = MOSP INSIDE EDGE GT
  X = PACT INSIDE EDGE GT
  (EXT X SN < 0.35 ABUT<90 REGION) NOT INSIDE SRAM
}
SN_18_SP_18 {
@ SN is not allowed to overlap with SP
  AND SN SP
}
//; SN_19_NC {
//; @ It is prohibited that SN being generated by the reverse tone of SP, since this operation 
//; @ might violate SN.3 and SN.4 }
//; SN_20_NC {
//; @ Minimum SN area for a N-channel poly gate must follow SN.7 and SN.17 }


//==============================
//  SP - P+ Implantation DRC
//==============================

GROUP GSP SP_?

SP_1 {
@ SP width,exclude 3.3V SRAM is >= 0.44um
  (INT SP < 0.44 ABUT<90 SINGULAR REGION) NOT INSIDE 33SRAM
}
SP_2 {
@ Space between two SP regions is >= 0.44um
@ Merge if the space is less than 0.44m,exclude 3.3V SRAM
  (EXT SP < 0.44 ABUT<90 SINGULAR REGION) NOT INSIDE 33SRAM
}
SP_3 {
@ Space between a SP region and a N+ AA is >= 0.26um (inside P-well),exclude SRAM region.
  X = NOT COIN EDGE MOSN SP
  (EXT SP X < 0.26 ABUT<90 REGION) NOT INSIDE SRAM
}
SP_4 {
@ Space between SP and a non-butted edge of N+ pick-up AA region, exclude SRAM region. is >= 0.10um
@ if the distance between N+ AA and P-well >= 0.43m
  (EXT SP NTAPNOBUT_EDGE < 0.10 ABUT<90 REGION) NOT INSIDE SRAM
}
SP_5 {
@ Space between a SP region and a non-butted edge of N-well pick-up N+ AA region, exclude SRAM region.
@ is >= 0.18um if the distance between N+ AA and P-well < 0.43um
  PB_over = SIZE PW BY 0.43
  PB_over2 = SIZE PW BY 0.429

  Y = NTAP AND PB_over
  Z = NTAP NOT PB_over2
  X = SP NOT INSIDE EDGE AA
  (EXT Y X < 0.18 ABUT>0<90 REGION OPPOSITE) NOT INSIDE SRAM
  (EXT Z X < 0.10 ABUT>0<90 REGION OPPOSITE) NOT INSIDE SRAM
}
SP_6 {
@ Space from a SP edge to N-channel Poly gate is >= 0.32um
  EXT SP GT_AA_EDGE < 0.32 ABUT<90 OPPOSITE
}
SP_7_17 {
@ Enclosure of a SP edge to P-channel Poly gate along source/drain direction,exclude 3.3V SRAM is >= 0.32um
@ Space from a SP edge to a P-channel Poly gate along the direction of poly gate, exclude SRAM region. is >= 0.35um
  (ENC GT_AA_EDGE_O SP < 0.32 ABUT<90 REGION) NOT INSIDE 33SRAM
  E2 = AA INSIDE EDGE GT
  R = ENC E2 SP < 0.35 ABUT<90 REGION
  (R AND EX_PGATE) NOT INSIDE SRAM
}
SP_8 {
@ Overlap from a SP edge to an AA is >= 0.23um
  X = NOT COIN EDGE SP AA
  INT AA X < 0.23 ABUT<90 REGION
}
SP_9 {
@ Enclosure of a SP region beyond a SP active AA region is >= 0.18um 
  X = MOSP NOT COIN EDGE NACT
  ENC X SP < 0.18 ABUT<90 REGION
}
SP_10_11 {
@ SP.10. Enclosure of a SP region beyond a P-Well pick-up P+AA region, exclude SRAM region. is >= 0.02um
@ if the distance between P+AA and N-Well >=0.43m
@ SP.11. Enclosure of a SP region beyond a P-Well pick-up P+AA region, exclude SRAM region.  is >= 0.18um
@ if the distance between P+AA and N-Well < 0.43m
@ c. To obey this rule and SP.3 simultaneously,
@ P+ pick-up AA to SN active AA minimum spacing must be increased to 0.44um
@ d. To obey this rule and SP.5 simultaneously,
@ P+ pick-up AA to SN pick-up AA minimum spacing must be increased to 0.36um
  NW_SIZE = SIZE NW BY 0.43
  PTAP1_EDGE = PTAP INSIDE EDGE NW_SIZE
  PTAP2_EDGE = PTAP COIN EDGE NW_SIZE 
  (ENC ((PTAP NOT COIN EDGE PTAP1_EDGE) NOT COIN EDGE SN) SP < 0.02  ABUT < 90 REGION OPPOSITE) NOT INSIDE SRAM
  (ENC ((PTAP COIN EDGE PTAP2_EDGE) NOT COIN EDGE SN) SP < 0.02  ABUT < 90 REGION OPPOSITE) NOT INSIDE SRAM
  X= EXT (PTAP COIN EDGE PTAP1_EDGE) NW < 0.43 ABUT < 90 REGION OPPOSITE
  Y = (PTAP COIN EDGE X) NOT COIN EDGE SN
  Z = ((PTAP COIN EDGE PTAP1_EDGE) NOT COIN EDGE X) NOT COIN EDGE SN
  (ENC Y SP < 0.18 ABUT < 90 REGION OPPOSITE) NOT INSIDE SRAM
  (ENC Z SP < 0.02 ABUT < 90 REGION OPPOSITE) NOT INSIDE SRAM
}
SP_14 {
@ SP area is >= 0.38um
  AREA SP < 0.38
}
SP_15 {
@ Extension of a SP region beyond a poly as a resistor is >= 0.18um. 
@ SAB poly without SN or SP implant is not allowed,exclude (HRP AND SAB) region.
  GTRes = GTR OR GTR_N3T
  (ENC GTRes SP < 0.18 ABUT<90 SINGULAR REGION) NOT INSIDE (HRP AND SAB)
  (((GTR INTERACT SAB) NOT SN) NOT SP) NOT INSIDE (HRP AND SAB)
  ((GTR_N3T NOT HR_GT) NOT SP) NOT INSIDE (HRP AND SAB)
}
SP_16 {
@ Space from a SP edge to a N-channel Poly gate along the direction of poly gate, exclude SRAM region. is >= 0.35um
  //;X = MOSN INSIDE EDGE GT
  X = NACT INSIDE EDGE GT
  (EXT X SP < 0.35 ABUT<90 REGION) NOT INSIDE SRAM
}
//; SP_19_NC {
//; @ It is prohibited that SP is generated by the reverse tone of SN, since this operation 
//; @ might violated SP.3 and SP.4 }
//; SP_20_NC {
//; @ Minimum SP area for a P-channel poly gate must follow SP.7 and SP.17 }


//==============================
//  SAB - Salicide Block DRC
//==============================

GROUP GSAB SAB_?

SAB_1 {
@ SAB width is >= 0.43um
  INT SAB < 0.43 ABUT<90 SINGULAR REGION
}
SAB_2 {
@ Space between two SABs is >= 0.43um
  EXT SAB < 0.43 ABUT<90 SINGULAR REGION
}

#IFDEF NW_space_check 153
#IFDEF 153_shrink_check YES

SAB_2a {
@ SAB space when one or both SABs interact with GT. 
@ DRC waive if no (GT OR AA) exists in the space region. 
@ (This rule is only used for the design that it will be shrinkage from 0.18um to 0.153um. Designer can waive this rule for 0.18um design only.)	>=	0.45	um
  (EXT SAB (SAB INTERACT GT) <0.45 ABUT<90 SINGULAR REGION) NOT INSIDE (GT OR AA)  
}

#ENDIF
#ENDIF

SAB_3 {
@ Space to unrelated AA is >= 0.22um
  EXT SAB AA < 0.22 ABUT<90 SINGULAR REGION
}
SAB_4 {
@ Space to contact is >= 0.22um
  EXT SAB CT < 0.22 ABUT<90 SINGULAR REGION
}
SAB_5 {
@ Space to poly on AA is >= 0.45um
  EXT SAB GATE < 0.45 ABUT<90 SINGULAR REGION
}
SAB_6 {
@ Extension over related AA is >= 0.22um
  ENC AA SAB < 0.22 ABUT<90 SINGULAR REGION
}
SAB_7 {
@ Extension of diffusion over related SAB is >= 0.22um
  ENC SAB AA < 0.22 ABUT<90 SINGULAR REGION
}
SAB_8 {
@ Extension of SAB over related resistor poly on field oxide is >= 0.22um
  X = GT INTERACT RESP1
  ENC X SAB < 0.22 ABUT<90 REGION
}
SAB_9 {
@ Space of SAB to unrelated poly on field oxide is >= 0.30um
  EXT SAB (INTERGT NOT INTERACT SAB) < 0.3 ABUT<90 SINGULAR REGION
}
SAB_10 {
@ SAB area is >= 2.00um
  AREA SAB < 2.00
}
SAB_10a {
@ SAB enclosed area (um2)	>=	1.00 µm2.
  X = (HOLES SAB INNER) NOT SAB
  AREA X < 1
}

//====================
//  CT - Contact DRC
//====================

GROUP GCT CT_?

CT_1 {
@ CT width (CT must be square), exclude EFUSE region.	=	0.22um
 W = CTi INSIDE ((TAPi TOUCH (HOLES TAPi)) AND EXCLU)
 X1 = RECTANGLE W ASPECT >= 2.5
 X2 = W TOUCH (HOLES W)
 X = (X1 OR X2) OR CTS
 ((NOT RECTANGLE (CTi NOT X) == 0.22 BY == 0.22) NOT INSIDE FUSEMK1) NOT INSIDE MARKS
}
CT_2 {
@ Space between two contacts is >= 0.25um, exclude SRAM region.
  (EXT CT < 0.25 ABUT<90 SINGULAR REGION) NOT INSIDE SRAM
}
CT_3 {
@ Space between two CTs in a contact array with row and column numbers are both greater than 3 is >= 0.28um
@ Two contact regions whose space is <= 0.30um are considered to be in the same array
  X = SIZE CT BY 0.15 OVERUNDER
  Y = SIZE X BY 0.814 UNDEROVER
  Z = CT INSIDE Y
  EXT Z < 0.28 ABUT<90 SINGULAR REGION
}
CT_4 {
@ Space between poly CT to AA is >= 0.20um, exclude SRAM region.
  (EXT INTERCT AA < 0.20 ABUT<90 SINGULAR REGION) NOT INSIDE SRAM
}
CT_5 {
@ Space between poly to diffusion CT is >= 0.16um, exclude SRAM region.
  (EXT GT ACT_CT < 0.16 ABUT<90 SINGULAR REGION) NOT INSIDE SRAM
}
CT_6_7 {
@ Enclosure of an AA region beyond an AA CT region is >= 0.10um, exclude SRAM region.
@ Enclosure of a poly region beyond a poly CT region is >= 0.10um, exclude SRAM region.
  Y = (CT NOT OPCBP) NOT OPCBA
  Y1 = Y INTERACT GT
  Y2 = Y INTERACT AA
  (ENC Y1 GT < 0.10 ABUT<90 OVERLAP SINGULAR REGION) NOT INSIDE SRAM
  (ENC Y2 AA < 0.10 ABUT<90 OVERLAP SINGULAR REGION) NOT INSIDE SRAM
  ((Y NOT GT) NOT AA) NOT INSIDE SRAM
}
CT_8 {
@ Enclosure of a SP region beyond an AA CT region is >= 0.12um
  ENC ACT_CT SP < 0.12 ABUT<90 SINGULAR REGION
}
CT_9 {
@ Enclosure of an SN region beyond an AA CT region is >= 0.12um
  ENC ACT_CT SN < 0.12 ABUT<90 SINGULAR REGION
}
CT_10 {
@ CT on gate region is forbidden
  AND GATE CT
}
CT_11 {
@ AA contact located on SN/SP boundary is not allowed
  X = CT INTERACT AA
  X CUT SN
  X CUT SP
}
CT_12 {
@ Non-salicided contacts are not allowed, rexclude SRAM region.
@ Salicide-CT definition: CTs fully enclosed by ((AA OR GT) NOT SAB)
  (AND SAB CT) NOT INSIDE SRAM
  (CT NOT ((AA OR GT) NOT SAB)) NOT INSIDE SRAM
}
CT_13 {
@ CT must be fully covered by M1 AND (AA OR GT), exclude SRAM reigon. 
  (CT NOT (M1 AND (AA OR GT))) NOT INSIDE SRAM
}


CT_14 {
@ It's not allowed CT overlap with NW, AA, Poly or M1 resistor. 
@ For NW, AA, Poly resistor, please refer each resistor section definition.
@ M1 resistor definition: (M1 AND M1R).
  NWRES = (((AA AND RESNW) AND NW) AND SAB) OR ((NW AND RESNW) NOT INTERACT SAB)
  AARES = ((AA AND RESAA) AND SAB) OR ((AA AND RESAA) NOT INTERACT SAB)
  GTRES = (((GT AND RESP1) AND SAB) OR ((GT AND RESP1) NOT INTERACT SAB)) OR ((GT AND HRPDMY) AND SAB)

  CT AND NWRES
  CT AND AARES
  CT AND GTRES
  CT AND M1RES
}



//===================
//  Vn - Via n DRC
//===================
}


for { set j 1 } { 1 <= [expr $metal_counts -$j -1] } { incr j } {

GROUP GV${j} V${j}_?

RULECHECK V${j}_1 {
@ V1 width (V1 must be square),	=	0.26	um
SETLAYER  W = V${j}i INSIDE ((TAPi TOUCH (HOLES TAPi)) AND EXCLU)
SETLAYER  X1 = RECTANGLE W ASPECT >= 2.5
SETLAYER  X2 = W TOUCH (HOLES W)
SETLAYER  X = X1 OR X2
SETLAYER  Y = (V${j}FUSE_RING OR V${j}S) OR X
OUTLAYER  (NOT RECTANGLE (V${j}i NOT Y) == 0.26 BY == 0.26) NOT INSIDE MARKS
} 
RULECHECK V${j}_2 {
@ Space between two Vns is >= 0.26um
OUTLAYER  EXT V${j} < 0.26 ABUT<90 SINGULAR REGION
}
RULECHECK V${j}_3_4 {
@ Vn must fully enclosed by Mn is >= 0.01um.
@ For Vn at the 90 degree corner enclosed by Mn, Mn enclose at least 0.06um along one direction outside Vn
SETLAYER  X = RECTANGLE ENC V${j} M${j} ABUT<90 OUTSIDE ALSO \
  GOOD 0.01 OPPOSITE 0.06 OPPOSITE 0.01 OPPOSITE 0.06 OPPOSITE
OUTLAYER  ENC X M${j} < 0.01 ABUT<90 SINGULAR OVERLAP OUTSIDE ALSO

SETLAYER  Y = ENC \[x\] M${j} < 0.06 OPPOSITE
OUTLAYER  INT Y < 0.01 ABUT==90 INTERSECTING ONLY
}

RULECHECK V${j}_6 {
@ It's not allowed Vn overlap with Mn or Mn+1 resistor.
@ Mn resistor definition: (Mn AND MnR).
@ Mn+1 resistor definition: (Mn+1 AND Mn+1R).
  OUTLAYER V${j} AND M[expr $j+1]RES
  OUTLAYER V${j} AND M${j}RES
}
}


VERBATIM {
//==================
//  TV - Via DRC
//==================
}
GROUP G[lindex $via_list end] [lindex $via_list end]_?

RULECHECK [lindex $via_list end]_1 {
@ Top via width (top via must be square) 	=	0.36	um
SETLAYER  W = [lindex $via_list end]i INSIDE ((TAPi TOUCH (HOLES TAPi)) AND EXCLU)
SETLAYER  X1 = RECTANGLE W ASPECT >= 2.5
SETLAYER  X2 = W TOUCH (HOLES W)
SETLAYER  X = X1 OR X2
SETLAYER  Y = ([lindex $via_list end]FUSE_RING OR [lindex $via_list end]S) OR X
OUTLAYER  (NOT RECTANGLE ([lindex $via_list end]i NOT Y) == 0.36 BY == 0.36) NOT INSIDE MARKS
}
RULECHECK [lindex $via_list end]_2 {
@ Top via space >= 0.35um
OUTLAYER  EXT [lindex $via_list end] < 0.35 ABUT<90 SINGULAR REGION
}
RULECHECK [lindex $via_list end]_3_4 {
@ Top via must fully enclosed by Top metal-1 is >= 0.01um.
@ Enclosure of Mn-1 over TV along metal line direction is >= 0.06um
@ For Top via located at the 90 degree corner, one side of metal extension must be
@ treated as end-of-line and the other side follows TV.3.
SETLAYER  X = RECTANGLE ENC [lindex $via_list end] [lindex $metal_list end-1] ABUT<90  OUTSIDE ALSO\
  GOOD 0.01 OPPOSITE 0.06 OPPOSITE 0.01 OPPOSITE 0.06 OPPOSITE
OUTLAYER  ENC X [lindex $metal_list end-1] < 0.01 ABUT<90 SINGULAR OVERLAP OUTSIDE ALSO

SETLAYER  Y = ENC \[x\] [lindex $metal_list end-1] < 0.06 OPPOSITE
OUTLAYER  INT Y < 0.01 ABUT==90 INTERSECTING ONLY
}
RULECHECK [lindex $via_list end]_6 {
@ It's not allowed Top via overlap with Mn or Top metal resistor.
@ Mn & Top metal resistor definition: (Mn AND MnR).

 OUTLAYER [lindex $via_list end] AND M${j}RES
 OUTLAYER [lindex $via_list end] AND M[expr $j+1]RES
}


VERBATIM {
//=====================================
//  Mn - Metal n DRC (for inter metal)
//=====================================

GROUP GM1 M1_?

M1_1 {
@ M1 width is >= 0.23um, exclude SRAM region.
  (INT M1_all < 0.23 ABUT<90 SINGULAR REGION) NOT INSIDE SRAM
}
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES 
}

RULECHECK M1_1a_R {
@ M1 width is <= 35.00um
@ (Metal maximum width rule exclude bonding pad, DUPMK1 and MIM region)
SETLAYER  X = M1_all NOT (PA OR (DUPMK1 OR MIM))
OUTLAYER  SIZE X BY 17.5 UNDEROVER
}
VERBATIM {
#ENDIF
}

VERBATIM {
M1_2 {
@ Space between two M1 regions is >= 0.23um,exclude SRAM region.
  (EXT M1_all < 0.23 ABUT<90 SINGULAR REGION) NOT INSIDE SRAM
}
M1_3_4 {
@ Enclosure of M1 region over CT region is >= 0.005um, exclude SRAM region.
@ Enclosure of M1 line end region beyond CT region is >= 0.06um. For CT at 90 degree corner, one side must be considered as line end region, exclude SRAM region.
  X = RECTANGLE ENC CT M1 ABUT<90 OUTSIDE ALSO
  GOOD 0.005 OPPOSITE 0.06 OPPOSITE 0.005 OPPOSITE 0.06 OPPOSITE
  (ENC X M1 < 0.005 ABUT<90 SINGULAR OVERLAP OUTSIDE ALSO REGION) NOT INSIDE SRAM

  Y = ENC [x] M1 < 0.06 OPPOSITE
  (INT Y < 0.01 ABUT==90 INTERSECTING ONLY REGION) NOT INSIDE SRAM
}
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES 

M1_4a_R	{
@ Enclosure of M1 line end region,	>=	0.06	um
@ (An edge between two outer vertexes with length (W) <0.38um, and the both neighboring edges(A1,A2)>= 0.9um) beyond CT region (exclude SRAM region)
  M1_EDGE = CONVEX EDGE M1 ANGLE1 == 90  LENGTH1 >= 0.9 ANGLE2 == 90 LENGTH2 >= 0.9 WITH LENGTH < 0.38
  X = ENC CT M1_EDGE < 0.06 ABUT < 90 REGION
  X NOT INSIDE SRAM
}
M1_4b_R	{
@ Enclosure of M1 line end region,	>=	0.06	um
@ (An edge between two outer vertexes with length (W) <0.38um, and the both neighboring edges(A1,A2)>= 0.9um) beyond V1 region (exclude SRAM region)	>=	0.06	um
  M1_EDGE = CONVEX EDGE M1 ANGLE1 == 90  LENGTH1 >= 0.9 ANGLE2 == 90 LENGTH2 >= 0.9 WITH LENGTH < 0.38
  X = ENC V1 M1_EDGE < 0.06 ABUT < 90 REGION
  X NOT INSIDE SRAM
}
#ENDIF
}
VERBATIM {
#IFDEF NW_space_check 180
}

RULECHECK M1_5 {
@ Space between M1 lines with one or both metal line width and length are greater than 10um is >= 0.60um.
@ The minimum space must be maintained between a metal line and a small piece of metal (< 10um) that is
@ connected to the wide metal within 1.00um range from the wide metal
SETLAYER  X = SIZE M1OVER10 BY 1.0 STEP 0.148 INSIDE OF WIDE_M1
SETLAYER  A = EXT X M1 < 0.60 ABUT<90 SINGULAR REGION
SETLAYER  A1 = size A BY 0.001 TRUNCATE 0.001
SETLAYER  A2 = A1 AND M1
SETLAYER  B = A TOUCH A2 == 1
SETLAYER  C = A NOT B

SETLAYER  X1 = M1 WITH WIDTH > 10 
SETLAYER  Y = SIZE X1 BY 1 STEP 0.2 INSIDE OF M1 
SETLAYER  Z = EXT M1 Y < 0.6 ABUT<90 SINGULAR REGION OPPOSITE
OUTLAYER  (C OR Z) NOT (HOLES M1 INNER EMPTY)
}

VERBATIM {
#ENDIF
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
#IFDEF NW_space_check 153
#IFDEF 153_shrink_check YES
}

RULECHECK M1_5a_R {
@ Space between M1 lines with one or both metal line width and length are greater than 8.5um is >= 0.50um.
@ The minimum space must be maintained between a metal line and a small piece of metal (<8.5um) that is
@ connected to the wide metal within 1.00um range from the wide metal
@ (This rule is only used for the design that it will be shrinkage from 0.18um to 0.153um. Designer can waive this rule for 0.18um design only.)
SETLAYER  X = SIZE M1OVER10 BY 1.0 STEP 0.148 INSIDE OF WIDE_M1
SETLAYER  A = EXT X M1 < 0.50 ABUT<90 SINGULAR REGION
SETLAYER  A1 = size A BY 0.001 TRUNCATE 0.001
SETLAYER  A2 = A1 AND M1
SETLAYER  B = A TOUCH A2 == 1
SETLAYER  C = A NOT B

SETLAYER  X1 = M1 WITH WIDTH > 8.5 
SETLAYER  Y = SIZE X1 BY 1 STEP 0.2 INSIDE OF M1 
SETLAYER  Z = EXT M1 Y < 0.5 ABUT<90 SINGULAR REGION OPPOSITE 
OUTLAYER  (C OR Z) NOT (HOLES M1 INNER EMPTY)
}
VERBATIM {
#ENDIF
#ENDIF
#ENDIF
}

VERBATIM {
M1_6 {
@ M1 area is >= 0.20um
  AREA M1_all < 0.20
}
#IFDEF DENSITY_CHECK YES
M1_7 { 
@ M1 density is >= 30%. 
@ Density is calculated as total metal layout area/chip area
@ Dummy pattern is required for those with M1 density less than 30%
  DENSITY M1i_all < 0.3 PRINT density_report_M1_7.log
}
#ENDIF
}

VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
#IFDEF DENSITY_CHECK YES
}
RULECHECK M1_7a_R { 
@ M1 density across full chip is <= 75%. 
OUTLAYER  DENSITY M1i_all > 0.75 PRINT density_report_M1_7a_R.log
}
VERBATIM {
#ENDIF
#ENDIF
}
#//; M1_8_NC { @ For dummy metal pattern, please check SMIC dummy rule }



#--- For M2 ~ Mn-1 ('n'=total metal counts) DRC check rule ------------------------------
for { set j 2 } { 1 <= [expr $metal_counts -$j] } { incr j } {

GROUP GM${j} M${j}_?

RULECHECK M${j}_1 {
@ Mn-1 width is >= 0.28um
OUTLAYER  INT M${j}_all < 0.28 ABUT<90 SINGULAR REGION
}

VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
}

RULECHECK M${j}_1a_R {
@ Mn-1 width is <= 35.00um
@ (Metal maximum width rule exclude bonding pad, DUPMK1 and MIM region)
SETLAYER  X = M${j}_all NOT (PA OR (DUPMK1 OR MIM))
OUTLAYER  SIZE X BY 17.5 UNDEROVER
}
VERBATIM {
#ENDIF
}

RULECHECK M${j}_2 {
@ Space between two Mn-1 regions is >= 0.28um
OUTLAYER  EXT M${j}_all < 0.28 ABUT<90 SINGULAR REGION
}
RULECHECK M${j}_3_4 {
@ Vn-1 must fully enclosed by Mn is >= 0.01um
@ Extension of Mn line end region beyond Vn-2 region is >= 0.06um
@ For Vn-2 located at 90 degree corner, one side of metal extension must be treated as end-of-line, the other side follow Mn-1.3 
SETLAYER  X = RECTANGLE ENC V[expr ${j} -1] M${j} ABUT<90 OUTSIDE ALSO \
  GOOD 0.01 OPPOSITE 0.06 OPPOSITE 0.01 OPPOSITE 0.06 OPPOSITE
OUTLAYER  ENC X M${j} < 0.01 ABUT<90 SINGULAR OVERLAP OUTSIDE ALSO

SETLAYER  Y = ENC \[x\] M${j} < 0.06 OPPOSITE
OUTLAYER  INT Y < 0.01 ABUT==90 INTERSECTING ONLY
}
VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES 
}
RULECHECK M${j}_4a_R {
@ Extension of Mn line end region  
@ (An edge between two outer vertexes with length (W) <0.38um, and the both neighboring edges(A1,A2)>= 0.9um) beyond Vn-1 region 	>=	0.06	um
   SETLAYER M${j}_EDGE = CONVEX EDGE M${j} ANGLE1 == 90  LENGTH1 >= 0.9 ANGLE2 == 90 LENGTH2 >= 0.9 WITH LENGTH < 0.38
   SETLAYER X = ENC V[expr ${j} -1] M${j}_EDGE < 0.06 ABUT < 90 REGION
   OUTLAYER X NOT INSIDE SRAM
}
RULECHECK M${j}_4b_R {
@ Extension of Mn line end region  
@ (An edge between two outer vertexes with length (W) <0.38um, and the both neighboring edges(A1,A2)>= 0.9um) beyond Vn region 	>=	0.06	um
   SETLAYER M${j}_EDGE = CONVEX EDGE M${j} ANGLE1 == 90  LENGTH1 >= 0.9 ANGLE2 == 90 LENGTH2 >= 0.9 WITH LENGTH < 0.38
   SETLAYER X = ENC V${j} M${j}_EDGE < 0.06 ABUT < 90 REGION
   OUTLAYER X NOT INSIDE SRAM
}
VERBATIM {
#ENDIF
}

VERBATIM {
#IFDEF NW_space_check 180
}
RULECHECK M${j}_5 {
@ Minimum space between Mn-1 lines with one or both metal line width and length are greater than 10um is 0.60um;
@ The minimum space must be maintained between a metal line and a small piece of metal(<10) that is connected
@ to the wide metal within 1.0um range from the wide metal.
SETLAYER  X = SIZE M${j}OVER10 BY 1.0 STEP 0.148 INSIDE OF WIDE_M${j}
SETLAYER  A = EXT X M${j} < 0.60 ABUT<90 SINGULAR REGION
SETLAYER  A1 = size A BY 0.001 TRUNCATE 0.001
SETLAYER  A2 = A1 AND M${j}
SETLAYER  B = A TOUCH A2 == 1
SETLAYER  C = A NOT B

SETLAYER  X1 = M${j} WITH WIDTH > 10 
SETLAYER  Y = SIZE X1 BY 1 STEP 0.2 INSIDE OF M${j} 
SETLAYER  Z = EXT M${j} Y < 0.6 ABUT<90 SINGULAR REGION OPPOSITE 
OUTLAYER  (C OR Z) NOT (HOLES M${j} INNER EMPTY)
}
VERBATIM {
#ENDIF
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
#IFDEF NW_space_check 153
#IFDEF 153_shrink_check YES
}
RULECHECK M${j}_5a_R {
@ Minimum space between Mn-1 lines with one or both metal line width and length are greater than 8.5um is 0.50um;
@ The minimum space must be maintained between a metal line and a small piece of metal(<8.5) that is connected
@ to the wide metal within 1.0um range from the wide metal.
SETLAYER  X = SIZE M${j}OVER10 BY 1.0 STEP 0.148 INSIDE OF WIDE_M${j}
SETLAYER  A = EXT X M${j} < 0.50 ABUT<90 SINGULAR REGION
SETLAYER  A1 = size A BY 0.001 TRUNCATE 0.001
SETLAYER  A2 = A1 AND M${j}
SETLAYER  B = A TOUCH A2 == 1
SETLAYER  C = A NOT B

SETLAYER  X1 = M${j} WITH WIDTH > 8.5 
SETLAYER  Y = SIZE X1 BY 1 STEP 0.2 INSIDE OF M${j}
SETLAYER  Z = EXT M${j} Y < 0.5 ABUT<90 SINGULAR REGION OPPOSITE 
OUTLAYER  (C OR Z) NOT (HOLES M${j} INNER EMPTY)
}
VERBATIM {
#ENDIF
#ENDIF
#ENDIF
}

RULECHECK M${j}_6 {
@ Mn-1 area is >= 0.20um
OUTLAYER  AREA M${j}_all < 0.20
}
VERBATIM {
#IFDEF DENSITY_CHECK YES
}
RULECHECK M${j}_7 {
@ Mn-1 density is >= 30%. 
@ Density is calculated as total metal layout area/chip area
@ Dummy pattern is required for those with Mn-1 density less than 30%
OUTLAYER  DENSITY M${j}i_all < 0.3 PRINT density_report_M${j}_7.log
}
VERBATIM {
#ENDIF
}
VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
#IFDEF DENSITY_CHECK YES
}
RULECHECK M${j}_7a_R { 
@ Mn-1 density across full chip is <= 75%. 
OUTLAYER  DENSITY M${j}i_all > 0.75 PRINT density_report_M${j}_7a_R.log
}
VERBATIM {
#ENDIF
#ENDIF
}
#//; M${j}_8_NC {
#//; @ As to metal dummy pattern, please check SMIC Dummy rule }
}



VERBATIM {
//============================
//  MT - Top Metal-Metal DRC
//============================
LAYER MAP 9999 DATATYPE 1113 9688
LAYER EMPTY3 9688
}

foreach j $metal_list {
SETLAYER ${j}_D = EMPTY3 OR ${j}0
}
foreach j $via_list {
SETLAYER ${j}_D = EMPTY3 OR ${j}i
}

SETLAYER MT_IND = [lindex $metal_list end]0 AND INDMY
SETLAYER MT_IND_D = EMPTY3 OR MT_IND

for { set j 1 } { 1 <= [expr $metal_counts -$j] } { incr j } {
CONNECT M[expr ${j} +1]_D M${j}_D BY V${j}_D
}

CONNECT MT_IND_D [lindex $metal_list end]_D


if { [string equal $top_metal MT] == 1 } {

GROUP GMT MT_?

RULECHECK MT_1 {
@ MT width is >= 0.44um
OUTLAYER  INT [lindex $metal_list end]_all < 0.44 ABUT<90 SINGULAR REGION
}

VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
}

RULECHECK MT_1a_R {
@ MT width is <= 35.00um
@ (Metal maximum width rule exclude bonding pad, DUPMK1 and MIM region)
SETLAYER  X = [lindex $metal_list end]_all NOT (PA OR (DUPMK1 OR MIM))
OUTLAYER  SIZE X BY 17.5 UNDEROVER
}
VERBATIM {
#ENDIF
}

RULECHECK MT_2 {
@ Space between two MTs is >= 0.46um
OUTLAYER  EXT [lindex $metal_list end]_all < 0.46 ABUT<90 SINGULAR REGION
}
RULECHECK MT_3 {
@ Top via must fully enclosed by MT is >= 0.09um.
OUTLAYER  ENC [lindex $via_list end] [lindex $metal_list end] < 0.09 ABUT<90 SINGULAR REGION OUTSIDE ALSO
}

VERBATIM {
#IFDEF NW_space_check 180
}
RULECHECK MT_4 {
@ Space between MT lines with one or both MT line width and length are greater than 10um is >= 0.60um; 
@ this also includes all metals attached to these areas or extending out for a distance of 1.00um or less
SETLAYER  X = SIZE [lindex $metal_list end]OVER10 BY 1.0 STEP 0.148 INSIDE OF WIDE_[lindex $metal_list end]
SETLAYER  A = EXT X [lindex $metal_list end] < 0.60 ABUT<90 SINGULAR REGION 
SETLAYER  A1 = size A BY 0.001 TRUNCATE 0.001 
SETLAYER  A2 = A1 AND [lindex $metal_list end] 
SETLAYER  B = A TOUCH A2 == 1 
SETLAYER  C = A NOT B

SETLAYER  X1 = [lindex $metal_list end] WITH WIDTH > 10 
SETLAYER  Y = SIZE X1 BY 1 STEP 0.2 INSIDE OF [lindex $metal_list end]
SETLAYER  Z = EXT [lindex $metal_list end] Y < 0.6 ABUT<90 SINGULAR REGION OPPOSITE 
OUTLAYER  (C OR Z) NOT (HOLES [lindex $metal_list end] INNER EMPTY)
}
VERBATIM {
#ENDIF
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
#IFDEF NW_space_check 153
#IFDEF 153_shrink_check YES
}

RULECHECK MT_4a_R {
@ Space between MT lines with one or both MT line width and length are greater than 8.5um is >= 0.50um; 
@ this also includes all metals attached to these areas or extending out for a distance of 1.00um or less
@ (This rule is only used for the design that it will be shrinkage from 0.18um to 0.153um. Designer can waive this rule for 0.18um design only. DRC default switch turn-off for 0.18um design only)
SETLAYER  X = SIZE [lindex $metal_list end]OVER10 BY 1.0 STEP 0.148 INSIDE OF WIDE_[lindex $metal_list end]
SETLAYER  A = EXT X [lindex $metal_list end] < 0.50 ABUT<90 SINGULAR REGION 
SETLAYER  A1 = size A BY 0.001 TRUNCATE 0.001 
SETLAYER  A2 = A1 AND [lindex $metal_list end]
SETLAYER  B = A TOUCH A2 == 1 
SETLAYER  C = A NOT B

SETLAYER  X1 = [lindex $metal_list end] WITH WIDTH > 8.5 
SETLAYER  Y = SIZE X1 BY 1 STEP 0.2 INSIDE OF [lindex $metal_list end]
SETLAYER  Z = EXT [lindex $metal_list end] Y < 0.5 ABUT<90 SINGULAR REGION OPPOSITE 
OUTLAYER  (C OR Z) NOT (HOLES [lindex $metal_list end] INNER EMPTY)
}
VERBATIM {
#ENDIF
#ENDIF
#ENDIF
}

RULECHECK MT_5 {
@ MT area is >= 0.56um*um
OUTLAYER  AREA [lindex $metal_list end]_all < 0.56
} 
VERBATIM {
#IFDEF DENSITY_CHECK YES
}
RULECHECK MT_6 { 
@ MT density is >= 30%
@ Density is calculated as total metal layout area/chip area
@ Dummy pattern is required for those with MT density less than 30%
OUTLAYER  DENSITY [lindex $metal_list end]i_all < 0.3 PRINT density_report_MT_6.log
}
VERBATIM {
#ENDIF
}
VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
#IFDEF DENSITY_CHECK YES
}
RULECHECK MT_6a_R { 
@ MT density across full chip is <= 75%. 
OUTLAYER  DENSITY [lindex $metal_list end]i_all > 0.75 PRINT density_report_MT_6a_R.log
}
VERBATIM {
#ENDIF
#ENDIF
}
#//; MT_7_NC: As to MT dummy pattern, please check SMIC Dummy rule. 


} elseif { [string equal $top_metal MTT] == 1 } {

VERBATIM {
//==========================================
//  MTT -(Metal use 2.2um Thick Top Metal) DRC
//==========================================
}

GROUP GMTT MTT_?

RULECHECK MTT_1 {
@ MTT width is >= 1.50um
OUTLAYER  INT [lindex $metal_list end]_all < 1.5 ABUT<90 SINGULAR REGION
}

VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES 
}
RULECHECK MTT_1a_R {
@ MTT width is <= 35.00um
@ (Metal maximum width rule exclude bonding pad, DUPMK1 and MIM region)
SETLAYER  X = [lindex $metal_list end]_all NOT (PA OR (DUPMK1 OR MIM))
OUTLAYER  SIZE X BY 17.5 UNDEROVER
}
VERBATIM {
#ENDIF
}

RULECHECK MTT_2a {
@ Space between two MTTs is >= 1.50um
OUTLAYER  EXT [lindex $metal_list end]_all < 1.5 ABUT<90 SINGULAR REGION
}
RULECHECK MTT_2b {
@ Space between two MTTs when one or both MTTs widths are >= 16um is >= 3.00um
SETLAYER  X = ([lindex $metal_list end] WITH WIDTH >= 16) COIN EDGE [lindex $metal_list end]
OUTLAYER  EXT X [lindex $metal_list end] < 3 ABUT<90 REGION
}
RULECHECK MTT_3_4 {
@ TV must fully enclosed by MTT is >= 0.30um.
@ MTT extension outside of TV at the end of MTT is >= 0.42um. 
SETLAYER  X = RECTANGLE ENC [lindex $via_list end] [lindex $metal_list end] ABUT<90 OUTSIDE ALSO \
  GOOD 0.3 OPPOSITE 0.42 OPPOSITE 0.3 OPPOSITE 0.42 OPPOSITE
OUTLAYER  ENC X [lindex $metal_list end] < 0.3 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO 
SETLAYER  Y = ENC \[X\] [lindex $metal_list end] < 0.42 OPPOSITE
OUTLAYER  INT Y < 0.005 ABUT==90 INTERSECTING ONLY REGION
OUTLAYER  [lindex $via_list end] NOT [lindex $metal_list end]
}
RULECHECK MTT_5 { 
@ Space between an inductor MTT and other MTTs(including Inductor MTT) is >= 50.00um
OUTLAYER  EXT MT_IND_D [lindex $metal_list end]_D < 50 ABUT<90 SINGULAR REGION NOT CONNECTED
}
RULECHECK MTT_6 {
@ MTT area is >= 2.25um
OUTLAYER  AREA [lindex $metal_list end]_all < 2.25 
}

VERBATIM {
#IFDEF DENSITY_CHECK YES
}
RULECHECK MTT_7 { 
@ MTT density is >= 30%
OUTLAYER  DENSITY [lindex $metal_list end]i_all < 0.3 PRINT density_report_MTT_7.log
}
VERBATIM {
#ENDIF
}
VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
#IFDEF DENSITY_CHECK YES
}
RULECHECK MTT_7b_R { 
@ MTT density across full chip is <= 75%. 
OUTLAYER  DENSITY [lindex $metal_list end]i_all > 0.75 PRINT density_report_MTT_7b_R.log
}
VERBATIM {
#ENDIF
#ENDIF
}

RULECHECK MTT_8 { 
@ Both active and passive devices inside Inductor region which defined by INDMY are not allowed
SETLAYER  X = OR GATE RESAA RESNW RESP1 RESP3T DSTR HRPDMY MIM MIMDMY MOMDMY DMPNP VARMOS M1R M2R M3R M4R M5R M6R
OUTLAYER  X AND INDMY
}
RULECHECK MTT_9 { 
@ Extension of dummy layer "INDMY" beyond MTT region used as Inductor is >= 50.00um
SETLAYER  X = [lindex $metal_list end] INTERACT INDMY
OUTLAYER  ENC X INDMY < 50 ABUT<90 SINGULAR REGION
}
#//; MTT_7a_NC_R: Dummy MTT pattern suggested 2 X 5um with line space 2.0um is /@ required if density less than 30%.
#//; MTT_10_NC: No Via and metal layers inside "INDMY" is allowed except Inductor connection.


} elseif { [string equal $top_metal MTT1] == 1 } {

VERBATIM {
//=============================================
//  MTT1 -(Metal use 3.41um Thick Top Metal) DRC
//=============================================
}

GROUP GMTT1 MTT1_?

RULECHECK MTT1_1 {
@ MTT1 width is >= 1.80um
OUTLAYER  INT [lindex $metal_list end]_all < 1.8 ABUT<90 SINGULAR REGION
}

VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
}
RULECHECK MTT1_1a_R {
@ MTT1 width is <= 35.00um
@ (Metal maximum width rule exclude bonding pad, DUPMK1 and MIM region)
SETLAYER  X = [lindex $metal_list end]_all NOT (PA OR (DUPMK1 OR MIM))
OUTLAYER  SIZE X BY 17.5 UNDEROVER
}
VERBATIM {
#ENDIF
}

RULECHECK MTT1_2a {
@ Space between two MTT1s is >= 1.80um
OUTLAYER  EXT [lindex $metal_list end]_all < 1.8 ABUT<90 SINGULAR REGION
}
RULECHECK MTT1_2b {
@ Space between two MTT1s when one or both MTT1s widths are >= 16um is >= 3.00um
SETLAYER  X = ([lindex $metal_list end] WITH WIDTH >= 16) COIN EDGE [lindex $metal_list end]
OUTLAYER  EXT X [lindex $metal_list end] < 3 ABUT<90 REGION
}
RULECHECK MTT1_3_4 {
@ TV must fully enclosed by MTT1 is >= 0.25um.
@ MTT1 extension outside of TV at the end of MTT1 is >= 0.42um.
@ (extension of MTT2 line end outside of TV is 0.42 For TV located at the 90 degree corner, 
@ one side of metal extension must be treated as end-of-line and the other side follows 0.25), exclude Metal fuse area
SETLAYER  X = RECTANGLE ENC [lindex $via_list end] [lindex $metal_list end] ABUT<90 OUTSIDE ALSO\
  GOOD 0.25 OPPOSITE 0.42 OPPOSITE 0.25 OPPOSITE 0.42 OPPOSITE
OUTLAYER  (ENC X [lindex $metal_list end] < 0.25 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO) NOT INSIDE FUSEMK1

SETLAYER  Y = ENC \[X\] [lindex $metal_list end] < 0.42 OPPOSITE
OUTLAYER  (INT Y < 0.005 ABUT==90 INTERSECTING ONLY REGION) NOT INSIDE FUSEMK1
OUTLAYER  ([lindex $via_list end] NOT [lindex $metal_list end]) NOT INSIDE FUSEMK1
}
RULECHECK MTT1_5 { 
@ Space between an inductor MTT1 and other MTT1s(including Inductor MTT1) is >= 50.00um
OUTLAYER  EXT MT_IND_D [lindex $metal_list end]_D < 50 ABUT<90 SINGULAR REGION NOT CONNECTED
}
RULECHECK MTT1_6 {
@ MTT1 area is >= 3.24um
OUTLAYER  AREA [lindex $metal_list end] < 3.24 
}
VERBATIM {
#IFDEF DENSITY_CHECK YES
}
RULECHECK MTT1_7 { 
@ MTT1 density is >= 30%
OUTLAYER  DENSITY [lindex $metal_list end]i_all < 0.3  PRINT density_report_MTT1_7.log
}
VERBATIM {
#ENDIF
}
VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
#IFDEF DENSITY_CHECK YES
}
RULECHECK MTT1_7b_R { 
@ MTT1 density across full chip is <= 75%. 
OUTLAYER  DENSITY [lindex $metal_list end]i_all > 0.75 PRINT density_report_MTT1_7b_R.log
}
VERBATIM {
#ENDIF
#ENDIF
}

RULECHECK MTT1_8 { 
@ Both active and passive devices inside Inductor region which defined by INDMY are not allowed
SETLAYER  X = OR GATE RESAA RESNW RESP1 RESP3T DSTR HRPDMY MIM MIMDMY MOMDMY DMPNP VARMOS M1R M2R M3R M4R M5R M6R
OUTLAYER  X AND INDMY
}
RULECHECK MTT1_9 { 
@ Extension of dummy layer "INDMY" beyond MTT1 region used as Inductor is >= 50.00um
SETLAYER  X = [lindex $metal_list end] INTERACT INDMY
OUTLAYER  ENC X INDMY < 50 ABUT<90 SINGULAR REGION
}
#//; MTT1_7a_NC_R: Dummy MTT1 pattern suggested 2 X 5um with line space 2.0um is required if density < 30%.
#//; MTT1_10_NC: No Via and metal layers inside "INDMY" is allowed except Inductor connection.


} elseif { [string equal $top_metal MTT2] == 1 } {

VERBATIM {
//=============================================
//  MTT2 -(Metal use 4.11um Thick Top Metal) DRC
//=============================================
}


GROUP GMTT2 MTT2_?

RULECHECK MTT2_1 {
@ MTT2 width is >= 2.60um
OUTLAYER  INT [lindex $metal_list end]_all < 2.6 ABUT<90 SINGULAR REGION
}

VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
}
RULECHECK MTT2_1a_R {
@ MTT2 width is <= 35.00um
@ (Metal maximum width rule exclude bonding pad, DUPMK1 and MIM region)
SETLAYER  X = [lindex $metal_list end]_all NOT (PA OR (DUPMK1 OR MIM))
OUTLAYER  SIZE X BY 17.5 UNDEROVER
}
VERBATIM {
#ENDIF
}

RULECHECK MTT2_2a {
@ Space between two MTT2s is >= 2.50um
OUTLAYER  EXT [lindex $metal_list end]_all < 2.5 ABUT<90 SINGULAR REGION
}
RULECHECK MTT2_2b {
@ Space between two MTT2s when one or both MTT2s widths are >= 16um is >= 4.00um
SETLAYER  X = ([lindex $metal_list end] WITH WIDTH >= 16) COIN EDGE [lindex $metal_list end]
OUTLAYER  EXT X [lindex $metal_list end] < 4 ABUT<90 REGION
}
RULECHECK MTT2_3_4 {
@ TV must fully enclosed by MTT2 is >= 0.40um.
@ MTT2 extension outside of TV at the end of MTT2 is >= 0.45um.
@ (extension of MTT2 line end outside of TV is 0.45 For TV located at the 90 degree corner, 
@ one side of metal extension must be treated as end-of-line and the other side follows 0.4), exclude Metal fuse area
SETLAYER  X = RECTANGLE ENC [lindex $via_list end] [lindex $metal_list end] ABUT<90 OUTSIDE ALSO \
  GOOD 0.4 OPPOSITE 0.45 OPPOSITE 0.4 OPPOSITE 0.45 OPPOSITE
OUTLAYER  (ENC X [lindex $metal_list end] < 0.4 ABUT<90 SINGULAR REGION OVERLAP OUTSIDE ALSO) NOT INSIDE FUSEMK1

SETLAYER  Y = ENC \[X\] [lindex $metal_list end] < 0.45 OPPOSITE
OUTLAYER  (INT Y < 0.005 ABUT==90 INTERSECTING ONLY REGION) NOT INSIDE FUSEMK1
OUTLAYER  ([lindex $via_list end] NOT [lindex $metal_list end]) NOT INSIDE FUSEMK1
}
RULECHECK MTT2_5 { 
@ Space between an inductor MTT2 and other MTT2s(including Inductor MTT2) is >= 50.00um
OUTLAYER  EXT MT_IND_D [lindex $metal_list end]_D < 50 ABUT<90 SINGULAR REGION NOT CONNECTED
}
RULECHECK MTT2_6 {
@ MTT2 area is >= 6.76um
OUTLAYER  AREA [lindex $metal_list end] < 6.76 
}
VERBATIM {
#IFDEF DENSITY_CHECK YES
}
RULECHECK MTT2_7 { 
@ MTT2 density is >= 30%
OUTLAYER  DENSITY [lindex $metal_list end]i_all < 0.3 PRINT density_report_MTT2_7.log 
}
VERBATIM {
#ENDIF
}
VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
#IFDEF DENSITY_CHECK YES
}
RULECHECK MTT2_7b_R { 
@ MTT2 density across full chip is <= 75%. 
OUTLAYER  DENSITY [lindex $metal_list end]i_all > 0.75 PRINT density_report_MTT2_7b_R.log
}
VERBATIM {
#ENDIF
#ENDIF
}

RULECHECK MTT2_8 { 
@ Both active and passive devices inside Inductor region which defined by INDMY are not allowed
SETLAYER  X = OR GATE RESAA RESNW RESP1 RESP3T DSTR HRPDMY MIM MIMDMY MOMDMY DMPNP VARMOS M1R M2R M3R M4R M5R M6R
OUTLAYER  X AND INDMY
}
RULECHECK MTT2_9 { 
@ Extension of dummy layer "INDMY" beyond MTT2 region used as Inductor is >= 50.00um
SETLAYER  X = [lindex $metal_list end] INTERACT INDMY
OUTLAYER  ENC X INDMY < 50 ABUT<90 SINGULAR REGION
}
#//; MTT2_7a_NC_R: Dummy MTT2 pattern suggested 3 X 6um with line space 3.0um is required if density less than 30%.
#//; MTT2_10_NC: No Via and metal layers inside "INDMY" is allowed except Inductor connection.
}


#=================================
#  Metal and Via stack Rule Check
#=================================


#to define 2-level via stack
for {set i 1} {$i <= [expr $metal_counts - 2]} {incr i} {
setlayer M[expr ${i} +1]M[expr ${i} + 2] = M[expr ${i} + 1] AND M[expr ${i} + 2]
setlayer ${i}V${i}_check = V${i} INSIDE M[expr ${i} +1]M[expr ${i} + 2]
setlayer ${i}V[expr ${i} + 1]_check = V[expr ${i} + 1] INSIDE M[expr ${i} + 1]M[expr ${i} + 2]


#//single layer Via array
#//Via density ?

#V1 array
setlayer ${i}V${i}_size1 = ( SIZE ${i}V${i}_check BY 2.5 INSIDE OF M[expr ${i} + 1]M[expr ${i} + 2] step 0.28 ) AND M[expr ${i} + 1]M[expr ${i} + 2]
setlayer ${i}V${i}_size2 = SIZE ${i}V${i}_check BY 2.5 OVERUNDER
setlayer ${i}V${i}_size = ${i}V${i}_size1 AND ${i}V${i}_size2
setlayer ${i}V${i}_s = ${i}V${i}_check INTERACT ${i}V${i}_size
setlayer ${i}V${i}_s_a = SIZE ${i}V${i}_s BY 2.5 OVERUNDER
setlayer ${i}V${i}_A = ${i}V${i}_s_a AND ${i}V${i}_size1
setlayer ${i}V${i}_A_size1 = SIZE ${i}V${i}_A BY 5 INSIDE OF M[expr ${i} + 1]M[expr ${i} + 2] step 0.28
setlayer ${i}V${i}_A_size2 = SIZE ${i}V${i}_A BY 5 OVERUNDER
setlayer ${i}V${i}_A_size = ${i}V${i}_A_size1 AND ${i}V${i}_A_size2
setlayer ${i}V${i}_A_size_c = ${i}V${i}_A_size ENCLOSE RECTANGLE 5 15
setlayer ${i}V${i}_A_s = ${i}V${i}_A INTERACT ${i}V${i}_A_size_c
setlayer ${i}V${i}_A_s_a = SIZE ${i}V${i}_A_s BY 5 OVERUNDER
setlayer ${i}V${i}_AM_s = ( ( ${i}V${i}_A_s_a AND ${i}V${i}_A_size1 ) WITH WIDTH >= 5 ) ENCLOSE RECTANGLE 5 15

setlayer ${i}V${i}_${i}M_edge_X = ANGLE ${i}V${i}_AM_s == 0
setlayer ${i}V${i}_${i}M_edge_Y = ANGLE ${i}V${i}_AM_s == 90
setlayer ${i}V${i}_${i}M_edge_Z = ANGLE ${i}V${i}_AM_s > 44.5 < 45.5


foreach dir { X Y Z} {
setlayer ${i}V${i}_${i}M_edge_${dir}_0.5_acc = ( EXPAND EDGE ${i}V${i}_${i}M_edge_${dir} INSIDE BY 0.5 ) NOT INTERACT V${i}
for { set s 1 } { ${s} <= 8 } { incr s } {
set p [expr ${s}/2.0+0.5]
setlayer ${i}V${i}_${i}M_edge_${dir}_${p} = ( EXPAND EDGE ${i}V${i}_${i}M_edge_${dir} INSIDE BY ${p} ) NOT INTERACT V${i}
setlayer ${i}V${i}_${i}M_edge_${dir}_${p}_acc = ${i}V${i}_${i}M_edge_${dir}_[expr ${p} - 0.5]_acc OR ${i}V${i}_${i}M_edge_${dir}_${p}
}
}
setlayer ${i}V${i}_AM = ENCLOSE RECTANGLE (( ( ${i}V${i}_AM_s NOT ${i}V${i}_${i}M_edge_X_4.5_acc ) NOT ${i}V${i}_${i}M_edge_Y_4.5_acc ) NOT ${i}V${i}_${i}M_edge_Z_4.5_acc) 5 15

#V2 array
setlayer ${i}V[expr ${i} + 1]_size1 = ( SIZE ${i}V[expr ${i} + 1]_check BY 2.5 INSIDE OF M[expr ${i} + 1]M[expr ${i} + 2] step 0.28 ) AND M[expr ${i} + 1]M[expr ${i} + 2]
setlayer ${i}V[expr ${i} + 1]_size2 = SIZE ${i}V[expr ${i} + 1]_check BY 2.5 OVERUNDER
setlayer ${i}V[expr ${i} + 1]_size = ${i}V[expr ${i} + 1]_size1 AND ${i}V[expr ${i} + 1]_size2
setlayer ${i}V[expr ${i} + 1]_s = ${i}V[expr ${i} + 1]_check INTERACT ${i}V[expr ${i} + 1]_size
setlayer ${i}V[expr ${i} + 1]_s_a = SIZE ${i}V[expr ${i} + 1]_s BY 2.5 OVERUNDER
setlayer ${i}V[expr ${i} + 1]_A = ${i}V[expr ${i} + 1]_s_a AND ${i}V[expr ${i} + 1]_size1
setlayer ${i}V[expr ${i} + 1]_A_size1 = SIZE ${i}V[expr ${i} + 1]_A BY 5 INSIDE OF M[expr ${i} + 1]M[expr ${i} + 2] step 0.28
setlayer ${i}V[expr ${i} + 1]_A_size2 = SIZE ${i}V[expr ${i} + 1]_A BY 5 OVERUNDER
setlayer ${i}V[expr ${i} + 1]_A_size = ${i}V[expr ${i} + 1]_A_size1 AND ${i}V[expr ${i} + 1]_A_size2
setlayer ${i}V[expr ${i} + 1]_A_size_c = ${i}V[expr ${i} + 1]_A_size ENCLOSE RECTANGLE 5 15
setlayer ${i}V[expr ${i} + 1]_A_s = ${i}V[expr ${i} + 1]_A INTERACT ${i}V[expr ${i} + 1]_A_size_c
setlayer ${i}V[expr ${i} + 1]_A_s_a = SIZE ${i}V[expr ${i} + 1]_A_s BY 5 OVERUNDER
setlayer ${i}V[expr ${i} + 1]_AM_s = ( ( ${i}V[expr ${i} + 1]_A_s_a AND ${i}V[expr ${i} + 1]_A_size1 ) WITH WIDTH >= 5 ) ENCLOSE RECTANGLE 5 15

setlayer ${i}V[expr ${i} + 1]_${i}M_edge_X = ANGLE ${i}V[expr ${i} + 1]_AM_s == 0
setlayer ${i}V[expr ${i} + 1]_${i}M_edge_Y = ANGLE ${i}V[expr ${i} + 1]_AM_s == 90
setlayer ${i}V[expr ${i} + 1]_${i}M_edge_Z = ANGLE ${i}V[expr ${i} + 1]_AM_s >44.5 < 45.5


foreach dir { X Y Z} {
setlayer ${i}V[expr ${i} + 1]_${i}M_edge_${dir}_0.5_acc = ( EXPAND EDGE ${i}V[expr ${i} + 1]_${i}M_edge_${dir} INSIDE BY 0.5 ) NOT INTERACT V[expr ${i} + 1]
for { set s 1 } { ${s} <= 8 } { incr s } {
set p [expr ${s}/2.0+0.5]
setlayer ${i}V[expr ${i} + 1]_${i}M_edge_${dir}_${p} = ( EXPAND EDGE ${i}V[expr ${i} + 1]_${i}M_edge_${dir} INSIDE BY ${p} ) NOT INTERACT V[expr ${i} + 1]
setlayer ${i}V[expr ${i} + 1]_${i}M_edge_${dir}_${p}_acc = ${i}V[expr ${i} + 1]_${i}M_edge_${dir}_[expr ${p} - 0.5]_acc OR ${i}V[expr ${i} + 1]_${i}M_edge_${dir}_${p}
}
}
setlayer ${i}V[expr ${i} + 1]_AM = ENCLOSE RECTANGLE (( ( ${i}V[expr ${i} + 1]_AM_s NOT ${i}V[expr ${i} + 1]_${i}M_edge_X_4.5_acc ) NOT ${i}V[expr ${i} + 1]_${i}M_edge_Y_4.5_acc ) NOT ${i}V[expr ${i} + 1]_${i}M_edge_Z_4.5_acc) 5 15

setlayer ${i}V${i}[expr ${i} + 1]_AMO_t = ENCLOSE RECTANGLE ( ( SIZE  ( ${i}V${i}_AM AND ${i}V[expr ${i} + 1]_AM ) BY 2.499 UNDEROVER ) AND M[expr ${i} + 1] ) 5 15

if {"V[expr ${i} + 1]" == [lindex $via_list end]} {
setlayer ${i}V${i}[expr ${i} + 1]_AMO = ( density V${i} > [expr 0.26*0.26*1.66/1] INSIDE OF LAYER ${i}V${i}[expr ${i} + 1]_AMO_t ) AND ( density V[expr ${i} + 1] > [expr 0.36*0.36*1.29/1] INSIDE OF LAYER ${i}V${i}[expr ${i} + 1]_AMO_t )
} else {
setlayer ${i}V${i}[expr ${i} + 1]_AMO = ( density V${i} > [expr 0.26*0.26*1.66/1] INSIDE OF LAYER ${i}V${i}[expr ${i} + 1]_AMO_t ) AND ( density V[expr ${i} + 1] > [expr 0.26*0.26*1.66/1] INSIDE OF LAYER ${i}V${i}[expr ${i} + 1]_AMO_t )
}
setlayer ${i}M[expr ${i} + 1]_check = M[expr ${i} + 1] INTERACT ${i}V${i}[expr ${i} + 1]_AMO
setlayer ${i}M[expr ${i} + 1]_big = WITH WIDTH M[expr ${i} + 1] > 2
setlayer ${i}V${i}[expr ${i} + 1]_proj_edge = ( ENC ${i}V${i}[expr ${i} + 1]_AMO \[${i}M[expr ${i} + 1]_big\] <= 10 OPPOSITE EXCLUDE SHIELDED 4 ) OR EDGE ( ${i}V${i}[expr ${i} + 1]_AMO COIN EDGE ${i}M[expr ${i} + 1]_big )
}

#to define 3-stack via array

for {set i 1} {$i <= [expr $metal_counts - 3]} {incr i} {
setlayer ${i}V[expr ${i} + 2]_check = V[expr ${i} + 2] INSIDE M[expr ${i} + 1]M[expr ${i} + 2]

#V3 array
setlayer ${i}V[expr ${i} + 2]_size1 = ( SIZE ${i}V[expr ${i} + 2]_check BY 2.5 INSIDE OF M[expr ${i} + 1]M[expr ${i} + 2] step 0.28 ) AND M[expr ${i} + 1]M[expr ${i} + 2]
setlayer ${i}V[expr ${i} + 2]_size2 = SIZE ${i}V[expr ${i} + 2]_check BY 2.5 OVERUNDER
setlayer ${i}V[expr ${i} + 2]_size = ${i}V[expr ${i} + 2]_size1 AND ${i}V[expr ${i} + 2]_size2
setlayer ${i}V[expr ${i} + 2]_s = ${i}V[expr ${i} + 2]_check INTERACT ${i}V[expr ${i} + 2]_size
setlayer ${i}V[expr ${i} + 2]_s_a = SIZE ${i}V[expr ${i} + 2]_s BY 2.5 OVERUNDER
setlayer ${i}V[expr ${i} + 2]_A = ${i}V[expr ${i} + 2]_s_a AND ${i}V[expr ${i} + 2]_size1
setlayer ${i}V[expr ${i} + 2]_A_size1 = SIZE ${i}V[expr ${i} + 2]_A BY 5 INSIDE OF M[expr ${i} + 1]M[expr ${i} + 2] step 0.28
setlayer ${i}V[expr ${i} + 2]_A_size2 = SIZE ${i}V[expr ${i} + 2]_A BY 5 OVERUNDER
setlayer ${i}V[expr ${i} + 2]_A_size = ${i}V[expr ${i} + 2]_A_size1 AND ${i}V[expr ${i} + 2]_A_size2
setlayer ${i}V[expr ${i} + 2]_A_size_c = ${i}V[expr ${i} + 2]_A_size ENCLOSE RECTANGLE 5 15
setlayer ${i}V[expr ${i} + 2]_A_s = ${i}V[expr ${i} + 2]_A INTERACT ${i}V[expr ${i} + 2]_A_size_c
setlayer ${i}V[expr ${i} + 2]_A_s_a = SIZE ${i}V[expr ${i} + 2]_A_s BY 5 OVERUNDER
setlayer ${i}V[expr ${i} + 2]_AM_s = ( ( ${i}V[expr ${i} + 2]_A_s_a AND ${i}V[expr ${i} + 2]_A_size1 ) WITH WIDTH >= 5 ) ENCLOSE RECTANGLE 5 15

setlayer ${i}V[expr ${i} + 2]_${i}M_edge_X = ANGLE ${i}V[expr ${i} + 2]_AM_s == 0
setlayer ${i}V[expr ${i} + 2]_${i}M_edge_Y = ANGLE ${i}V[expr ${i} + 2]_AM_s == 90
setlayer ${i}V[expr ${i} + 2]_${i}M_edge_Z = ANGLE ${i}V[expr ${i} + 2]_AM_s > 44.5 < 45.5


foreach dir { X Y Z} {
setlayer ${i}V[expr ${i} + 2]_${i}M_edge_${dir}_0.5_acc = ( EXPAND EDGE ${i}V[expr ${i} + 2]_${i}M_edge_${dir} INSIDE BY 0.5 ) NOT INTERACT V[expr ${i} + 2]
for { set s 1 } { ${s} <= 8 } { incr s } {
set p [expr ${s}/2.0+0.5]
setlayer ${i}V[expr ${i} + 2]_${i}M_edge_${dir}_${p} = ( EXPAND EDGE ${i}V[expr ${i} + 2]_${i}M_edge_${dir} INSIDE BY ${p} ) NOT INTERACT V[expr ${i} + 2]
setlayer ${i}V[expr ${i} + 2]_${i}M_edge_${dir}_${p}_acc = ${i}V[expr ${i} + 2]_${i}M_edge_${dir}_[expr ${p} - 0.5]_acc OR ${i}V[expr ${i} + 2]_${i}M_edge_${dir}_${p}
}
}
setlayer ${i}V[expr ${i} + 2]_AM = ENCLOSE RECTANGLE (( ( ${i}V[expr ${i} + 2]_AM_s NOT ${i}V[expr ${i} + 2]_${i}M_edge_X_4.5_acc ) NOT ${i}V[expr ${i} + 2]_${i}M_edge_Y_4.5_acc ) NOT ${i}V[expr ${i} + 2]_${i}M_edge_Z_4.5_acc) 5 15


setlayer ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_AMO_t = ENCLOSE RECTANGLE ( ( SIZE ( ( ${i}V${i}_AM AND ${i}V[expr ${i} + 1]_AM ) AND ${i}V[expr ${i} + 2]_AM ) BY 2.499 UNDEROVER ) AND M[expr ${i} + 1]M[expr ${i} + 2] ) 5 15

if {"V[expr ${i} + 2]" == [lindex $via_list end]} {
setlayer ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_AMO = ( ( density V${i} > [expr 0.26*0.26*1.66/1] INSIDE OF LAYER ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_AMO_t ) AND ( density V[expr ${i} + 1] > [expr 0.26*0.26*1.66/1] INSIDE OF LAYER ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_AMO_t ) ) AND ( density V[expr ${i} + 2] > [expr 0.36*0.36*1.29/1] INSIDE OF LAYER ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_AMO_t )
} else {
setlayer ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_AMO = ( ( density V${i} > [expr 0.26*0.26*1.66/1] INSIDE OF LAYER ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_AMO_t ) AND ( density V[expr ${i} + 1] > [expr 0.26*0.26*1.66/1] INSIDE OF LAYER ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_AMO_t ) ) AND ( density V[expr ${i} + 2] > [expr 0.26*0.26*1.66/1] INSIDE OF LAYER ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_AMO_t )
}

setlayer ${i}M[expr ${i} + 1]_check_3_level = M[expr ${i} + 1] INTERACT ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_AMO
setlayer ${i}M[expr ${i} + 2]_check = M[expr ${i} + 2] INTERACT ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_AMO
setlayer ${i}M[expr ${i} + 1]_or_M[expr ${i} + 2]_check = OR ${i}M[expr ${i} + 1]_check_3_level ${i}M[expr ${i} + 2]_check
setlayer ${i}M[expr ${i} + 2]_big = WITH WIDTH M[expr ${i} + 2] > 2
setlayer M[expr ${i} + 1]_or_M[expr ${i} + 2]_big = ${i}M[expr ${i} + 1]_big OR ${i}M[expr ${i} + 2]_big
setlayer M[expr ${i} + 1]_or_M[expr ${i} + 2] = M[expr ${i} + 1] OR M[expr ${i} + 2]
setlayer ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge = ( ENC ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_AMO \[M[expr ${i} + 1]_or_M[expr ${i} + 2]_big\] <= 10 OPPOSITE EXCLUDE SHIELDED 4 ) OR EDGE ( ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_AMO COIN EDGE M[expr ${i} + 1]_or_M[expr ${i} + 2]_big )
}

#for 2-level stack rules

for {set i 1} {$i <= [expr $metal_counts - 2]} {incr i} {
 
#//Mn_10_2
setlayer ${i}M[expr ${i} + 1]_check_space = ( ENC \[${i}M[expr ${i} + 1]_check\] ${i}V${i}[expr ${i} + 1]_proj_edge <= 10 OPPOSITE EXCLUDE SHIELDED 4 ) OR EDGE ( ${i}M[expr ${i} + 1]_check COIN EDGE ${i}V${i}[expr ${i} + 1]_proj_edge )

setlayer ${i}V${i}[expr ${i} + 1]_M[expr ${i} + 1]_10 = EXT ${i}M[expr ${i} + 1]_check_space M[expr ${i} + 1] < 1 OPPOSITE REGION EXCLUDE SHIELDED 4
rulecheck M[expr ${i} + 1]_10_V${i}[expr ${i} + 1] {
@ Space between two Mn regions when one or both Mn with 2-level continuous stacked via arrays (include TV)  >= 1.0um.
@ 1. DRC waive when metal edge encloses the stacked via array > 10um.
@ 2. DRC only flag space violation region when Parallel run length >= 15um.
@ The "continuous stacked via array" definition:
@ 1) Two vias whose space is <= 5um are considered to be in the same array, two via arrays with spacing <= 10um will be treated as one via array.. 
@ 2) All via array overlapped width is >= 5um, and parallel run length >= 15um. 
@ 3) Each layer via density >= 1.66/um2,Top via density >=1.29/um2.
@ 4) The vias in stacked via array interact with the same interlayer metal.
@ 5) The "2-level continuous stacked via array" means the stacked via array are 2 continuous via layers and the corresponding 1 interlayer metal has no metal cross (DRC waive width <= 2um metal line and check all interlayer metals projected space > 0um).
outlayer ENCLOSE RECTANGLE ${i}V${i}[expr ${i} + 1]_M[expr ${i} + 1]_10 15 0.001
}
}

#for 3-level stack rules

for {set i 1} {$i <= [expr $metal_counts - 3]} {incr i} {
VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES 
}

#//Vn_7_3
setlayer ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge_space = EXT \[${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge\] M[expr ${i} + 1]_or_M[expr ${i} + 2] < 6 OPPOSITE
setlayer ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge_space_e = ( ( EXPAND EDGE ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge_space INSIDE BY 10 ) AND ${i}M[expr ${i} + 1]_or_M[expr ${i} + 2]_check ) WITH EDGE ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge_space
setlayer ${i}M[expr ${i} + 1]_check_F = ${i}M[expr ${i} + 1]_check_3_level WITH EDGE ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge_space
setlayer ${i}M[expr ${i} + 2]_check_F = ${i}M[expr ${i} + 2]_check WITH EDGE ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge_space
setlayer ${i}M[expr ${i} + 1]M[expr ${i} + 2]_check_F = ${i}M[expr ${i} + 1]_check_F OR ${i}M[expr ${i} + 2]_check_F
setlayer ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_stk = ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_AMO INTERACT ${i}M[expr ${i} + 1]M[expr ${i} + 2]_check_F
setlayer ${i}V${i}_Vn2 = V${i} INSIDE ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_stk
setlayer ${i}V[expr ${i} + 1]_Vn2 = V[expr ${i} + 1] INSIDE ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_stk
setlayer ${i}V[expr ${i} + 2]_Vn2 = V[expr ${i} + 2] INSIDE ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_stk
setlayer ${i}V${i}_error = WITH NEIGHBOR ${i}V${i}_Vn2 >= 1 SPACE < 0.52 INSIDE OF LAYER ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_stk
setlayer ${i}V[expr ${i} + 1]_error = WITH NEIGHBOR ${i}V[expr ${i} + 1]_Vn2 >= 1 SPACE < 0.52 INSIDE OF LAYER ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_stk
setlayer ${i}V[expr ${i} + 2]_error = WITH NEIGHBOR ${i}V[expr ${i} + 2]_Vn2 >= 1 SPACE < 0.52 INSIDE OF LAYER ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_stk



setlayer ${i}X${i} = ( (${i}V${i}[expr ${i} + 1][expr ${i} + 2]_stk INTERACT ${i}V${i}_error) AND ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge_space_e ) INTERACT V${i}
rulecheck V${i}_7_V${i}[expr ${i} + 1][expr ${i} + 2]_R {
@ Space between Vias of >= 3-level continuous stacked via arrays (include TV), >= 0.52um, when
@ 1. The continuous stacked interlayer metals projected spacing is < 6um
@ 2. DRC flag the whole via array within (metal projected spacing region su 10um) along metal spacing direction.
@ The "continuous stacked via array" definition:
@ 1) Two vias whose space is <= 5um are considered to be in the same array, two via arrays with spacing <= 10um will be treated as one via array.
@ 2) All via array overlapped width is >= 5um, and parallel run length >= 15um. 
@ 3) Each layer via density >= 1.66/um2.
@ 4) The vias in stacked via array interact with the same interlayer metal.
@ 5) The "3-level continuous stacked via array" means the stacked via array are 3 continuous via layers and corresponding 2 continuous stacked interlayer metals all have no metal-cross (DRC waive width <= 2um metal line and check all interlayer metals projected space > 0um).
outlayer density V${i} > [expr 0.26*0.26*1.66/1] INSIDE OF LAYER ${i}X${i}
}

setlayer ${i}X[expr ${i} + 1] = ( (${i}V${i}[expr ${i} + 1][expr ${i} + 2]_stk INTERACT ${i}V[expr ${i} + 1]_error) AND ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge_space_e ) INTERACT V[expr ${i} + 1]
rulecheck V[expr ${i} + 1]_7_V${i}[expr ${i} + 1][expr ${i} + 2]_R {
@ Space between Vias of >= 3-level continuous stacked via arrays (include TV), >= 0.52um, when
@ 1. The continuous stacked interlayer metals projected spacing is < 6um
@ 2. DRC flag the whole via array within (metal projected spacing region su 10um) along metal spacing direction.
@ The "continuous stacked via array" definition:
@ 1) Two vias whose space is <= 5um are considered to be in the same array, two via arrays with spacing <= 10um will be treated as one via array.
@ 2) All via array overlapped width is >= 5um, and parallel run length >= 15um. 
@ 3) Each layer via density >= 1.66/um2,Top via density >=1.29/um2.
@ 4) The vias in stacked via array interact with the same interlayer metal.
@ 5) The "3-level continuous stacked via array" means the stacked via array are 3 continuous via layers and corresponding 2 continuous stacked interlayer metals all have no metal-cross (DRC waive width <= 2um metal line and check all interlayer metals projected space > 0um).
outlayer density V[expr ${i} + 1] > [expr 0.26*0.26*1.66/1] INSIDE OF LAYER ${i}X[expr ${i} + 1]
}

setlayer ${i}X[expr ${i} + 2] = ( (${i}V${i}[expr ${i} + 1][expr ${i} + 2]_stk INTERACT ${i}V[expr ${i} + 2]_error) AND ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge_space_e ) INTERACT V[expr ${i} + 2] 
if {"V[expr ${i} + 2]" == [lindex $via_list end]} {
rulecheck V[expr ${i} + 2]_7_V${i}[expr ${i} + 1][expr ${i} + 2]_R {
@ Space between Vias of >= 3-level continuous stacked via arrays (include TV), >= 0.52um, when
@ 1. The continuous stacked interlayer metals projected spacing is < 6um
@ 2. DRC flag the whole via array within (metal projected spacing region su 10um) along metal spacing direction.
@ The "continuous stacked via array" definition:
@ 1) Two vias whose space is <= 5um are considered to be in the same array, two via arrays with spacing <= 10um will be treated as one via array.
@ 2) All via array overlapped width is >= 5um, and parallel run length >= 15um. 
@ 3) Each layer via density >= 1.66/um2,Top via density >=1.29/um2.
@ 4) The vias in stacked via array interact with the same interlayer metal.
@ 5) The "3-level continuous stacked via array" means the stacked via array are 3 continuous via layers and corresponding 2 continuous stacked interlayer metals all have no metal-cross (DRC waive width <= 2um metal line and check all interlayer metals projected space > 0um).
outlayer density V[expr ${i} + 2] > [expr 0.36*0.36*1.29/1] INSIDE OF LAYER ${i}X[expr ${i} + 2]
}
} else {
rulecheck V[expr ${i} + 2]_7_V${i}[expr ${i} + 1][expr ${i} + 2]_R {
@ Space between Vias of >= 3-level continuous stacked via arrays (include TV), >= 0.52um, when
@ 1. The continuous stacked interlayer metals projected spacing is < 6um
@ 2. DRC flag the whole via array within (metal projected spacing region su 10um) along metal spacing direction.
@ The "continuous stacked via array" definition:
@ 1) Two vias whose space is <= 5um are considered to be in the same array, two via arrays with spacing <= 10um will be treated as one via array.
@ 2) All via array overlapped width is >= 5um, and parallel run length >= 15um. 
@ 3) Each layer via density >= 1.66/um2,Top via density >=1.29/um2.
@ 4) The vias in stacked via array interact with the same interlayer metal.
@ 5) The "3-level continuous stacked via array" means the stacked via array are 3 continuous via layers and corresponding 2 continuous stacked interlayer metals all have no metal-cross (DRC waive width <= 2um metal line and check all interlayer metals projected space > 0um).
outlayer density V[expr ${i} + 2] > [expr 0.26*0.26*1.66/1] INSIDE OF LAYER ${i}X[expr ${i} + 2]
}
}
VERBATIM {
#ENDIF
}

#//Mn_11_3


setlayer ${i}M[expr ${i} + 1]_check_space_3_level = ( ENC \[${i}M[expr ${i} + 1]_check_3_level\] ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge <= 10 OPPOSITE EXCLUDE SHIELDED 4 ) OR EDGE ( ${i}M[expr ${i} + 1]_check_3_level COIN EDGE ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge)
setlayer ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_M[expr ${i} + 1]_11 = EXT ${i}M[expr ${i} + 1]_check_space_3_level M[expr ${i} + 1] < 3 OPPOSITE REGION EXCLUDE SHIELDED 4

rulecheck M[expr ${i} + 1]_11_V${i}[expr ${i} + 1][expr ${i} + 2] {
@ Space between two Mn regions when one or both Mn with >= 3-level continuous stacked via arrays (include TV),  >= 3.0um
@ 1. DRC waive when metal edge encloses stacked via array > 10um.
@ 2. DRC only flag space violation region when Parallel run length >= 15um.
@ The "continuous stacked via array" definition:
@ 1) Two vias whose space is <= 5um are considered to be in the same array, two via arrays with spacing <= 10um will be treated as one via array.
@ 2) All via array overlapped width is >= 5um, and parallel run length >= 15um. 
@ 3) Each layer via density >= 1.66/um2,Top via density >=1.29/um2.
@ 4) The vias in stacked via array interact with the same interlayer metal.
@ 5) The "3-level continuous stacked via array" means the stacked via array are 3 continuous via layers and corresponding 2 continuous stacked interlayer metals all have no metal cross (DRC waive width <= 2um metal line and check all interlayer metals projected space > 0um).	
outlayer ENCLOSE RECTANGLE ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_M[expr ${i} + 1]_11 15 0.001
}

setlayer ${i}M[expr ${i} + 2]_check_space = ( ENC \[${i}M[expr ${i} + 2]_check\] ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge <= 10 OPPOSITE EXCLUDE SHIELDED 4 ) OR EDGE ( ${i}M[expr ${i} + 2]_check COIN EDGE ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_proj_edge)
setlayer ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_M[expr ${i} + 2]_11 = EXT ${i}M[expr ${i} + 2]_check_space M[expr ${i} + 2] < 3 OPPOSITE REGION EXCLUDE SHIELDED 4

rulecheck M[expr ${i} + 2]_11_V${i}[expr ${i} + 1][expr ${i} + 2] {
@ Space between two Mn regions when one or both Mn with >= 3-level continuous stacked via arrays (include TV),  >= 3.0um
@ 1. DRC waive when metal edge encloses stacked via array > 10um.
@ 2. DRC only flag space violation region when Parallel run length >= 15um.
@ The "continuous stacked via array" definition:
@ 1) Two vias whose space is <= 5um are considered to be in the same array, two via arrays with spacing <= 10um will be treated as one via array.
@ 2) All via array overlapped width is >= 5um, and parallel run length >= 15um. 
@ 3) Each layer via density >= 1.66/um2,Top via density >=1.29/um2.
@ 4) The vias in stacked via array interact with the same interlayer metal.
@ 5) The "3-level continuous stacked via array" means the stacked via array are 3 continuous via layers and corresponding 2 continuous stacked interlayer metals all have no metal cross (DRC waive width <= 2um metal line and check all interlayer metals projected space > 0um).	
outlayer ENCLOSE RECTANGLE ${i}V${i}[expr ${i} + 1][expr ${i} + 2]_M[expr ${i} + 2]_11 15 0.001
}
}


