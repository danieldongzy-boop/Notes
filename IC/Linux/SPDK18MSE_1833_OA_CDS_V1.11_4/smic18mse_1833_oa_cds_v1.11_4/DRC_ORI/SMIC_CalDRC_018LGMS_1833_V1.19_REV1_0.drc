VERBATIM {
//===============================
//  PA - Bond PAD opening rules
//===============================

GROUP GPA PA_?

PA_1 {
@ Bond pad width is >= 40.00um
  INT PA < 40 ABUT<90 SINGULAR REGION
}
PA_2 {
@ Space between two bond pad windows is >= 7.00um
  EXT PA < 7 ABUT<90 SINGULAR REGION
}
}

RULECHECK PA_3 {
@ Top metal fully enclosure of a bond pad is >= 1.50um
@ Non-solid top metal under PA pad is not allowed.
@ (M6 as TM if 6M process, M5 as TM if 5M process)
OUTLAYER  ENC PA [lindex $metal_list end] < 1.5 ABUT<90 SINGULAR REGION OUTSIDE ALSO
OUTLAYER  PA NOT [lindex $metal_list end]
}

VERBATIM {
//; PA_4: purposely blank
//; PA_5_NC_R: Stacked via layout is not recommended under bond pad. The via array is arranged in a shape to reduce mechanical stress in bond pad. 


//=================================
//      MIMDMY - MIM DUMMY DRC
//=================================
#IFDEF guideline_a_check YES
}

GROUP GMIMDMY MIMDMY_?

RULECHECK MIMDMY_2_G {
@ MIMDMY must fully cover active MIM region. Enclosure of MIM by MIMDMY is = 0.2um
OUTLAYER MIM CUT MIMDMY
SETLAYER X = MIM INSIDE MIMDMY
SETLAYER Y = EXPAND EDGE X OUTSIDE BY 0.2 CORNER FILL
SETLAYER MIMDMY_MIM = MIMDMY INTERACT MIM
OUTLAYER MIMDMY_MIM XOR (Y OR (MIM AND MIMDMY))
} 

VERBATIM {
#ENDIF
}

VERBATIM {
//; MIMDMY_1_G_NC: MIMDMY is the DRC marking layer for active MIM, which must not include dummy MIM.
//; Active MIM can not do DRC checking if customers don't draw MIMDMY layer.


//=================================== 
//  MIM - Metal-Insulator-Metal DRC
//===================================

CAP_MIM = (MIM INTERACT MIMDMY) OR (MIM INTERACT TV)
DMY_MIM = MIM NOT CAP_MIM

GROUP GMIM MIM_?

MIM_1 {
@ Width of active MIM region as top plate is >= 4.00um
  INT CAP_MIM < 4 ABUT<90 SINGULAR REGION
}
MIM_1a {
@ Length of active MIM region as top plate is >= 30.00um
@ If capacitor larger than 30um*30um, please use combination of smaller capacitor
  SIZE CAP_MIM BY 15 UNDEROVER
}
MIM_2 {
@ Space between two active MIM region as top plate is >= 1.20um
  EXT CAP_MIM < 1.2 ABUT<90 SINGULAR REGION
}
MIM_3 {
@ Fully enclosure of MIM region beyond a Via (TV) which connect to this MIM is >= 0.24um
  X = TV AND MIM
  ENC X MIM < 0.24 ABUT<90 SINGULAR REGION
}
MIM_4 {
@ Fully enclosure of bottom plate(Mn)region on a MIM region is >= 0.40um
  ENC MIM MT_1_MIM < 0.4 ABUT<90 OUTSIDE ALSO SINGULAR REGION
}
}

VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_ON YES
}
RULECHECK MIM_6_R {
@ It is not recommended to put sensitivity devices under MIM. The sensitivity devices include RF, Analog, etc
OUTLAYER  GATE AND MIM
OUTLAYER  OPCBA AND MIM
OUTLAYER  OPCBP AND MIM
OUTLAYER  OPCBM AND MIM
OUTLAYER  RESAA AND MIM
OUTLAYER  RESNW AND MIM
OUTLAYER  RESP1 AND MIM
OUTLAYER  RESP3T AND MIM

OUTLAYER  DSTR AND MIM
OUTLAYER  DMPNP AND MIM
OUTLAYER  HRPDMY AND MIM
OUTLAYER  VARMOS AND MIM
OUTLAYER  INDMY AND MIM
OUTLAYER  MOMDMY AND MIM

OUTLAYER  FUSE AND MIM
OUTLAYER  EFUSE AND MIM
OUTLAYER  GTFUSE AND MIM
OUTLAYER  FUSEMK1 AND MIM
OUTLAYER  ESD5V AND MIM
OUTLAYER  ESDIO2 AND MIM
} 
VERBATIM {
#ENDIF
}

VERBATIM {
MIM_8 {
@ Width of a bottom metal(Mn) region in capacitor is <= 35.00um
@ If bottom metal larger than 35*35, please use combination of smaller capacitor
  SIZE MT_1_MIM  BY 17.5 UNDEROVER
}
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
#IFDEF DENSITY_CHECK YES
}

RULECHECK MIM_9_R {
@ MIM density is >= 3%
OUTLAYER  DENSITY MIMi < 0.03
}
VERBATIM {
#ENDIF
#ENDIF
}

VERBATIM {
MIM_11 {
@ Extension of capacitor bottom metal beyond Via connect to Mn is >= 0.12um
  ENC TV_MT_1_MIM MT_1_MIM < 0.12 ABUT<90 SINGULAR REGION
}
MIM_12 {
@ Space between top Via and MIM region is >= 0.40um
  EXT TV_MT_1_MIM MIM < 0.4 ABUT<90 SINGULAR REGION
}

LAYER MAP 9999 DATATYPE 1111 4321
LAYER EMPTY 4321
TV_EMPTY = EMPTY OR (TV AND MIM)
MIM_EMPTY = EMPTY OR MIM
CONNECT TV_EMPTY MIM_EMPTY

MIM_13 {
@ Space between two Vias on MIM is >= 2.00um
  EXT TV_EMPTY < 2 ABUT<90 SINGULAR REGION CONNECTED
}

LAYER MAP 9999 DATATYPE 1112 9687
LAYER EMPTY2 9687
TV_EMPTY2 = EMPTY2 OR ((TV AND MT_1_MIM) NOT MIM)
MT_EMPTY2 = EMPTY2 OR MT_1_MIM
CONNECT TV_EMPTY2 MT_EMPTY2

MIM_14 {
@ Space between two Vias on bottom metal(Mn) is >= 4.00um
  EXT TV_EMPTY2 < 4 ABUT<90 SINGULAR REGION CONNECTED
}
MIM_15 {
@ Dummy MIM width is >= 0.40um
  INT DMY_MIM < 0.4 ABUT<90 SINGULAR REGION
}
}
VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
}
RULECHECK MIM_15a_R {
@ Dummy MIM width is >= 0.78um
OUTLAYER  INT DMY_MIM < 0.78 ABUT<90 SINGULAR REGION
}
VERBATIM {
#ENDIF
MIM_16 {
@ Space of dummy MIM to MIM region is >= 0.80um
  EXT DMY_MIM MIM < 0.8 ABUT<90 SINGULAR REGION
}
MIM_17 {
@ Space of MIM capacitor bottom Mn to dummy Mn is >= 0.80um
  EXT MT_1_MIM MT_1_DMYMIM < 0.8 ABUT<90 SINGULAR REGION
}
}
VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
}

RULECHECK MIM_18_R {
@ To avoid strong coupling, Mn-1 is not recommended to put beneath MIM bottom plate.
@ Minimum space between Mn-1 and MIM bottom plate is 2.00um. 
OUTLAYER  EXT MT_1_MIM Mn < 2 ABUT<90 SINGULAR REGION
OUTLAYER  MT_1_MIM AND Mn
}  

VERBATIM {
#ENDIF
}

VERBATIM {
//; MIM_5 {@ Purposely blank}
//; MIM_7 {@ Purposely blank}
//; MIM_10 { @ Purposely blank }
//; MIM_9a_NC_R: Dummy MIM pattern suggested 4 X 5um with dummy pattern space 1.5um is required if density less than 3%
//; MIM_19_NC: The MIM structure is placed within top metal and next 1 metal.


//========================================
// Chip edge BORDER layer design rule
//========================================

BORDER_ALL = BORDER OR (HOLES BORDER)
BD_EXTENT = EXTENT DRAWN ORIGINAL
BD_EXTENT_OTHER = EXTENT DRAWN ORIGINAL IGNORE BORDER
BD_OTHER_OUTSIDE = BD_EXTENT_OTHER NOT BORDER
BD_EXTENT_OTHER_1 = OR DNWi AAi NWi MVNi MVPi DGi GTi SNi SPi SABi CTi M1i M2i M3i M4i M5i M6i V1i V2i V3i V4i V5i PAi FUSE AADUMi GTDUMi M1DUMi M2DUMi M3DUMi M4DUMi M5DUMi M6DUMi
BD_EXTENT_OTHER_2 = EXTENT BD_EXTENT_OTHER_1
//BD_EXTENT_OTHER_3 = BD_EXTENT_OTHER_2 NOT BORDER

GROUP GBD BD_?

BD_1 {
@ The BORDER layer must enclose all chip layout patterns, which all chip layout patterns 
@ include seal ring if seal ring has been added by designers.
@ This rule checking includes the layers of DNW,AA,NW, MVN, MVP,DG,GT,SN,SP,SAB,CT,M1,V1,Mn,
@ Vn,TMn,TVn,PA,Fuse,AADUM,GTDUM,MnDUM,TMnDUM
  //COPY BD_EXTENT_OTHER_3
  BD_EXTENT_OTHER_2 NOT BORDER
}
BD_2b { 
@ Enclosure of DNW by the chip edge (BORDER layer) if it need SMIC to add seal ring is >= 5.00um
  ENC DNWi BORDER_ALL < 5 ABUT<90 SINGULAR REGION OUTSIDE ALSO
}
}

RULECHECK BD_2a {
@ Enclosure of AA, GT, CT, Mn(n=1-5), Vn(n=1-5), TM by BORDER layer if it need SMIC to add
@  seal ring. (AA, GT, CT, Mn, Vn, TM are OPC treatment layers) is >= 1.1um.
OUTLAYER  ENC AAi BORDER_ALL < 1.1 ABUT<90 SINGULAR REGION OUTSIDE ALSO
OUTLAYER  ENC GTi BORDER_ALL < 1.1 ABUT<90 SINGULAR REGION OUTSIDE ALSO
OUTLAYER  ENC CTi BORDER_ALL < 1.1 ABUT<90 SINGULAR REGION OUTSIDE ALSO
foreach layer $metal_list {
OUTLAYER  ENC ${layer}0 BORDER_ALL < 1.1 ABUT<90 SINGULAR REGION OUTSIDE ALSO
}
foreach layer $via_list {
OUTLAYER  ENC ${layer}i BORDER_ALL < 1.1 ABUT<90 SINGULAR REGION OUTSIDE ALSO
}
}

RULECHECK BD_4 {
@ Enclosure of seal ring outer ring outline edge by BORDER layer if seal ring has been added by designers is >= 1.1um
foreach layer $metal_list {
OUTLAYER    ENC (${layer}S TOUCH ${layer}S_OUTER) BORDER < 1.1 ABUT<90 SINGULAR REGION
}
}

VERBATIM {
//; BD_3_NC: BORDER layer size should be exact same with the seal ring window edge if seal ring has been added by designers 
//; BD_5_NC: BORDER layer size should be exact same with chip window size in LDDI form (chip window size when tape-out).
//; BD_6_NC: BORDER layer rules BD.1~ BD.5 are only for chip level design rules. DRC does not check IP level BORDER


//============================
//  NR - Nwell Resister DRC
//============================

GROUP GNR NR_?

NR_1 {
@ Enclosure of AA beyond an NW is >= 1.00um
  ENC NR AA < 1.0 ABUT<90 SINGULAR REGION

  X = INT RESNW < 0.005 ABUT INTERSECTING ONLY REGION  // abnormal shape1
  X INTERACT NR
  RESNW NOT INTERACT NW  // abnormal shape2
}
NR_2 {
@ Enclosure of salicide NW beyond a CT is >= 0.30um
  ENC CT NR < 0.3 ABUT<90 SINGULAR REGION
}
NR_3 {
@ Space between SAB and related NW is >= 0.30um
  EXT NR SAB < 0.3 ABUT<90 SINGULAR REGION
}
NR_4 {
@ Enclosure of a SAB to a related AA is >= 0.22um
  X = AAR INSIDE EDGE SAB
  ENC X SAB < 0.22 ABUT<90 REGION
}
NR_5 {
@ For well resistor with AA , Overlap of a SN to SAB (SAB hole must be fully enclosed by SN) is >= 0.40um
  INT SNR SAB < 0.4 ABUT<90 SINGULAR REGION
  X = SAB INTERACT SNR
  (HOLES X ) NOT SN
}
NR_6 {
@ Space between SAB and related CT in SAB hole is >= 0.30um
  X = CT AND NR
  EXT X SAB < 0.3 ABUT<90 SINGULAR REGION
} 
NR_7 {
@ Space between resistor NW and (resistor NW or NW) is >= 1.40um
//  EXT NR < 1.4 ABUT<90 SINGULAR REGION
 EXT NR < 1.4 ABUT<90 SINGULAR REGION
 EXT NR NR_STI < 1.4 ABUT<90 SINGULAR REGION
 EXT NR_STI < 1.4 ABUT<90 SINGULAR REGION
 EXT (NR OR NR_STI) NW < 1.4 ABUT<90 SINGULAR REGION
}
NR_8 {
@ LDD, SN or SP is not allowed in the NW resistor area
@ DRC only check the NW resistor under AA.
  X = (NR INTERACT SAB) AND RESNW
  AND SN X
  AND SP X
  AND NLL X
  AND NLH X
  AND PLL X
  AND PLH X
}

NR_AA = ((NW AND AA) AND RESNW) AND SAB
NR_STI = (NW AND RESNW) NOT INTERACT SAB
NR_ALL = NR_AA OR NR_STI
}

VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_ON YES
}
RULECHECK NR_9_R {
@ NW resistor width is >= 1.00um
@ This is a recommended rule. Turn on by default.
SETLAYER  Y = NR_ALL INSIDE EDGE RESNW
OUTLAYER  INT Y < 1.0 ABUT<90 OPPOSITE REGION
}
VERBATIM {
#ENDIF
}

VERBATIM {
#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES
}
RULECHECK NR_10_R {
@ For NW resistor under STI, space between RESNW to salicide AA area	=	0	um
 SETLAYER X = RESNW INTERACT NR_STI
 OUTLAYER (X INSIDE EDGE NW) NOT TOUCH EDGE AA
}
VERBATIM {
#ENDIF
}

VERBATIM {

#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES

//============================
//  RESAA - AA Resister DRC
//============================

AR = ((AA AND RESAA) AND SAB) OR ((AA AND RESAA) NOT INTERACT SAB)

}

GROUP GRESAA RESAA_?

RULECHECK RESAA_1_R {
@ Width of AA resistor is >= 2.00um
SETLAYER  AR_edge = AR INSIDE EDGE RESAA
OUTLAYER  INT AR_edge < 2 ABUT<90 REGION
}
RULECHECK RESAA_1a_1_R {
@ Suggest AA resistor Nsq >= 5 for stable Resistivity(Non-silicide Poly resistor region)
SETLAYER  X = RESAA AND SAB
SETLAYER  Y = (AA AND RESAA) AND SAB 
SETLAYER  L = INSIDE EDGE AA X
SETLAYER  W = INSIDE EDGE Y AA
OUTLAYER  DFM PROPERTY Y L W OVERLAP ABUT ALSO \[SQUARES = LENGTH(L)/LENGTH(W)\] < 5
}
RULECHECK RESAA_1a_2_R {
@ Suggest AA resistor Nsq >= 5 for stable Resistivity(silicide Poly resistor region)
SETLAYER  Y = (AA AND RESAA) NOT INTERACT SAB
SETLAYER  L = INSIDE EDGE AA RESAA
SETLAYER  W = INSIDE EDGE Y AA
OUTLAYER  DFM PROPERTY Y L W OVERLAP ABUT ALSO \[SQUARES = LENGTH(L)/LENGTH(W)\] < 5
}
VERBATIM {
#ENDIF
}

VERBATIM {

#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES	
//==========================
//  PR - Poly Resistor DRC
//==========================

}

GROUP GPR PR_?

set pr_4_list "a SN b SP c NLL d NLH e PLL f PLH"

RULECHECK PR_1_R {
@ Width of poly resistor is >= 1.00um
#//;  INT (GTR INSIDE EDGE RESP1) < 0.5 ABUT<90  REGION
SETLAYER  X = GT AND RESP1
SETLAYER  Y = X COIN EDGE GT
OUTLAYER  INT Y < 1.0 ABUT<90 OPPOSITE REGION
}
RULECHECK PR_1a_1_R {
@ suggest the Nsq >= 5 for stable Resistivity(Non-silicide Poly resistor region)
SETLAYER  X = RESP1 AND SAB
SETLAYER  Y = (GT AND RESP1) AND SAB 
SETLAYER  L = INSIDE EDGE GT X
SETLAYER  W = INSIDE EDGE Y GT
OUTLAYER  DFM PROPERTY Y L W OVERLAP ABUT ALSO \[SQUARES = LENGTH(L)/LENGTH(W)\] < 5
}
RULECHECK PR_1a_2_R {
@ suggest the Nsq >= 5 for stable Resistivity(Silicide Poly resistor region)
SETLAYER  Y = (GT AND RESP1) NOT INTERACT SAB
SETLAYER  L = INSIDE EDGE GT RESP1
SETLAYER  W = INSIDE EDGE Y GT
OUTLAYER  DFM PROPERTY Y L W OVERLAP ABUT ALSO \[SQUARES = LENGTH(L)/LENGTH(W)\] < 5
}
RULECHECK PR_2_R {
@ Space between SAB and contact on poly is = 0.22um
SETLAYER  X = (GTR INTERACT SAB) INTERACT CT
SETLAYER  Y = SAB INTERACT X
SETLAYER  Z = CT INSIDE X
SETLAYER  EXPCT = SIZE Z BY 0.22 STEP 0.05 INSIDE OF X
OUTLAYER  EXPCT NOT TOUCH Y
}
RULECHECK PR_3_R {
@ Space between the resistor poly and un-related SAB is >= 0.30um
SETLAYER  X = SAB NOT INTERACT GTR
OUTLAYER  EXT GTR X < 0.30 ABUT<90 SINGULAR REGION
}

foreach { i j } $pr_4_list {
RULECHECK PR_4${i}_R {
@ Space between the resistor poly and un-related implant region is >= 0.26um
SETLAYER  X = $j NOT INTERACT RESP1
OUTLAYER  EXT GTR X < 0.26 ABUT<90 REGION
}
}

RULECHECK PR_6_R {
@ Dog-bone design at the end of poly resistor for contact pick-up is not suggested
SETLAYER  X = CONVEX EDGE GTR == 1
OUTLAYER  EXPAND EDGE X INSIDE BY 0.01
}
RULECHECK PR_7_R {
@ PLL, NLL, PLH, NLH implants are not allowed in the N+/P+ poly resistor region
OUTLAYER  AND NLL ((GTR INTERACT (SN OR SP)) AND RESP1)
OUTLAYER  AND NLH ((GTR INTERACT (SN OR SP)) AND RESP1)
OUTLAYER  AND PLL ((GTR INTERACT (SN OR SP)) AND RESP1)
OUTLAYER  AND PLH ((GTR INTERACT (SN OR SP)) AND RESP1)
}
VERBATIM {
#ENDIF
}

VERBATIM {
/*
PR_5_NC_R {It is recommended to place a single column CT to pick-up poly resistor }
*/

#IFDEF OPEN_RECOMMENDED_DEFAULT_OFF YES

//==================================
//  HRP - High Resistance Poly DRC
//==================================


GROUP GHRP HRP_?
}

RULECHECK HRP_1_R {
@ It is strongly suggest that resistor square number >= 5 for precision Rs
SETLAYER  X = HRPDMY INTERACT SAB
SETLAYER  Y = X INTERACT HRP 
SETLAYER  Z = (GT AND HRPDMY) AND SAB
SETLAYER  L = INSIDE EDGE GT Y
SETLAYER  W = INSIDE EDGE Z GT
OUTLAYER  DFM PROPERTY Z L W OVERLAP ABUT ALSO \[SQUARES = LENGTH(L)/LENGTH(W)\] < 5
}
VERBATIM {
#ENDIF
}

VERBATIM {
HRP_2 {
@ Extension from HRP region beyond a poly resistor region is >= 0.26um
  ENC GT_HRP HRP < 0.26 ABUT<90 SINGULAR REGION
}
HRP_3_4 {
@ Space from HRP region to Polygate of NMOS/PMOS is >= 0.32um
  GT_MOS = GT INTERACT GATE
  EXT HRP GT_MOS < 0.32 ABUT<90 SINGULAR REGION
}
HRP_5 {
@ P+ implant for pickup overlap with SAB = 0.30um
  SP_HRP = SP INTERACT HRP
  SAB_HRP = SAB INTERACT HRP
  INT SP_HRP SAB_HRP < 0.30 ABUT<90 SINGULAR REGION

  SIZE_SP = SIZE SP_HRP BY -0.30
  AND SIZE_SP SAB_HRP
}
HRP_6 {
@ Extension from SAB region beyond a poly resistor region is >= 0.22um
  ENC GT_HRP SAB < 0.22 ABUT<90 SINGULAR REGION
}
HRP_7 {
@ Width of Poly region for high resistance poly resistor is >= 1.00um
  X = HRPDMY AND GT
  Y = X COIN EDGE GT
  INT Y < 1 OPPOSITE REGION
}
HRP_10 {
@ It is not allowed to receive SN, and all LDD implant in the HRP region
@ (Note: SP only using for HRP 2 terminals pick up is defined in HRP.5)
  AND SN HRP
  AND NLL HRP
  AND NLH HRP
  AND PLL HRP
  AND PLH HRP 
}
HRP_11 {
@ HRP width is >= 0.44um
  INT HRP < 0.44 ABUT<90 SINGULAR REGION
}
HRP_12 {
@ HRP space is >= 0.44um
  EXT HRP < 0.44 ABUT<90 SINGULAR REGION
}
//;HRP_8_NC {
//;@ Dummy layer "HRPDMY" is needed for DRC for high resistance Poly region
//;@ The HRPDMY length determines the HRP length.
//;  SAB_HRP = SAB INTERACT HRP
//;  SAB_HRP NOT INTERACT HRPDMY
//;}
//; HRP_9_NC: For contact rule, please follow Logic baseline rule.



//=========================
//  Seal Ring Check Rules
//=========================

GROUP GSRCK SRCK_?

SRCK_1 {
@ Contact width is = 0.26um, it is allowed sqrt(2) variation at 45 degree angle area.	
  CTS_SQ = RECTANGLE CTS
  CTS_LN = CTS NOT CTS_SQ
  CT_V_edge = ANGLE CTS_LN == 90
  CT_H_edge = ANGLE CTS_LN == 0
  CT_D_edge = ANGLE CTS_LN >44.9 <45.1
  X_V = INT CT_V_edge < 10 ABUT<90 OPPOSITE REGION
  X_H = INT CT_H_edge < 10 ABUT<90 OPPOSITE REGION
  X_D = INT CT_D_edge < 10 ABUT<90 OPPOSITE REGION
  INT CTS_LN < 0.259 ABUT<90 SINGULAR REGION
  X_V WITH WIDTH > 0.261
  X_H WITH WIDTH > 0.261
  X_D WITH WIDTH > 0.368
}

 DMACRO SEAL1 VLAY {
  V_S_SQ = RECTANGLE VLAY
  V_S_LN = VLAY NOT V_S_SQ
  V_V_edge = ANGLE V_S_LN == 90
  V_H_edge = ANGLE V_S_LN == 0
  V_D_edge = ANGLE V_S_LN >44.9 <45.1
  X_V = INT V_V_edge < 10 ABUT<90 OPPOSITE REGION
  X_H = INT V_H_edge < 10 ABUT<90 OPPOSITE REGION
  X_D = INT V_D_edge < 10 ABUT<90 OPPOSITE REGION
  INT V_S_LN < 0.359 ABUT<90 SINGULAR REGION
  X_V WITH WIDTH > 0.361
  X_H WITH WIDTH > 0.361
  X_D WITH WIDTH > 0.509
}

 DMACRO SEAL2 MLAY {
  M_S_RING = COPY MLAY 
  M_V_edge = ANGLE M_S_RING == 90
  M_H_edge = ANGLE M_S_RING == 0
  M_D_edge = ANGLE M_S_RING >44.9 <45.1
  X_V = INT M_V_edge < 10 ABUT<90 OPPOSITE REGION
  X_H = INT M_H_edge < 10 ABUT<90 OPPOSITE REGION
  X_D = INT M_D_edge < 10 ABUT<90 OPPOSITE REGION
  INT M_S_RING < 5.999 ABUT<90 SINGULAR REGION
  X_V WITH WIDTH > 6.001
  X_H WITH WIDTH > 6.001
  X_D WITH WIDTH > 8.485
}
}

RULECHECK SRCK_2 {
@ V1~V4, TV size is = 0.36um, it is allowed sqrt(2) variation at 45 degree angle area.	
foreach layer $via_list {
OUTLAYER  CMACRO SEAL1 ${layer}S
}
}

RULECHECK SRCK_3 {
@ M1~M5,TM width are = 6.00um, it is allowed sqrt(2) variation at 45 degree angle area.
foreach layer $metal_list {
OUTLAYER  CMACRO SEAL2 ${layer}S_RING
}
}
RULECHECK SRCK_4 {
@ Seal ring must be a close ring.
@ DRC check Metal/Top metal layers and all the listed layers must be drawn.
@ For non-SMIC standard seal ring design, SMIC can't guarantee the seal ring quality. It's strongly recommended to qualify in SMIC before it used in product tape-out.
if { 6 == $metal_counts } {
	SETLAYER GR_RING = (((((M1i AND M2i) AND M3i) AND M4i) AND M5i) AND M6i) AND MARKS
} elseif { 5 == $metal_counts } {
	SETLAYER GR_RING = ((((M1i AND M2i) AND M3i) AND M4i) AND M5i) AND MARKS
} elseif { 4 == $metal_counts } {
	SETLAYER GR_RING = (((M1i AND M2i) AND M3i) AND M4i) AND MARKS
} elseif { 3 == $metal_counts } {
	SETLAYER GR_RING = ((M1i AND M2i) AND M3i) AND MARKS
}
  OUTLAYER NOT DONUT GR_RING
  OUTLAYER MARKS NOT INTERACT (DONUT GR_RING)
}

VERBATIM {
//============================
//    Conventional Check
//============================

GROUP GConvention Convention_?

Convention_1 {
@ NW not interacting with N+ pickup is not allowed
  NW NOT INTERACT NTAPi
}
Convention_2 {
@ PMOS in PW is not allowed,exclude SRAM region.
  PGT = PACT AND GT
  (PW AND PGT) NOT INSIDE SRAM
}
Convention_3 {
@ AA must be fully enclosed by (SN OR SP), except AA interact with RESNW region
  X = AA NOT INTERACT RESNW
  (X NOT SN) NOT SP
}

PMOS1 = (PMOS NOT INTERACT CAPBP) NOT INTERACT RESP1

Convention_4a {
@ Maximum space from any point within Source/Drain region to the nearest pick up
@ AA region inside the same well for I/O and internal circuits is 35.00um
  A = INT NTAP < 0.005 ABUT INTERSECTING ONLY REGION
  B = (NTAP INTERACT A) NOT A
  C = INT B < 0.001 ABUT INTERSECTING ONLY REGION
  D = (B INTERACT C) NOT C
  NW_MINUS_NTAP = SIZE D BY 35 INSIDE OF NW STEP 0.6
  X = PMOS1 AND NW
  OUTSIDE EDGE X NW_MINUS_NTAP
}

NMOS1 = (NMOS NOT INTERACT CAPBP) NOT INTERACT RESP1

Convention_4b {
@ Maximum space from any point within Source/Drain region to the nearest pick up
@ AA region inside the same well for I/O and internal circuits is 35.00um
  A = INT PTAP < 0.005 ABUT INTERSECTING ONLY REGION
  B = (PTAP INTERACT A) NOT A
  C = INT B < 0.001 ABUT INTERSECTING ONLY REGION
  D = (B INTERACT C) NOT C
  PW_MINUS_PTAP = SIZE D BY 35 INSIDE OF PW STEP 0.6
  X = NMOS1 AND PW
  OUTSIDE EDGE X PW_MINUS_PTAP
}

//===============================================
// AA Dummy Check Rules DRC Check
//===============================================

GROUP GAADUMCK AADUMCK_?

AADUMCK_4 {
@ AA dummy patterns cannot touch AA/GT.
  AADUM INTERACT AAi
  AADUM INTERACT GTi
}
AADUMCK_5 {
@ Dummy AA pattern is not allowed inside RESAA/RESNW/RESP1 covered areas. 
  AADUM INTERACT RESAA
  AADUM INTERACT RESNW
  AADUM INTERACT RESP1
}
AADUMCK_6 {
@ Space between dummy AA and DUMBA /NW edge	>=	2	um
  EXT AADUM DUMBA < 2 ABUT<90 SINGULAR REGION
  (EXT AADUM NWi < 2 ABUT<90 SINGULAR REGION) NOT INSIDE DUMBA
}

//===============================================
// GT Dummy Check Rules DRC Check
//===============================================

GROUP GGTDUMCK GTDUMCK_?

GTDUMCK_3 {
@ Dummy poly pattern is not allowed to exist above AA (not include dummy AA). 
@ Space between poly dummy and AA main pattern can not violate GT.7. 
  GTDUM AND AAi
}

GTDUMCK_4 {
@ Poly dummy patterns cannot touch GT main patterns.
  GTDUM INTERACT GTi
}
GTDUMCK_5 {	
@ Dummy poly pattern is not allowed inside RESAA/RESNW/RESP1 covered areas.
  GTDUM INTERACT RESAA	
  GTDUM INTERACT RESNW
  GTDUM INTERACT RESP1
}
GTDUMCK_6 {
@ Space between dummy poly and DUMBP. 	>=	2
  EXT GTDUM DUMBP < 2 ABUT<90 SINGULAR REGION
}

//=========================================================
// Mn (n=1~5) Metal Dummy pattern check rules - DRC Check
//=========================================================

}

for { set j 1 } { 1 <= [expr $metal_counts -$j] } { incr j } {

GROUP GM${j}DUMCK M${j}DUMCK_?

RULECHECK M${j}DUMCK_1_2_3_4 {
@ Space between metal dummy lines with one or both metal dummy line width and length are greater than 10µm; 
@ the minimum space must be maintained between a metal dummy line and a small piece of metal dummy (<10µm) 
@ that is connected to the wide metal dummy within 1.0µm range from the wide metal dummy >= 0.60um.
	SETLAYER  X = SIZE M${j}DUMOVER10 BY 1.0 STEP 0.148 INSIDE OF WIDE_M${j}DUM
	SETLAYER  A = EXT X M${j}DUM < 0.60 ABUT<90 SINGULAR REGION
	SETLAYER  A1 = size A BY 0.001 TRUNCATE 0.001
	SETLAYER  A2 = A1 AND M${j}DUM
	SETLAYER  B = A TOUCH A2 == 1
	SETLAYER  C = A NOT B
	
	SETLAYER  X1 = M${j}DUM WITH WIDTH > 10 
	SETLAYER  Y = SIZE X1 BY 1 STEP 0.2 INSIDE OF M${j}DUM 
	SETLAYER  Z = EXT M${j}DUM Y < 0.6 ABUT<90 SINGULAR REGION OPPOSITE 
	OUTLAYER  (C OR Z) NOT (HOLES M${j}DUM INNER EMPTY)
}
RULECHECK M${j}DUMCK_5 {
@ Mn dummy metal can not be interacted with Mn metal design patterns. (n=1~5)
  OUTLAYER M${j}DUM INTERACT M${j}0
}
RULECHECK M${j}DUMCK_6 {
@ Space between dummy metal and DUMBM	>=	2	um.
  OUTLAYER EXT M${j}DUM DUMBM < 2 ABUT < 90 SINGULAR REGION
}
}


set metal_list_tmp " "
for { set j 1 } { 0 <= [expr $metal_counts -$j] } { incr j } {
  lappend metal_list_tmp M${j}0
}



if { [string equal $top_metal MT] == 1 } {

VERBATIM {

//=========================================================
// Top Metal MT Dummy pattern check rules - DRC Check
//=========================================================
}

GROUP GMTDUMCK MTDUMCK_?

RULECHECK MTDUMCK_1_2 {
@ Space between MT dummy lines with one or both MT dummy line width and length are greater than 10um is >= 0.60um; 
@ this also includes all metals dummy attached to these areas or extending out for a distance of 1.00um or less
	SETLAYER  X = SIZE [lindex $metal_list end]DUMOVER10 BY 1.0 STEP 0.148 INSIDE OF WIDE_[lindex $metal_list end]DUM
	SETLAYER  A = EXT X [lindex $metal_list end]DUM < 0.60 ABUT<90 SINGULAR REGION 
	SETLAYER  A1 = size A BY 0.001 TRUNCATE 0.001 
	SETLAYER  A2 = A1 AND [lindex $metal_list end]DUM 
	SETLAYER  B = A TOUCH A2 == 1 
	SETLAYER  C = A NOT B
	
	SETLAYER  X1 = [lindex $metal_list end]DUM WITH WIDTH > 10 
	SETLAYER  Y = SIZE X1 BY 1 STEP 0.2 INSIDE OF [lindex $metal_list end]DUM
	SETLAYER  Z = EXT [lindex $metal_list end]DUM Y < 0.6 ABUT<90 SINGULAR REGION OPPOSITE 
	OUTLAYER  (C OR Z) NOT (HOLES [lindex $metal_list end]DUM INNER EMPTY)
}
RULECHECK MTDUMCK_3 {
@ Top Metal dummy metal can not interact with Top Metal metal design patterns.
  OUTLAYER [lindex $metal_list end]DUM INTERACT [lindex $metal_list_tmp end]
}
RULECHECK MTDUMCK_4 {
@ Space between Top Metal dummy patterns and DUMBM	>=	2	um
  OUTLAYER EXT [lindex $metal_list end]DUM DUMBM < 2 ABUT <90 SINGULAR REGION
}
}
if { [string equal $top_metal MTT] == 1 } {

VERBATIM {

//=========================================================
// Top Metal MTT Dummy pattern check rules - DRC Check
//=========================================================
}

GROUP GMTTDUMCK MTTDUMCK_?

RULECHECK MTTDUMCK_3 {
@ Top Metal dummy metal can not interact with Top Metal metal design patterns.
  OUTLAYER [lindex $metal_list end]DUM INTERACT [lindex $metal_list_tmp end]
}
RULECHECK MTTDUMCK_4 {
@ Space between Top Metal dummy patterns and DUMBM	>=	2	um
  OUTLAYER EXT [lindex $metal_list end]DUM DUMBM < 2 ABUT <90 SINGULAR REGION
}
}
if { [string equal $top_metal MTT1] == 1 } {

VERBATIM {

//=========================================================
// Top Metal MTT1 Dummy pattern check rules - DRC Check
//=========================================================
}

GROUP GMTT1DUMCK MTT1DUMCK_?

RULECHECK MTT1DUMCK_3 {
@ Top Metal dummy metal can not interact with Top Metal metal design patterns.
  OUTLAYER [lindex $metal_list end]DUM INTERACT [lindex $metal_list_tmp end]
}
RULECHECK MTT1DUMCK_4 {
@ Space between Top Metal dummy patterns and DUMBM	>=	2	um
  OUTLAYER EXT [lindex $metal_list end]DUM DUMBM < 2 ABUT <90 SINGULAR REGION
}
}
if { [string equal $top_metal MTT2] == 1 } {

VERBATIM {

//=========================================================
// Top Metal MTT2 Dummy pattern check rules - DRC Check
//=========================================================
}

GROUP GMTT2DUMCK MTT2DUMCK_?

RULECHECK MTT2DUMCK_3 {
@ Top Metal dummy metal can not interact with Top Metal metal design patterns.
  OUTLAYER [lindex $metal_list end]DUM INTERACT [lindex $metal_list_tmp end]
}
RULECHECK MTT2DUMCK_4 {
@ Space between Top Metal dummy patterns and DUMBM	>=	2	um
  OUTLAYER EXT [lindex $metal_list end]DUM DUMBM < 2 ABUT <90 SINGULAR REGION
}
}

VERBATIM {

//=================================
//   1.8V SRAM design rule
//=================================

GROUP GSRAA SRAA_?

SRAA_1 {
@ AA width	>=	0.17	um
  (INT AAO < 0.17 ABUT<90 SINGULAR REGION) NOT OUTSIDE 18SRAM
}
SRAA_3 {
@ Space between N+ AA and N+ AA or P+ AA and P+ AA (both regions are either inside or outside NW)	>=	0.16	um
  (EXT AAO < 0.16 ABUT<90 SINGULAR REGION) NOT OUTSIDE 18SRAM
}
SRAA_5 {
@ Space between N-Well edge and an N+ AA region which is outside an NW >=	0.31	um
  (EXT NW NACTO < 0.31 ABUT<90 SINGULAR REGION) NOT OUTSIDE 18SRAM
}
SRAA_6 {
@ N-Well enclosure of a P+ AA region which inside an NW	>=	0.32	um
  (ENC PACTO NW < 0.32 ABUT<90 SINGULAR REGION) NOT OUTSIDE 18SRAM
}
SRAA_8 {
@ Space between GATE edge and edge of a butted diffusion AA region	>=	0.28	um
  (EXT GATEO TAPO < 0.28 ABUT<90 SINGULAR REGION) NOT OUTSIDE 18SRAM
}

GROUP GSRGT SRGT_?

SRGT_1 {
@ GT width 	>=	0.09	um
  (INT GTO < 0.09 ABUT<90 SINGULAR REGION) NOT OUTSIDE 18SRAM
// (INT INTERGTO < 0.09 ABUT<90 SINGULAR REGION) NOT OUTSIDE SRAM
}
SRGT_1a {
@ GT width between parallel edges	>=	0.095	um
 (INT GTO < 0.095 PARALLEL ONLY REGION) NOT OUTSIDE 18SRAM
}
SRGT_3 {
@ Space between two GT regions on AA which is with no contact(CT)	>=	0.22	um
  (EXT (AAO AND GTO) < 0.22 ABUT<90 SINGULAR REGION) NOT OUTSIDE 18SRAM
}
SRGT_4 {
@ Space on field oxide area between different GTs (between parallel edges)	>=	0.19	um
  Y = AAO AND GTO
  X = (GTO NOT Y) NOT COIN EDGE Y
  (EXT X < 0.19 PARALLEL ONLY REGION) NOT OUTSIDE 18SRAM
}
SRGT_5 {
@ Poly extension of AA	>=	0.07	um
  (ENC AA_GATE_EDGEO GTO < 0.07 ABUT<90 REGION) NOT OUTSIDE 18SRAM
}
SRGT_6 {
@ Extension from AA region to GT	>=	0.13	um
  (ENC GTO AAO < 0.13 ABUT<90 SINGULAR REGION) NOT OUTSIDE 18SRAM
}
SRGT_13 {
@ Space between two GTs on AA which is with CT	>=	0.22	um
  X = (SDO OR NSD_CAPO) INTERACT CTO
  Y = GATEO COINCIDENT EDGE X
  (EXT Y < 0.22 ABUT<90 REGION) NOT OUTSIDE 18SRAM
}

GROUP GSRSN SRSN_?

SRSN_3 {
@ Space between a SN region and a P+ AA (inside N-well)	>=	0.24	um
  X = NOT COIN EDGE MOSPO SN
  (EXT SN X < 0.24 ABUT<90 REGION) NOT OUTSIDE 18SRAM
}
SRSN_16 {
@ Space from a SN edge to a P-channel Poly gate along the direction of poly gate, 0 is allowed only in dummy cell (((AA AND GT)AND SP ) AND PW)	=	0	um	>=	0.32	um
 X = (PACTO INSIDE EDGE GTO) INSIDE EDGE NW
 Y = (PACTO INSIDE EDGE GTO) INSIDE EDGE PW

 (EXT X SN < 0.32 ABUT <90 REGION) NOT OUTSIDE 18SRAM
 (EXT Y SN < 0.32 ABUT > 0 < 90 REGION) NOT OUTSIDE 18SRAM
}
SRSN_17 {
@ Enclosure of a SN edge to a N-channel Poly gate along the direction of poly gate	>=	0.28	um
  E2 = AAO INSIDE EDGE GTO
  R = ENC E2 SN < 0.28 ABUT<90 REGION
  R NOT OUTSIDE 18SRAM
}

GROUP GSRSP SRSP_?

SRSP_3 {
@ Space between a SP region and a N+ AA (inside P-well)	>=	0.22	um
  X = NOT COIN EDGE MOSNO SP
  (EXT SP X < 0.22 ABUT<90 REGION) NOT OUTSIDE 18SRAM
}
SRSP_16 {
@ Space from a SP edge to a N-channel Poly gate along the direction of poly gate	>=	0.28	um
  X = NACTO INSIDE EDGE GTO
  (EXT X SP < 0.28 ABUT<90 REGION) NOT OUTSIDE 18SRAM
}
SRSP_17 {
@ Enclosure of a SP edge to a P-channel Poly gate along the direction of poly gate, 0 is allowed only in dummy cell (((AA AND GT)AND SP ) AND PW)	>= 0.32 um.
  E2 = (PACTO INSIDE EDGE GTO) INSIDE EDGE NW
  Y = (PACTO INSIDE EDGE GTO) INSIDE EDGE PW

   (ENC E2 SP < 0.32 ABUT<90 REGION) NOT OUTSIDE 18SRAM
   (ENC Y SP < 0.32 ABUT > 0 < 90 REGION) NOT OUTSIDE 18SRAM
}


GROUP GSRCT SRCT_?

SRCT_2 {
@ Space between two contacts	>=	0.205	um
  (EXT CTO < 0.205 ABUT<90 SINGULAR REGION) NOT OUTSIDE 18SRAM
}
SRCT_4 {
@ Space between poly CT to AA	>	0	um
  (INTERCTO INTERACT AAO SINGULAR ALSO) NOT OUTSIDE 18SRAM
}
SRCT_5 {
@ Space between poly to diffusion CT	>=	0.101	um
  (EXT GTO ACT_CTO < 0.101 ABUT<90 SINGULAR REGION) NOT OUTSIDE 18SRAM
}
SRCT_6 {
@ Enclosure of an AA beyond an AA CT  	>=	0	um
  X = CTO INTERACT AAO
  (X NOT AAO) NOT OUTSIDE 18SRAM
}
SRCT_7 {
@ Enclosure of a GT beyond a poly CT, check the CTs after corner cut 0.02um	 >=	0 um
 Y = INT CTO <=0.02 ABUT==90 INTERSECTING ONLY REGION
 Z = (CTO INTERACT GTO) NOT Y
 (Z NOT GTO) NOT OUTSIDE 18SRAM
}
SRCT_12 {
@ CT must fully enclosed by (AA OR GT), check the CTs after corner cut 0.02um	
  Y = INT CTO <=0.02 ABUT==90 INTERSECTING ONLY REGION
  ((CTO NOT Y) NOT (AAO OR GTO)) NOT OUTSIDE 18SRAM
}
SRCT_13	{
@ CT must be fully covered by (M1 AND (AA OR GT)), check the CTs after corner cut 0.035
  Y = INT CTO <=0.035 ABUT==90 INTERSECTING ONLY REGION
  ((CTO NOT Y) NOT (M1O AND (AAO OR GTO))) NOT OUTSIDE 18SRAM
}

GROUP GSRM1 SRM1_?

SRM1_1 {
@ M1 width	>=	0.09	um
  (INT M1O < 0.09 ABUT<90 SINGULAR REGION) NOT OUTSIDE 18SRAM
}
SRM1_1a	{
@ M1 width between parallel edges	>=	0.18	um
  (INT M1O < 0.18 PARALLEL ONLY REGION) NOT OUTSIDE 18SRAM
}
SRM1_2 {
@ M1 space	>=	0.1	um
 (EXT M1O < 0.1 ABUT<90 SINGULAR REGION) NOT OUTSIDE 18SRAM	
}
SRM1_2a {
@ Space between different M1s	>=	0.21	um
  (EXT M1O < 0.21 ABUT<90 SINGULAR REGION SPACE) NOT OUTSIDE 18SRAM	
}
SRM1_3 {
@ M1 enclosure of CT, check the CTs after corner cut 0.035	 >=	0	um
  Y = INT CTO <=0.035 ABUT==90 INTERSECTING ONLY REGION
  ((CTO NOT Y) NOT M1O) NOT OUTSIDE 18SRAM
}


//=================================
//   3.3V SRAM design rule
//=================================


GROUP GSR33AA SR33AA_?

SR33AA_3 {
@ Space between N+ AA and N+ AA or P+ AA and P+ AA (both regions are either inside or outside NW) >= 0.19um
(EXT AAO < 0.19 ABUT<90 SINGULAR REGION) NOT OUTSIDE 33SRAM
}
SR33AA_5 {
@ Space between N-Well edge and an N+ AA region which is outside an NW >= 0.38um
(EXT NW NACTO < 0.38 ABUT<90 SINGULAR REGION) NOT OUTSIDE 33SRAM
}
SR33AA_6 {
@ N-Well enclosure of a P+ AA region which inside an NW >= 0.38um
(ENC PACTO NW < 0.38 ABUT<90 SINGULAR REGION) NOT OUTSIDE 33SRAM
}


GROUP GSR33DG SR33DG_?

SR33DG_1 {
@ Enclosure of DG beyond the active AA region >= 0.27um
(ENC AAO DGO < 0.27 ABUT<90 SINGULAR REGION) NOT OUTSIDE 33SRAM
}

GROUP GSR33GT SR33GT_?

SR33GT_6 {
@ Extension from AA region to GT >= 0.299um
(ENC GTO AAO < 0.299 ABUT<90 SINGULAR REGION) NOT OUTSIDE 33SRAM
}


GROUP GSR33SN SR33SN_?

SR33SN_16 {
@ Space from a SN edge to a P-channel Poly gate along the direction of poly gate, 0 is allowed only in ((AA AND GT)AND SP )AND PW) =	0	um	>=	0.32	um
 X = (PACTO INSIDE EDGE GTO) INSIDE EDGE NW
 Y = (PACTO INSIDE EDGE GTO) INSIDE EDGE PW

 (EXT X SN < 0.32 ABUT <90 REGION) NOT OUTSIDE 33SRAM
 (EXT Y SN < 0.32 ABUT > 0 < 90 REGION) NOT OUTSIDE 33SRAM
}

SR33SN_17 {
@ Enclosure of a SN edge to a N-channel Poly gate along the direction of poly gate >= 0.32um
  E2 = AAO INSIDE EDGE GTO
  R = ENC E2 SN < 0.32 ABUT<90 REGION
  R NOT OUTSIDE 33SRAM
}


GROUP GSR33SP SR33SP_?

SR33SP_16 {
@ Space from a SP edge to a N-channel Poly gate along the direction of poly gate >= 0.32um
   X = NACTO INSIDE EDGE GTO
  (EXT X SP < 0.32 ABUT<90 REGION) NOT OUTSIDE 33SRAM
}

SR33SP_17 {
@ Space from a SP edge to a P-channel Poly gate along the direction of poly gate, 0 is allowed only in ((AA AND GT)AND SP )AND PW) =0um  >=0.32um
 E2 = (PACTO INSIDE EDGE GTO) INSIDE EDGE NW
  Y = (PACTO INSIDE EDGE GTO) INSIDE EDGE PW

   (ENC E2 SP < 0.32 ABUT<90 REGION) NOT OUTSIDE 33SRAM
   (ENC Y SP < 0.32 ABUT > 0 < 90 REGION) NOT OUTSIDE 33SRAM
}


GROUP GSR33CT SR33CT_?

SR33CT_5 {
@ Space between poly to diffusion CT >= 0.15um
(EXT GTO ACT_CTO < 0.15 ABUT<90 SINGULAR REGION) NOT OUTSIDE 33SRAM
}

SR33CT_6 {
@ Enclosure of an AA region beyond an AA CT region >= 0.03um
 X = CTO INTERACT AAO
  (ENC X AAO < 0.03 ABUT < 90 SINGULAR REGION) NOT OUTSIDE 33SRAM
}

SR33CT_7 {
@ Enclosure of a poly region beyond a poly CT region >= 0.05um
//Y = INT CTO <=0.02 ABUT==90 INTERSECTING ONLY REGION
 Z = CTO INTERACT GTO
 (ENC Z GTO < 0.05 ABUT < 90 SINGULAR REGION) NOT OUTSIDE 33SRAM
}

GROUP GSR33M1 SR33M1_?

SR33M1_1 {
@ M1 width >=  0.204um
(INT M1O < 0.204 ABUT<90 SINGULAR REGION) NOT OUTSIDE 33SRAM
}

}

VERBATIM {
//===============================================
//  FUSE Guideline for metal fuse design minima
//===============================================

#IFDEF guideline_a_check YES
}

GROUP GFUSE FUSE_?

RULECHECK FUSE_1_G {
@ Width of metal fuse is >= 0.80um
OUTLAYER  INT MT_1_FUSE < 0.8 ABUT<90 SINGULAR REGION
}
RULECHECK FUSE_2_G {
@ Space of metal fuse is >= 4.00um
OUTLAYER  EXT MT_1_FUSE < 4 ABUT<90 SINGULAR REGION
}
RULECHECK FUSE_5_G {
@ Extension from GT to CT is >= 0.30um
OUTLAYER  ENC CT_FUSE GT < 0.3 ABUT<90 SINGULAR REGION
}
RULECHECK FUSE_6_G {
@ Extension from M1 to CT is >= 0.30um
OUTLAYER  ENC CT_FUSE M1 < 0.3 ABUT<90 SINGULAR REGION
}


RULECHECK FUSE_3_G {
@ Length of metal fuse is >= 4.00um (metal length between Vias)
SETLAYER  X = ([lindex $via_list end-1] INTERACT MT_1_FUSE) NOT [lindex $via_list end-1]FUSE_RING
OUTLAYER  EXT X < 4 ABUT<90 SINGULAR REGION
}
RULECHECK FUSE_4_G {
@ Length of metal fuse is <= 10.00um (metal length between Vias)
SETLAYER  X = ([lindex $via_list end-1] INTERACT MT_1_FUSE) NOT [lindex $via_list end-1]FUSE_RING
SETLAYER  Y = SIZE X BY 5 OVERUNDER
OUTLAYER  MT_1_FUSE INTERACT (Y AND MT_1_FUSE) > 1
}

if { 6 == $metal_counts } {
RULECHECK FUSE_7_G {
@ Extension from Mn to Vn/Vn-1 (stacked via) is >= 0.30um
OUTLAYER  ENC V1_FUSE M1 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V1_FUSE M2 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V2_FUSE M2 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V2_FUSE M3 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V3_FUSE M3 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V3_FUSE M4 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V4_FUSE M4 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V4_FUSE M5 < 0.3 ABUT<90 SINGULAR REGION
}
RULECHECK FUSE_13_G {
@ Extension from M1~Mx to V1~Vx-1 in protection ring is >= 0.40um
OUTLAYER  ENC V1FUSE_RING BM1 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V1FUSE_RING BM2 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V2FUSE_RING BM2 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V2FUSE_RING BM3 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V3FUSE_RING BM3 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V3FUSE_RING BM4 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V4FUSE_RING BM4 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V4FUSE_RING BM5 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V5FUSE_RING BM5 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V5FUSE_RING BM6 < 0.4 ABUT<90 SINGULAR REGION
}

} elseif { 5 == $metal_counts } {
RULECHECK FUSE_7_G {
@ Extension from Mn to Vn/Vn-1 (stacked via) is >= 0.30um
OUTLAYER  ENC V1_FUSE M1 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V1_FUSE M2 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V2_FUSE M2 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V2_FUSE M3 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V3_FUSE M3 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V3_FUSE M4 < 0.3 ABUT<90 SINGULAR REGION
}
RULECHECK FUSE_13_G {
@ Extension from M1~Mx to V1~Vx-1 in protection ring is >= 0.40um
OUTLAYER  ENC V1FUSE_RING BM1 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V1FUSE_RING BM2 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V2FUSE_RING BM2 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V2FUSE_RING BM3 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V3FUSE_RING BM3 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V3FUSE_RING BM4 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V4FUSE_RING BM4 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V4FUSE_RING BM5 < 0.4 ABUT<90 SINGULAR REGION
}

} elseif { 4 == $metal_counts } {
RULECHECK FUSE_7_G {
@ Extension from Mn to Vn/Vn-1 (stacked via) is >= 0.30um
OUTLAYER  ENC V1_FUSE M1 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V1_FUSE M2 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V2_FUSE M2 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V2_FUSE M3 < 0.3 ABUT<90 SINGULAR REGION
}
RULECHECK FUSE_13_G {
@ Extension from M1~Mx to V1~Vx-1 in protection ring is >= 0.40um
OUTLAYER  ENC V1FUSE_RING BM1 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V1FUSE_RING BM2 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V2FUSE_RING BM2 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V2FUSE_RING BM3 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V3FUSE_RING BM3 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V3FUSE_RING BM4 < 0.4 ABUT<90 SINGULAR REGION
}

} elseif { 3 == $metal_counts } {
RULECHECK FUSE_7_G {
@ Extension from Mn to Vn/Vn-1 (stacked via) is >= 0.30um
OUTLAYER  ENC V1_FUSE M1 < 0.3 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V1_FUSE M2 < 0.3 ABUT<90 SINGULAR REGION
}
RULECHECK FUSE_13_G {
@ Extension from M1~Mx to V1~Vx-1 in protection ring is >= 0.40um
OUTLAYER  ENC V1FUSE_RING BM1 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V1FUSE_RING BM2 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V2FUSE_RING BM2 < 0.4 ABUT<90 SINGULAR REGION
OUTLAYER  ENC V2FUSE_RING BM3 < 0.4 ABUT<90 SINGULAR REGION
}
}

RULECHECK FUSE_10_G {
@ Separation from fuse window to protection ring is >= 1.5um
foreach layer $metal_list {
OUTLAYER  EXT B${layer} FUSE < 1.5 ABUT<90 SINGULAR REGION
}
}

RULECHECK FUSE_11_G {
@ Width of V1~Vx-1 in protection ring is = 0.26um
for { set j 1 } { 2 <= [expr $metal_counts -$j] } { incr j } {
OUTLAYER  INT V${j}FUSE_RING < 0.26 ABUT<90 SINGULAR REGION
OUTLAYER  V${j}FUSE_RING WITH WIDTH > 0.26 
}
}

RULECHECK FUSE_12_G {
@ Width of Vx in protection ring is = 0.36um
OUTLAYER  INT [lindex $via_list end]FUSE_RING < 0.36 ABUT<90 SINGULAR REGION
OUTLAYER  [lindex $via_list end]FUSE_RING WITH WIDTH > 0.36 
}

RULECHECK FUSE_19_G {
@ Separation from metal island (Mn interact FUSE) to protection ring is >= 1.00um
for { set j 1 } { 1 <= [expr $metal_counts -$j] } { incr j } {
OUTLAYER  EXT BM${j} (M${j} INTERACT FUSE) < 1 ABUT<90 SINGULAR REGION
}
}


RULECHECK FUSE_8_G {
@ Separation from fuse edge to p-well edge (p-type substrate are used) is >= 8.00um
OUTLAYER  EXT FUSE NW < 8.0 ABUT<90 SINGULAR REGION
}
RULECHECK FUSE_9_G {
@ Separation from fuse to fuse window is >= 3.5um
OUTLAYER  ENC MT_1_FUSE FUSE < 3.5 ABUT<90 SINGULAR REGION
}
RULECHECK FUSE_14_G {
@ Width of fuse window is >= 5.00um
OUTLAYER  INT FUSE < 5.0 ABUT<90 SINGULAR REGION
}
RULECHECK FUSE_15_G {
@ Length of fuse window is >= 20.00um
SETLAYER  X = LENGTH FUSE >= 20
OUTLAYER  FUSE NOT WITH EDGE X >= 2
}
RULECHECK FUSE_16_G {
@ Width of polyimide opening is >= 30.00um
OUTLAYER  INT PI < 30 ABUT<90 SINGULAR REGION 
}
RULECHECK FUSE_17_G {
@ Extension from polyimide window to passivation window is >= 12.00um
SETLAYER  X = PI INTERACT PA
OUTLAYER  ENC FUSE X < 12 ABUT<90 SINGULAR REGION
}
VERBATIM {
#ENDIF
}


VERBATIM {
//;FUSE_18_G {
//;@ Separation between Via's inside protection ring is >= 0.00um }


//==========================================
//  PI - Guidline for polymide layout minima
//==========================================

#IFDEF guideline_a_check YES
}

GROUP GPI PI_?

RULECHECK PI_1_G {
@ Space between two polymide open area is >= 15.00um
OUTLAYER  EXT PI < 15 ABUT<90 SINGULAR REGION
}
RULECHECK PI_2_G {
@ Space between polyimide open area to chip edge is >= 15.00um
OUTLAYER  ENC PI BORDER_ALL < 15 ABUT<90 SINGULAR REGION
}
VERBATIM {
#ENDIF
}

VERBATIM {
//========================================
//  SLOT - Recommended metal slot rules
//========================================
#IFDEF guideline_b_check YES
}

GROUP GSLOT SLOT_?

if { 6 == $metal_counts } {
set letter_list1 "a 1 b 2 c 3 d 4 e 5 f 6"
set letter_list2 "b 2 c 3 d 4 e 5"

SETLAYER M1SLOT1 = HOLES M1 INNER EMPTY
SETLAYER M2SLOT1 = HOLES M2 INNER EMPTY
SETLAYER M3SLOT1 = HOLES M3 INNER EMPTY
SETLAYER M4SLOT1 = HOLES M4 INNER EMPTY
SETLAYER M5SLOT1 = HOLES M5 INNER EMPTY
SETLAYER M6SLOT1 = HOLES M6 INNER EMPTY

SETLAYER  M1SLOT_R = RECTANGLE M1SLOT
SETLAYER  M2SLOT_R = RECTANGLE M2SLOT
SETLAYER  M3SLOT_R = RECTANGLE M3SLOT
SETLAYER  M4SLOT_R = RECTANGLE M4SLOT
SETLAYER  M5SLOT_R = RECTANGLE M5SLOT
SETLAYER  M6SLOT_R = RECTANGLE M6SLOT

SETLAYER  M1SLOT_T = (M1SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M2SLOT_T = (M2SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M3SLOT_T = (M3SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M4SLOT_T = (M4SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M5SLOT_T = (M5SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M6SLOT_T = (M6SLOT_R WITH WIDTH <= 10) NOT PA

SETLAYER  M1_35 = ((M1i NOT EXCLU) NOT PA) WITH WIDTH > 35
SETLAYER  M2_35 = ((M2i NOT EXCLU) NOT PA) WITH WIDTH > 35
SETLAYER  M3_35 = ((M3i NOT EXCLU) NOT PA) WITH WIDTH > 35
SETLAYER  M4_35 = ((M4i NOT EXCLU) NOT PA) WITH WIDTH > 35
SETLAYER  M5_35 = ((M5i NOT EXCLU) NOT PA) WITH WIDTH > 35
SETLAYER  M6_35 = ((M6i NOT EXCLU) NOT PA) WITH WIDTH > 35
} elseif { 5 == $metal_counts } {
set letter_list1 "a 1 b 2 c 3 d 4 f 5"
set letter_list2 "b 2 c 3 d 4"

SETLAYER M1SLOT1 = HOLES M1 INNER EMPTY
SETLAYER M2SLOT1 = HOLES M2 INNER EMPTY
SETLAYER M3SLOT1 = HOLES M3 INNER EMPTY
SETLAYER M4SLOT1 = HOLES M4 INNER EMPTY
SETLAYER M5SLOT1 = HOLES M5 INNER EMPTY

SETLAYER  M1SLOT_R = RECTANGLE M1SLOT
SETLAYER  M2SLOT_R = RECTANGLE M2SLOT
SETLAYER  M3SLOT_R = RECTANGLE M3SLOT
SETLAYER  M4SLOT_R = RECTANGLE M4SLOT
SETLAYER  M5SLOT_R = RECTANGLE M5SLOT

SETLAYER  M1SLOT_T = (M1SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M2SLOT_T = (M2SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M3SLOT_T = (M3SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M4SLOT_T = (M4SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M5SLOT_T = (M5SLOT_R WITH WIDTH <= 10) NOT PA

SETLAYER  M1_35 = ((M1i NOT EXCLU) NOT PA) WITH WIDTH > 35
SETLAYER  M2_35 = ((M2i NOT EXCLU) NOT PA) WITH WIDTH > 35
SETLAYER  M3_35 = ((M3i NOT EXCLU) NOT PA) WITH WIDTH > 35
SETLAYER  M4_35 = ((M4i NOT EXCLU) NOT PA) WITH WIDTH > 35
SETLAYER  M5_35 = ((M5i NOT EXCLU) NOT PA) WITH WIDTH > 35
} elseif { 4 == $metal_counts } {
set letter_list1 "a 1 b 2 c 3 f 4"
set letter_list2 "b 2 c 3"

SETLAYER M1SLOT1 = HOLES M1 INNER EMPTY
SETLAYER M2SLOT1 = HOLES M2 INNER EMPTY
SETLAYER M3SLOT1 = HOLES M3 INNER EMPTY
SETLAYER M4SLOT1 = HOLES M4 INNER EMPTY

SETLAYER  M1SLOT_R = RECTANGLE M1SLOT
SETLAYER  M2SLOT_R = RECTANGLE M2SLOT
SETLAYER  M3SLOT_R = RECTANGLE M3SLOT
SETLAYER  M4SLOT_R = RECTANGLE M4SLOT

SETLAYER  M1SLOT_T = (M1SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M2SLOT_T = (M2SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M3SLOT_T = (M3SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M4SLOT_T = (M4SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M1_35 = ((M1i NOT EXCLU) NOT PA) WITH WIDTH > 35
SETLAYER  M2_35 = ((M2i NOT EXCLU) NOT PA) WITH WIDTH > 35
SETLAYER  M3_35 = ((M3i NOT EXCLU) NOT PA) WITH WIDTH > 35
SETLAYER  M4_35 = ((M4i NOT EXCLU) NOT PA) WITH WIDTH > 35
} elseif { 3 == $metal_counts } {
set letter_list1 "a 1 b 2 f 3"
set letter_list2 "b 2"

SETLAYER M1SLOT1 = HOLES M1 INNER EMPTY
SETLAYER M2SLOT1 = HOLES M2 INNER EMPTY
SETLAYER M3SLOT1 = HOLES M3 INNER EMPTY

SETLAYER  M1SLOT_R = RECTANGLE M1SLOT
SETLAYER  M2SLOT_R = RECTANGLE M2SLOT
SETLAYER  M3SLOT_R = RECTANGLE M3SLOT

SETLAYER  M1SLOT_T = (M1SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M2SLOT_T = (M2SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M3SLOT_T = (M3SLOT_R WITH WIDTH <= 10) NOT PA
SETLAYER  M1_35 = ((M1i NOT EXCLU) NOT PA) WITH WIDTH > 35
SETLAYER  M2_35 = ((M2i NOT EXCLU) NOT PA) WITH WIDTH > 35
SETLAYER  M3_35 = ((M3i NOT EXCLU) NOT PA) WITH WIDTH > 35
}


foreach { i j } $letter_list1 {
RULECHECK SLOT_1_${i}_G {
@ Slot width is >= 2.00um
OUTLAYER  INT M${j}SLOT < 2.0 ABUT<90 SINGULAR REGION
}
RULECHECK SLOT_2_${i}_G {
@ Open slot must be fully enclosed by metal line >= 5.0um
OUTLAYER  ENC M${j}SLOT (M${j} OR M${j}SLOT) < 5.0 ABUT<90 SINGULAR REGION
}
RULECHECK SLOT_3a_${i}_G {
@ Space between open slots is >= 2.0um
OUTLAYER  EXT M${j}SLOT < 2.0 ABUT<90 SINGULAR REGION
}}

RULECHECK SLOT_3c_G {
@ Space between M1 slot edge and immediately below contact is >= 0.005.
OUTLAYER  EXT M1SLOT CT < 0.005 ABUT<90 SINGULAR REGION
}

RULECHECK SLOT_3d_a_G {
@ Space between M1 slot edge and immediately above vias is >= 0.01um.
OUTLAYER  EXT M1SLOT V1 < 0.01 ABUT<90 SINGULAR REGION
}

foreach { i j } $letter_list2 {
RULECHECK SLOT_3d_${i}_G {
@ Space between M2 slot edge and immediately below and above vias is >= 0.01um.
OUTLAYER  EXT M${j}SLOT V[expr $j -1] < 0.01 ABUT<90 SINGULAR REGION
OUTLAYER  EXT M${j}SLOT V${j} < 0.01 ABUT<90 SINGULAR REGION
}}

RULECHECK SLOT_3d_f_G {
@ Space between top metal slot edge and immediately below is >= 0.01um.
OUTLAYER  EXT [lindex $metal_list end]SLOT [lindex $via_list end] < 0.01 ABUT<90 SINGULAR REGION
}

RULECHECK SLOT_7_G {
@ Metal slot must be rectangle
foreach k $metal_list {
OUTLAYER  NOT RECTANGLE ${k}SLOT
}}

VERBATIM {
#IFDEF DENSITY_CHECK YES
}
foreach k $metal_list {
RULECHECK SLOT_8_G_${k} {
@ Slot density of wide metal >=1.5% when
@ 1. The wide metal is > 35*35 um. DRC checks the metal main pattern(61:0, 62:0¿), not following (Mn-MnSLOT).
@ 2. The wide metal interacts with metal slot (61:2, 62:2...)
@ 3. Metal slot (61:2, 62:2¿) size > 10*10 um are not included this rule density calculation.
@ 4. DRC doesn't check metals interact with PA.
@ 5. DRC individually exports result by each metal layer.
SETLAYER  X${k} = ${k}_35 ENCLOSE ${k}SLOT_T
SETLAYER  Y${k} = DFM PROPERTY X${k} ${k}SLOT_T OVERLAP \[- = AREA(${k}SLOT_T)/AREA(X${k})\] < 0.015
OUTLAYER  DFM RDB Y${k} ${k}SLOT_SL_8_density.rdb
OUTLAYER  DFM COPY Y${k}
}}
VERBATIM {
#ENDIF
#ENDIF
}
VERBATIM {
//; SLOT_3b_G { PURPOSELY BLANK }
//; SLOT_4_G_NC:The length of the slot should be parallel to current flow direction at this layer.
//; SLOT_5_G_NC:The starting position of the parallel slots should be staggered.
//; SLOT_6_G_NC:It's strongly recommended Metal slots should be drawn with the GDS No. of corresponding
//; @ metal slot layers (61;2, 62;2, 63;2 ?).Then it can be performed DRC check with above slot rules. 
//; @ Otherwise, if metal slots are drawn with the same GDS layers of active metal (61;0, 62;0, 63;0 ?), 
//; @ it can be only performed DRC check with main rule



//=========================================
// DUP (Device Under Pad) Pad Guidelines
//=========================================

padarea = PA AND DUPMK1 

#IFDEF guideline_b_check YES
}

GROUP GDUP DUP_?

RULECHECK DUP_1_G {
@ For PA that interacts with DUPMK1, this piece of PA must be fully covered by DUPMK1
OUTLAYER  (PA INTERACT DUPMK1) NOT DUPMK1
}		
RULECHECK DUP_2_G {
@ Two metal layers (TM and TM-1) are needed in DUP pad area, these two metal layers design must be solid.
OUTLAYER  padarea ENCLOSE (padarea NOT [lindex $metal_list end-1])
OUTLAYER  padarea ENCLOSE (padarea NOT [lindex $metal_list end])
}
RULECHECK DUP_3a_G {
@ MIMDMY, MOMDMY, INDMY, Resistor of TM or TM-1 must be outside of DUP pad area.	
OUTLAYER  ((((MIMDMY OR MOMDMY) OR INDMY) OR [lindex $metal_list end]R) OR [lindex $metal_list end-1]R) AND padarea
}
RULECHECK DUP_4_G {
@ Vn-1(n denotes top via layer) pattern must be outside of DUP pad area
OUTLAYER  [lindex $via_list end-1] AND padarea
}
RULECHECK DUP_5_G {
@ DUP pad area must have Via array between TM and TM-1.
@ 2*2 Via areas whose space is within 0.35m are considered to be in the same array.
@ Via space within array in DUP pad opening area should follow TV.2.
SETLAYER  TVarray = SIZE (SIZE ([lindex $via_list end] INSIDE padarea) BY 0.175 OVERUNDER) BY 0.534 UNDEROVER 
OUTLAYER  padarea NOT ENCLOSE TVarray
}
VERBATIM {
#ENDIF
}


VERBATIM {
//; DUP_3_G_NC {
//@ Device (transistor, metal resistor, BJT, etc) must be located underneath TM-1 layer.}


//=========================================
// Poly E-Fuse layout guidelines
//=========================================
#IFDEF guideline_a_check YES
}

GROUP GEFU EFU_?

RULECHECK EFU_1b_G {
@ FUSEMK1(81 152) must interact with EFUSE(81 2) region
OUTLAYER  FUSEMK1 NOT INTERACT EFUSE
}
RULECHECK EFU_1c_G {
@ FUSEMK1(81 152) must fully cover EFUSE(81 2) region
OUTLAYER  EFUSE NOT FUSEMK1
}
RULECHECK EFU_2b_G {
@ EFUSE (81 2) must interact with GTFUSE(81 1)
OUTLAYER  EFUSE NOT INTERACT GTFUSE
}
RULECHECK EFU_2c_G {
@ EFUSE (81 2) must fully cover GTFUSE(81 1)
OUTLAYER  GTFUSE NOT EFUSE
} 
VERBATIM {
#ENDIF
}

VERBATIM {
//; EFU_1a_G_NC { @FUSEMK1(81;152) must fully enclose all fuse component, including EFUSE(81;2) region, program transistor, etc.}
//; EFU_3_G_NC { @(GTFUSE AND GT) is just the EFUSE function area }
//; EFU_2a_G_NC { @ EFUSE (81;2) must fully enclose the whole fuse element and related dummy region }
//; EFU_4_G_NC { @It is strongly recommended to adopt SMIC standard efuse element, including program transistor }
//; EFU_5_G_NC { @If designers plan to adopt customer own design, designers must provide efuse layout to SMIC for risk assessment before design start }


//=======================================
//  Logo Design Guidelines
//=======================================

#IFDEF guideline_b_check YES
}

GROUP GLOGO LOGO_?

RULECHECK LOGO_1_G {
@ Space between LOGO and AA, GT or Metal is >= 10.0um.
@ DRC doesn't check dummy AA, dummy GT, dummy metal.
OUTLAYER  EXT LOGO AA < 10 ABUT<90 SINGULAR REGION
OUTLAYER  EXT LOGO GT < 10 ABUT<90 SINGULAR REGION
foreach j $metal_list {
OUTLAYER  EXT LOGO $j < 10 ABUT<90 SINGULAR REGION
}
}
RULECHECK LOGO_2_G {
@ LOGO overlap with PA, Metal fuse or Polymide window is not allowed
OUTLAYER  LOGO AND PA
OUTLAYER  LOGO AND PI
OUTLAYER  LOGO AND MT_1_FUSE
}
#//; LOGO_3_G_NC { @ A circuit in the LOGO is not allowed.}
VERBATIM {
#ENDIF
}

